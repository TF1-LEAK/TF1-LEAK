local ESPObjects = {}

local function newDraw(type, props)
    local obj = Drawing.new(type)
    for k,v in pairs(props) do obj[k] = v end
    return obj
end

local function createESPForPlayer(player)
    if player == LocalPlayer then return end
    local objs = {}

    objs.BoxLines = {}
    for i = 1, 4 do
        objs.BoxLines[i] = newDraw("Line", {
            Thickness = 1.5,
            Color     = CFG.ESP.BoxColor,
            Visible   = false,
            ZIndex    = 2,
        })
    end

    objs.NameTag = newDraw("Text", {
        Size    = 13,
        Color   = CFG.ESP.NameColor,
        Outline = true,
        Center  = true,
        Visible = false,
        ZIndex  = 3,
    })

    objs.DistTag = newDraw("Text", {
        Size    = 11,
        Color   = CFG.ESP.DistColor,
        Outline = true,
        Center  = true,
        Visible = false,
        ZIndex  = 3,
    })

    objs.Tracer = newDraw("Line", {
        Thickness = 1,
        Color     = CFG.ESP.TracerColor,
        Visible   = false,
        ZIndex    = 1,
    })

    ESPObjects[player] = objs
end

local function removeESP(player)
    local objs = ESPObjects[player]
    if not objs then return end
    for _, l in ipairs(objs.BoxLines) do l:Remove() end
    objs.NameTag:Remove()
    objs.DistTag:Remove()
    objs.Tracer:Remove()
    ESPObjects[player] = nil
end

local function hideAll(objs)
    for _, l in ipairs(objs.BoxLines) do l.Visible = false end
    objs.NameTag.Visible = false
    objs.DistTag.Visible = false
    objs.Tracer.Visible  = false
end

--// ============================================================
--//  VIEWPORT BOUNDS CHECK  ← le vrai fix du freeze
--// ============================================================

--[[
    Camera:WorldToViewportPoint retourne onScreen=false quand le point
    est derrière la caméra, MAIS les coordonnées X/Y peuvent quand même
    être "dans" le viewport numériquement (valeurs résiduelles).
    On doit donc vérifier :
      1. onScreen == true  (le point est devant le near plane)
      2. Les coords sont dans [0, viewportSize] (pas hors écran)
    Si l'une des deux conditions fail → on cache les drawings.
]]

local function isOnScreen(screenPos2D, onScreen)
    if not onScreen then return false end
    local vp = Camera.ViewportSize
    return screenPos2D.X >= 0
       and screenPos2D.X <= vp.X
       and screenPos2D.Y >= 0
       and screenPos2D.Y <= vp.Y
end

local function worldToScreen(pos)
    local sp, onScreen = Camera:WorldToViewportPoint(pos)
    local v2 = Vector2.new(sp.X, sp.Y)
    return v2, onScreen
end

--// bounding box avec double check onScreen sur top ET bottom
local function getBoundingBox(char)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local hum    = char:FindFirstChildOfClass("Humanoid")
    local height = hum and hum.HipHeight * 2 + 0.5 or 5

    local top    = hrp.Position + Vector3.new(0, height * 0.5, 0)
    local bottom = hrp.Position - Vector3.new(0, height * 0.5, 0)

    local topSS,    onT = worldToScreen(top)
    local bottomSS, onB = worldToScreen(bottom)

    -- si NI le top NI le bottom sont visibles à l'écran → nil
    if not isOnScreen(topSS, onT) and not isOnScreen(bottomSS, onB) then
        return nil
    end

    local w = math.abs(topSS.X - bottomSS.X) + 40
    local h = math.abs(topSS.Y - bottomSS.Y)

    return {
        top    = topSS,
        bottom = bottomSS,
        width  = w,
        height = h,
        center = Vector2.new(
            (topSS.X + bottomSS.X) * 0.5,
            (topSS.Y + bottomSS.Y) * 0.5
        ),
    }
end

--// ============================================================
--//  ESP RENDER LOOP
--// ============================================================

RunService.RenderStepped:Connect(function()
    local localRoot = LocalPlayer.Character
        and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local objs = ESPObjects[player]
        if not objs then continue end

        -- ESP globalement désactivé → tout cacher
        if not CFG.ESP.Enabled then
            hideAll(objs)
            continue
        end

        local char = player.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local alive = hrp and hum and hum.Health > 0

        if not alive or not localRoot then
            hideAll(objs)
            continue
        end

        local dist = (hrp.Position - localRoot.Position).Magnitude
        if dist > CFG.ESP.MaxDist then
            hideAll(objs)
            continue
        end

        -- getBoundingBox retourne nil si hors champ → on cache
        local bb = getBoundingBox(char)
        if not bb then
            hideAll(objs)   -- ← FIX : freeze impossible, on cache explicitement
            continue
        end

        local x = bb.center.X - bb.width * 0.5
        local y = bb.top.Y
        local w = bb.width
        local h = bb.height

        -- Boxes
        if CFG.ESP.Boxes then
            objs.BoxLines[1].From = Vector2.new(x,     y);     objs.BoxLines[1].To = Vector2.new(x+w, y)
            objs.BoxLines[2].From = Vector2.new(x,     y+h);   objs.BoxLines[2].To = Vector2.new(x+w, y+h)
            objs.BoxLines[3].From = Vector2.new(x,     y);     objs.BoxLines[3].To = Vector2.new(x,   y+h)
            objs.BoxLines[4].From = Vector2.new(x+w,   y);     objs.BoxLines[4].To = Vector2.new(x+w, y+h)
            for _, l in ipairs(objs.BoxLines) do l.Visible = true end
        else
            for _, l in ipairs(objs.BoxLines) do l.Visible = false end
        end

        -- Name
        if CFG.ESP.Names then
            objs.NameTag.Text     = player.DisplayName
            objs.NameTag.Position = Vector2.new(bb.center.X, y - 16)
            objs.NameTag.Visible  = true
        else
            objs.NameTag.Visible = false
        end

        -- Distance
        if CFG.ESP.Distance then
            objs.DistTag.Text     = string.format("[%.0fm]", dist)
            objs.DistTag.Position = Vector2.new(bb.center.X, y + h + 4)
            objs.DistTag.Visible  = true
        else
            objs.DistTag.Visible = false
        end

        -- Tracer
        if CFG.ESP.Tracer then
            local vp = Camera.ViewportSize
            objs.Tracer.From    = Vector2.new(vp.X * 0.5, vp.Y)
            objs.Tracer.To      = bb.center
            objs.Tracer.Visible = true
        else
            objs.Tracer.Visible = false
        end
    end
end)

--// ============================================================
--//  SILENT AIM
--// ============================================================

local function getClosestPlayerToMouse()
    local mousePos = UserInputService:GetMouseLocation()
    local closest, bestDist = nil, CFG.AIM.FOV

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if CFG.AIM.TeamCheck and player.Team == LocalPlayer.Team then continue end

        local char = player.Character
        local bone = char and char:FindFirstChild(CFG.AIM.Bone)
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not bone or not hum or hum.Health <= 0 then continue end

        local sp, onScreen = Camera:WorldToViewportPoint(bone.Position)
        if not onScreen then continue end

        local v2   = Vector2.new(sp.X, sp.Y)
        local dist = (v2 - mousePos).Magnitude
        if dist < bestDist then
            bestDist = dist
            closest  = bone
        end
    end
    return closest
end

if hookfunction and getrawmetamethod then
    local origWTV = getrawmetamethod(Camera, "__namecall")
    hookfunction(origWTV, function(self, ...)
        if getnamecallmethod() == "WorldToViewportPoint" and CFG.AIM.Enabled then
            local target = getClosestPlayerToMouse()
            if target then
                return origWTV(self, target.Position)
            end
        end
        return origWTV(self, ...)
    end)
end

