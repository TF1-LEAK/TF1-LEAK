--// ============================================================
--//  ESP — Drawing pool
--// ============================================================

local ESPObjects = {}

local function newDraw(dtype, props)
    local obj = Drawing.new(dtype)
    for k, v in pairs(props) do obj[k] = v end
    return obj
end

local function createESPForPlayer(player)
    if player == LocalPlayer then return end
    local o = {}
    o.BoxLines = {}
    for i = 1, 4 do
        o.BoxLines[i] = newDraw("Line", {
            Thickness = 1.5, Color = CFG.ESP.BoxColor,
            Visible = false, ZIndex = 2,
        })
    end
    o.NameTag = newDraw("Text", {
        Size = 13, Color = CFG.ESP.NameColor,
        Outline = true, Center = true, Visible = false, ZIndex = 3,
    })
    o.DistTag = newDraw("Text", {
        Size = 11, Color = CFG.ESP.DistColor,
        Outline = true, Center = true, Visible = false, ZIndex = 3,
    })
    o.Tracer = newDraw("Line", {
        Thickness = 1, Color = CFG.ESP.TracerColor,
        Visible = false, ZIndex = 1,
    })
    ESPObjects[player] = o
end

local function removeESP(player)
    local o = ESPObjects[player]
    if not o then return end
    for _, l in ipairs(o.BoxLines) do l:Remove() end
    o.NameTag:Remove(); o.DistTag:Remove(); o.Tracer:Remove()
    ESPObjects[player] = nil
end

local function hideAll(o)
    for _, l in ipairs(o.BoxLines) do l.Visible = false end
    o.NameTag.Visible = false
    o.DistTag.Visible = false
    o.Tracer.Visible  = false
end

--// ============================================================
--//  ONSCREEN CHECK
--// ============================================================

local function isOnScreen(v2, onScreen)
    if not onScreen then return false end
    local vp = Camera.ViewportSize
    return v2.X >= 0 and v2.X <= vp.X
       and v2.Y >= 0 and v2.Y <= vp.Y
end

local function worldToScreen(pos)
    local sp, on = Camera:WorldToViewportPoint(pos)
    return Vector2.new(sp.X, sp.Y), on
end

local function getBoundingBox(char)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local hum    = char:FindFirstChildOfClass("Humanoid")
    local height = hum and hum.HipHeight * 2 + 0.5 or 5
    local topV   = hrp.Position + Vector3.new(0, height * 0.5, 0)
    local botV   = hrp.Position - Vector3.new(0, height * 0.5, 0)
    local topSS, onT = worldToScreen(topV)
    local botSS, onB = worldToScreen(botV)
    if not isOnScreen(topSS, onT) and not isOnScreen(botSS, onB) then
        return nil
    end
    return {
        top    = topSS, bottom = botSS,
        width  = math.abs(topSS.X - botSS.X) + 40,
        height = math.abs(topSS.Y - botSS.Y),
        center = Vector2.new((topSS.X+botSS.X)*0.5, (topSS.Y+botSS.Y)*0.5),
    }
end

--// ============================================================
--//  ESP RENDER
--// ============================================================

RunService.RenderStepped:Connect(function()
    local lRoot = LocalPlayer.Character
        and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local o = ESPObjects[player]
        if not o then continue end

        if not CFG.ESP.Enabled then hideAll(o); continue end

        local char  = player.Character
        local hrp   = char and char:FindFirstChild("HumanoidRootPart")
        local hum   = char and char:FindFirstChildOfClass("Humanoid")
        local alive = hrp and hum and hum.Health > 0

        if not alive or not lRoot then hideAll(o); continue end

        local dist = (hrp.Position - lRoot.Position).Magnitude
        if dist > CFG.ESP.MaxDist then hideAll(o); continue end

        local bb = getBoundingBox(char)
        if not bb then hideAll(o); continue end

        local x, y, w, h = bb.center.X - bb.width*0.5, bb.top.Y, bb.width, bb.height

        if CFG.ESP.Boxes then
            o.BoxLines[1].From=Vector2.new(x,y);     o.BoxLines[1].To=Vector2.new(x+w,y)
            o.BoxLines[2].From=Vector2.new(x,y+h);   o.BoxLines[2].To=Vector2.new(x+w,y+h)
            o.BoxLines[3].From=Vector2.new(x,y);     o.BoxLines[3].To=Vector2.new(x,y+h)
            o.BoxLines[4].From=Vector2.new(x+w,y);   o.BoxLines[4].To=Vector2.new(x+w,y+h)
            for _, l in ipairs(o.BoxLines) do l.Visible = true end
        else
            for _, l in ipairs(o.BoxLines) do l.Visible = false end
        end

        if CFG.ESP.Names then
            o.NameTag.Text     = player.DisplayName
            o.NameTag.Position = Vector2.new(bb.center.X, y - 16)
            o.NameTag.Visible  = true
        else o.NameTag.Visible = false end

        if CFG.ESP.Distance then
            o.DistTag.Text     = string.format("[%.0fm]", dist)
            o.DistTag.Position = Vector2.new(bb.center.X, y + h + 4)
            o.DistTag.Visible  = true
        else o.DistTag.Visible = false end

        if CFG.ESP.Tracer then
            local vp = Camera.ViewportSize
            o.Tracer.From    = Vector2.new(vp.X*0.5, vp.Y)
            o.Tracer.To      = bb.center
            o.Tracer.Visible = true
        else o.Tracer.Visible = false end
    end
end)

--// ============================================================
--//  SILENT AIM
--// ============================================================

local function getClosestToMouse()
    local mp = UserInputService:GetMouseLocation()
    local closest, best = nil, CFG.AIM.FOV
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if CFG.AIM.TeamCheck and p.Team == LocalPlayer.Team then continue end
        local char = p.Character
        local bone = char and char:FindFirstChild(CFG.AIM.Bone)
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not bone or not hum or hum.Health <= 0 then continue end
        local sp, on = Camera:WorldToViewportPoint(bone.Position)
        if not on then continue end
        local d = (Vector2.new(sp.X, sp.Y) - mp).Magnitude
        if d < best then best = d; closest = bone end
    end
    return closest
end

if hookfunction and getrawmetamethod then
    local orig = getrawmetamethod(Camera, "__namecall")
    hookfunction(orig, function(self, ...)
        if getnamecallmethod() == "WorldToViewportPoint" and CFG.AIM.Enabled then
            local t = getClosestToMouse()
            if t then return orig(self, t.Position) end
        end
        return orig(self, ...)
    end)
end

