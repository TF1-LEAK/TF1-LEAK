--// ============================================================
--//  SILENT AIM — mousemoverel (OS-level, bypass Byfron)
--//
--//  Logique :
--//  1. Chaque RenderStepped on cherche le joueur le plus proche
--//     du curseur dans le rayon FOV
--//  2. On projette sa bone en screen space
--//  3. On calcule le delta souris → bone
--//  4. mousemoverel(dx * smoothing, dy * smoothing) déplace
--//     le curseur OS sans passer par aucun hook Roblox
--//  5. Rivals voit un input souris natif — indétectable
--// ============================================================

local function getClosestTarget()
    local mp      = UserInputService:GetMouseLocation()
    local closest = nil
    local bestDist= CFG.AIM.FOV

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if CFG.AIM.TeamCheck and p.Team == LocalPlayer.Team then continue end
        local char = p.Character
        local bone = char and char:FindFirstChild(CFG.AIM.Bone)
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not bone or not hum or hum.Health <= 0 then continue end

        local sp, onScreen = Camera:WorldToViewportPoint(bone.Position)
        if not onScreen then continue end

        local screenPos = Vector2.new(sp.X, sp.Y)
        local dist      = (screenPos - mp).Magnitude
        if dist < bestDist then
            bestDist = dist
            closest  = { bone = bone, screenPos = screenPos }
        end
    end
    return closest
end

-- flag : on tire seulement quand le bouton souris est enfoncé
local isShooting = false
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isShooting = true
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isShooting = false
    end
end)

RunService.RenderStepped:Connect(function()
    -- FOV circle toujours visible si aim actif
    if CFG.AIM.Enabled then
        local mp = UserInputService:GetMouseLocation()
        fovCircle.Position = mp
        fovCircle.Radius   = CFG.AIM.FOV
        fovCircle.Visible  = true
    else
        fovCircle.Visible = false
        return
    end

    -- silent aim seulement quand on clique
    if not isShooting then return end

    local target = getClosestTarget()
    if not target then return end

    local mp    = UserInputService:GetMouseLocation()
    local delta = target.screenPos - mp

    -- smoothing : on applique pas 100% du delta d'un coup
    -- plus CFG.AIM.Smoothing est grand, plus c'est smooth (moins de px par frame)
    local smooth = math.clamp(1 - CFG.AIM.Smoothing, 0.05, 1.0)
    local dx     = delta.X * smooth
    local dy     = delta.Y * smooth

    -- mousemoverel = fonction native executor, déplace la souris au niveau OS
    -- aucun hook Roblox impliqué → bypass Byfron detection
    if mousemoverel then
        mousemoverel(dx, dy)
    end
end)

