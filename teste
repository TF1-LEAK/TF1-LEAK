    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local o = ESPObjects[player]
        if not o then continue end

        if not CFG.ESP.Enabled then hideAll(o); continue end

        local char  = player.Character
        local hrp   = char and char:FindFirstChild("HumanoidRootPart")
        local hum   = char and char:FindFirstChildOfClass("Humanoid")
        local alive = hrp and hum and hum.Health > 0

        if not alive or not lRoot then hideAll(o); continue end

        local dist = (hrp.Position - lRoot.Position).Magnitude
        if dist > CFG.ESP.MaxDist then hideAll(o); continue end

        local bb = getBoundingBox(char)
        if not bb then hideAll(o); continue end

        local x, y, w, h =
            bb.center.X - bb.width * 0.5, bb.top.Y, bb.width, bb.height

        if CFG.ESP.Boxes then
            o.BoxLines[1].From=Vector2.new(x,y);   o.BoxLines[1].To=Vector2.new(x+w,y)
            o.BoxLines[2].From=Vector2.new(x,y+h); o.BoxLines[2].To=Vector2.new(x+w,y+h)
            o.BoxLines[3].From=Vector2.new(x,y);   o.BoxLines[3].To=Vector2.new(x,y+h)
            o.BoxLines[4].From=Vector2.new(x+w,y); o.BoxLines[4].To=Vector2.new(x+w,y+h)
            for _, l in ipairs(o.BoxLines) do l.Visible = true end
        else
            for _, l in ipairs(o.BoxLines) do l.Visible = false end
        end

        if CFG.ESP.Names then
            o.NameTag.Text     = player.DisplayName
            o.NameTag.Position = Vector2.new(bb.center.X, y - 16)
            o.NameTag.Visible  = true
        else o.NameTag.Visible = false end

        if CFG.ESP.Distance then
            o.DistTag.Text     = string.format("[%.0fm]", dist)
            o.DistTag.Position = Vector2.new(bb.center.X, y + h + 4)
            o.DistTag.Visible  = true
        else o.DistTag.Visible = false end

        if CFG.ESP.Tracer then
            local vp = Camera.ViewportSize
            o.Tracer.From    = Vector2.new(vp.X * 0.5, vp.Y)
            o.Tracer.To      = bb.center
            o.Tracer.Visible = true
        else o.Tracer.Visible = false end
    end
end)

