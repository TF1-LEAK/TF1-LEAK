-- *ce hook fait croire au moteur que ta souris vise déjà la tête*
-- on wrap WorldToViewportPoint pour rediriger la projection
-- (compatible UNC hookfunction)

local function getClosestPlayerToMouse()
    local mousePos = UserInputService:GetMouseLocation()
    local closest  = nil
    local bestDist = CFG.AIM.FOV

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if CFG.AIM.TeamCheck and player.Team == LocalPlayer.Team then continue end

        local char = player.Character
        local bone = char and char:FindFirstChild(CFG.AIM.Bone)
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not bone or not hum or hum.Health <= 0 then continue end

        local screenPos, onScreen = Camera:WorldToViewportPoint(bone.Position)
        if not onScreen then continue end

        local sp   = Vector2.new(screenPos.X, screenPos.Y)
        local dist = (sp - mousePos).Magnitude

        if dist < bestDist then
            bestDist = dist
            closest  = bone
        end
    end

    return closest
end

-- Hook sur Camera:WorldToViewportPoint via getrawmetamethod + hookfunction
if hookfunction and getrawmetamethod then
    local origWTV = getrawmetamethod(Camera, "__namecall")

    hookfunction(origWTV, function(self, ...)
        local method = getnamecallmethod()
        if method == "WorldToViewportPoint" and CFG.AIM.Enabled then
            local target = getClosestPlayerToMouse()
            if target then
                return origWTV(self, target.Position)
            end
        end
        return origWTV(self, ...)
    end)
end

--// ============================================================
--//  SPEED HACK
--// ============================================================

RunService.Heartbeat:Connect(function()
    if not CFG.MOVEMENT.SpeedEnabled then return end
    local char = LocalPlayer.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        -- on patch WalkSpeed chaque heartbeat pour contrer les resets serveur
        hum.WalkSpeed = 16 * CFG.MOVEMENT.SpeedMultiplier
    end
end)

--// ============================================================
--//  INFINITE JUMP
--// ============================================================

UserInputService.JumpRequest:Connect(function()
    if not CFG.MOVEMENT.InfJump then return end
    local char = LocalPlayer.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

--// ============================================================
--//  PLAYER TRACKING — auto-add / remove
--// ============================================================

for _, player in ipairs(Players:GetPlayers()) do
    createESPForPlayer(player)
end

Players.PlayerAdded:Connect(createESPForPlayer)
Players.PlayerRemoving:Connect(removeESP)

print("[Rivals Cheat] Loaded — ESP | SilentAim | Speed | InfJump ✌️")
