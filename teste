local ESPObjects = {}

local function newDraw(dtype, props)
    local o = Drawing.new(dtype)
    for k, v in pairs(props) do o[k] = v end
    return o
end

local function createESPForPlayer(player)
    if player == LocalPlayer then return end
    local o = {}
    o.BoxLines = {}
    for i = 1, 4 do
        o.BoxLines[i] = newDraw("Line", {
            Thickness=1.5, Color=CFG.ESP.BoxColor, Visible=false, ZIndex=2
        })
    end
    o.NameTag = newDraw("Text", {
        Size=13, Color=CFG.ESP.NameColor,
        Outline=true, Center=true, Visible=false, ZIndex=3
    })
    o.DistTag = newDraw("Text", {
        Size=11, Color=CFG.ESP.DistColor,
        Outline=true, Center=true, Visible=false, ZIndex=3
    })
    o.Tracer = newDraw("Line", {
        Thickness=1, Color=CFG.ESP.TracerColor, Visible=false, ZIndex=1
    })
    ESPObjects[player] = o
end

local function removeESP(player)
    local o = ESPObjects[player]
    if not o then return end
    for _, l in ipairs(o.BoxLines) do l:Remove() end
    o.NameTag:Remove(); o.DistTag:Remove(); o.Tracer:Remove()
    ESPObjects[player] = nil
end

local function hideAll(o)
    for _, l in ipairs(o.BoxLines) do l.Visible = false end
    o.NameTag.Visible = false
    o.DistTag.Visible = false
    o.Tracer.Visible  = false
end

--// ============================================================
--//  ONSCREEN CHECK
--// ============================================================

local function isOnScreen(v2, onScreen)
    if not onScreen then return false end
    local vp = Camera.ViewportSize
    return v2.X >= 0 and v2.X <= vp.X
       and v2.Y >= 0 and v2.Y <= vp.Y
end

local function worldToScreen(pos)
    local sp, on = Camera:WorldToViewportPoint(pos)
    return Vector2.new(sp.X, sp.Y), on
end

local function getBoundingBox(char)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local hum    = char:FindFirstChildOfClass("Humanoid")
    local height = hum and hum.HipHeight * 2 + 0.5 or 5
    local topV   = hrp.Position + Vector3.new(0, height * 0.5, 0)
    local botV   = hrp.Position - Vector3.new(0, height * 0.5, 0)
    local topSS, onT = worldToScreen(topV)
    local botSS, onB = worldToScreen(botV)
    if not isOnScreen(topSS, onT) and not isOnScreen(botSS, onB) then
        return nil
    end
    return {
        top    = topSS, bottom = botSS,
        width  = math.abs(topSS.X - botSS.X) + 40,
        height = math.abs(topSS.Y - botSS.Y),
        center = Vector2.new(
            (topSS.X + botSS.X) * 0.5,
            (topSS.Y + botSS.Y) * 0.5
        ),
    }
end

