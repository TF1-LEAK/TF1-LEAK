local function gC(p) return p and p.Character end
local function gR(p) local ch=gC(p) return ch and ch:FindFirstChild("HumanoidRootPart") end
local function gH(p) local ch=gC(p) return ch and ch:FindFirstChildOfClass("Humanoid") end
local function gHd(p) local ch=gC(p) return ch and ch:FindFirstChild("Head") end
local function gP(p,n) local ch=gC(p) if not ch then return nil end return ch:FindFirstChild(n) or ch:FindFirstChild("Head") end
local function alive(p) local h=gH(p) return h and h.Health>0 end
local function enemy(p) if not c.tc then return true end return p.Team~=lp.Team end
local function w2s(pos) local s,v=cam:WorldToViewportPoint(pos) return Vector2.new(s.X,s.Y),v end
local function los(o,part)
    local hit=workspace:FindPartOnRayWithIgnoreList(Ray.new(o,part.Position-o),{gC(lp)})
    if not hit then return true end return Pl:GetPlayerFromCharacter(hit.Parent)~=nil
end
local function targets()
    local out={}
    for _,p in ipairs(Pl:GetPlayers()) do
        if p~=lp and alive(p) and enemy(p) then
            local r=gR(p)
            if r and(r.Position-cam.CFrame.Position).Magnitude<=c.md then table.insert(out,p) end
        end
    end
    return out
end
local function best(ts,fov)
    local bt,bd=nil,fov
    local ctr=Vector2.new(cam.ViewportSize.X/2,cam.ViewportSize.Y/2)
    for _,p in ipairs(ts) do
        local pt=gP(p,c.ap)
        if pt then local s2,vis=w2s(pt.Position)
            if vis then local d=(s2-ctr).Magnitude
                if d<bd then
                    if not c.wc or los(cam.CFrame.Position,pt) then bt,bd=p,d end
                end
            end
        end
    end
    return bt
end

-- aim
local function doSA() if not c.sa then return end local b=best(targets(),c.fr) if not b then return end local pt=gP(b,c.ap) if not pt then return end local o=cam.CFrame.Position cam.CFrame=CFrame.new(o,pt.Position) end
local function doAA()
    if not c.aa then return end
    if c.aw=="While" and not UI:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
    local b=best(targets(),c.af) if not b then return end
    local pt=gP(b,c.ap) if not pt then return end
    if c.wc and not los(cam.CFrame.Position,pt) then return end
    local o=cam.CFrame.Position local cur=cam.CFrame.LookVector
    local des=(pt.Position-o).Unit local t=math.clamp((c.as/100)/math.max(1,c.asm*0.1),0,1)
    cam.CFrame=CFrame.new(o,o+cur:Lerp(des,t))
end
local ltrig=0
local function doTB()
    if not c.tb then return end if tick()-ltrig<c.td/1000 then return end
    local ctr=Vector2.new(cam.ViewportSize.X/2,cam.ViewportSize.Y/2)
    for _,p in ipairs(targets()) do local pt=gP(p,c.ap) if pt then local s2,vis=w2s(pt.Position)
        if vis and(s2-ctr).Magnitude<10 then
            pcall(function() if mouse1click then mouse1click() else local vi=game:GetService("VirtualInputManager") vi:SendMouseButtonEvent(0,0,0,true,game,0) task.wait(0.05) vi:SendMouseButtonEvent(0,0,0,false,game,0) end end)
            ltrig=tick() return
        end
    end end
end

