-- chams
local co={}
local function aCh(p) local ch=gC(p) if not ch then return end for _,pt in ipairs(ch:GetDescendants()) do if pt:IsA("BasePart") and pt.Name~="HumanoidRootPart" then if not co[pt] then co[pt]={col=pt.Color,tr=pt.Transparency,mat=pt.Material} end pt.Color=enemy(p) and c.ec or c.mc pt.Transparency=(100-c.cft)/100 pt.Material=Enum.Material.Neon end end end
local function rCh(p) local ch=gC(p) if not ch then return end for _,pt in ipairs(ch:GetDescendants()) do if co[pt] then pt.Color=co[pt].col pt.Transparency=co[pt].tr pt.Material=co[pt].mat co[pt]=nil end end end

-- world
local function doW()
    if c.fb then Li.Brightness=10 Li.ClockTime=14 Li.FogEnd=1e6 Li.GlobalShadows=false Li.Ambient=Color3.fromRGB(178,178,178) Li.OutdoorAmbient=Color3.fromRGB(178,178,178) end
    if c.nm2 and not c.fb then Li.ClockTime=0 Li.Brightness=c.ns2 end
    if c.ftm and not c.fb and not c.nm2 then Li.ClockTime=c.tv end
    local bl=Li:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect",Li)
    bl.Enabled=c.bl bl.Intensity=c.bi bl.Size=c.bs bl.Threshold=c.bt
    if c.rge then for _,v in ipairs(Li:GetChildren()) do if v:IsA("DepthOfFieldEffect") or v:IsA("SunRaysEffect") then v.Enabled=false end end end
end

-- esp pool
local pool={}
local function gO(p) if not pool[p] then pool[p]={box=nS(),name=nT(),hBG=nS(),hBar=nS(),dist=nT(),snap=nL(),arr=nT()} end return pool[p] end
local function hO(p) if pool[p] then for _,v in pairs(pool[p]) do v.Visible=false end end end

local function doESP()
    if not c.esp then for p in pairs(pool) do hO(p) end return end
    local vp=cam.ViewportSize local ctr=Vector2.new(vp.X/2,vp.Y/2)
    for _,p in ipairs(Pl:GetPlayers()) do
        if p==lp then goto ct end
        if not alive(p) or(not enemy(p) and not c.st) then hO(p) goto ct end
        local obj=gO(p) local root=gR(p) local head=gHd(p)
        if not root or not head then hO(p) goto ct end
        local rs,rv=w2s(root.Position) local hs,_=w2s(head.Position+Vector3.new(0,0.7,0))
        if not rv then hO(p) goto ct end
        local col=c.ec if c.vcc and los(cam.CFrame.Position,head) then col=c.vc end if not enemy(p) then col=c.mc end
        local dist=math.floor((root.Position-cam.CFrame.Position).Magnitude)
        local bH=math.max(10,math.abs(hs.Y-rs.Y)*1.8) local bW=bH*0.55
        if c.bx then obj.box.Visible=true obj.box.Color=col obj.box.Thickness=1 obj.box.Filled=c.bf obj.box.Size=Vector2.new(bW,bH) obj.box.Position=Vector2.new(rs.X-bW/2,rs.Y-bH) else obj.box.Visible=false end
        if c.nm then obj.name.Visible=true obj.name.Text=p.DisplayName obj.name.Size=c.ts obj.name.Color=col obj.name.Center=true obj.name.Position=Vector2.new(rs.X,hs.Y-c.ts-2) else obj.name.Visible=false end
        if c.dt then obj.dist.Visible=true obj.dist.Text=dist.."m" obj.dist.Size=c.ts-1 obj.dist.Color=Color3.fromRGB(200,200,200) obj.dist.Center=true obj.dist.Position=Vector2.new(rs.X,rs.Y+2) else obj.dist.Visible=false end
        if c.hb then local hum=gH(p) local hp=hum and math.clamp(hum.Health/hum.MaxHealth,0,1) or 1 local barH=bH*hp obj.hBG.Visible=true obj.hBG.Filled=true obj.hBG.Size=Vector2.new(4,bH) obj.hBG.Color=Color3.fromRGB(40,40,40) obj.hBG.Position=Vector2.new(rs.X-bW/2-6,rs.Y-bH) obj.hBar.Visible=true obj.hBar.Filled=true obj.hBar.Size=Vector2.new(4,barH) obj.hBar.Position=Vector2.new(rs.X-bW/2-6,rs.Y-barH) obj.hBar.Color=Color3.fromRGB(math.floor(255*(1-hp)),math.floor(255*hp),40) else obj.hBar.Visible=false obj.hBG.Visible=false end
        if c.sl then local orig=Vector2.new(ctr.X,vp.Y) obj.snap.Visible=true obj.snap.From=orig obj.snap.To=rs obj.snap.Color=col obj.snap.Thickness=1 else obj.snap.Visible=false end
        ::ct::
    end
end

-- hit marker
local hl={nL(),nL(),nL(),nL()} local ht=0
local function sHit(kill)
    if not c.hm then return end
    local ctr=Vector2.new(cam.ViewportSize.X/2,cam.ViewportSize.Y/2)
    local g,s=c.hmg,c.hms local col=kill and c.kmc or c.hmc local sc=kill and c.kms or 1
    local pts={{Vector2.new(-g,-g),Vector2.new(-g-s,-g-s)},{Vector2.new(g,g),Vector2.new(g+s,g+s)},{Vector2.new(g,-g),Vector2.new(g+s,-g-s)},{Vector2.new(-g,g),Vector2.new(-g-s,g+s)}}
    for i,pair in ipairs(pts) do hl[i].From=ctr+pair[1]*sc hl[i].To=ctr+pair[2]*sc hl[i].Color=col hl[i].Thickness=c.hmth hl[i].Visible=true end
    ht=tick()
end

