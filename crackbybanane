-- ══════════════════════════════════════
--[[
  FIX:  Camera:WorldToViewportPoint retourne 3 valeurs :
          (screenPos: Vector3, onScreen: boolean, depth: number)
        L'ancien code faisait `local hSc, hV = ...` donc hV = bool,
        mais le check `if not hV` ratait quand onScreen=true (truthy).
        De plus il faut vérifier hSc.Z > 0 (devant la caméra).
        La nouvelle version unpack correctement les 3 retours.
]]

local ESPCache = {}

local function makeDrawing(dtype, props)
    local d = Drawing.new(dtype)
    for k, v in pairs(props) do
        pcall(function() d[k] = v end)
    end
    return d
end

local function getESP(p)
    if not ESPCache[p] then
        ESPCache[p] = {
            Box      = makeDrawing("Square", {
                Visible=false, Color=T.Yellow,
                Thickness=1.5, Filled=false
            }),
            BoxFill  = makeDrawing("Square", {
                Visible=false, Color=T.Yellow,
                Transparency=0.92, Filled=true
            }),
            Name     = makeDrawing("Text", {
                Visible=false, Color=T.Yellow,
                Size=13, Center=true,
                Outline=true, OutlineColor=T.Black,
                Font=Drawing.Fonts.GothamBold,
            }),
            HP       = makeDrawing("Text", {
                Visible=false, Color=T.Green,
                Size=11, Center=true,
                Outline=true, OutlineColor=T.Black,
            }),
            Dist     = makeDrawing("Text", {
                Visible=false, Color=T.TextDim,
                Size=10, Center=true,
                Outline=true, OutlineColor=T.Black,
            }),
            Tracer   = makeDrawing("Line", {
                Visible=false, Color=T.Yellow,
                Thickness=1.2
            }),
            HPBar    = makeDrawing("Square", {
                Visible=false, Color=T.Green,
                Filled=true, Thickness=0
            }),
            HPBarBG  = makeDrawing("Square", {
                Visible=false, Color=Color3.fromRGB(30,30,30),
                Filled=true, Thickness=0
            }),
        }
    end
    return ESPCache[p]
end

local function removeESP(p)
    if ESPCache[p] then
        for _, d in pairs(ESPCache[p]) do
            pcall(function() d:Remove() end)
        end
        ESPCache[p] = nil
    end
end

local function hideESP(esp)
    for _, d in pairs(esp) do
        d.Visible = false
    end
end

local function tickESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if S.ESP.TeamCheck and p.Team == LP.Team then continue end

        local esp  = getESP(p)
        local char = p.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")

        if not root or not hum or hum.Health <= 0 or not S.ESP.On then
            hideESP(esp)
            continue
        end

        local dist = (Camera.CFrame.Position - root.Position).Magnitude
        if dist > S.ESP.MaxDist then
            hideESP(esp)
            continue
        end

        -- ── PROJECTION FIXÉE ──
        local head  = char:FindFirstChild("Head")
        local headP = head and head.Position or (root.Position + Vector3.new(0, 2.5, 0))
        local feetP = root.Position - Vector3.new(0, 3, 0)

        -- Unpack CORRECT des 3 valeurs retournées
        local hSc, hOn, hDepth = Camera:WorldToViewportPoint(headP)
        local fSc, fOn, _      = Camera:WorldToViewportPoint(feetP)

        -- Guard : doit être devant la caméra ET dans l'écran
        if not hOn or hSc.Z <= 0 then
            hideESP(esp)
            continue
        end

        local H = math.abs(hSc.Y - fSc.Y)
        if H < 5 then hideESP(esp); continue end

        local W  = math.max(H * 0.45, 20)
        local TL = Vector2.new(hSc.X - W / 2, hSc.Y)

        -- Couleur selon team ou config
        local col = S.ESP.BoxColor

        -- Box outline
        if S.ESP.Box then
            esp.Box.Visible  = true
            esp.Box.Color    = col
            esp.Box.Position = TL
            esp.Box.Size     = Vector2.new(W, H)

            esp.BoxFill.Visible      = true
            esp.BoxFill.Color        = col
            esp.BoxFill.Position     = TL
            esp.BoxFill.Size         = Vector2.new(W, H)
            esp.BoxFill.Transparency = 0.93
        else
            esp.Box.Visible    = false
            esp.BoxFill.Visible= false
        end

        -- HP Bar (à gauche de la box)
        local hp    = hum.Health
        local mhp   = math.max(hum.MaxHealth, 1)
        local ratio = math.clamp(hp / mhp, 0, 1)

        if S.ESP.Health then
            local barX  = TL.X - 6
            local barH  = H
            local fillH = barH * ratio

            esp.HPBarBG.Visible  = true
            esp.HPBarBG.Position = Vector2.new(barX - 3, TL.Y)
            esp.HPBarBG.Size     = Vector2.new(4, barH)

            local r = math.floor(255 * (1 - ratio))
            local g = math.floor(255 * ratio)
            esp.HPBar.Visible  = true
            esp.HPBar.Color    = Color3.fromRGB(r, g, 0)
            esp.HPBar.Position = Vector2.new(barX - 3, TL.Y + barH - fillH)
            esp.HPBar.Size     = Vector2.new(4, fillH)

            -- Texte HP
            esp.HP.Visible   = true
            esp.HP.Text      = math.floor(hp) .. "/" .. math.floor(mhp)
            esp.HP.Color     = Color3.fromRGB(r, g, 0)
            esp.HP.Position  = Vector2.new(hSc.X, fSc.Y + 4)
        else
            esp.HPBar.Visible   = false
            esp.HPBarBG.Visible = false
            esp.HP.Visible      = false
        end

        -- Nom
        if S.ESP.Name then
            esp.Name.Visible  = true
            esp.Name.Text     = p.Name
            esp.Name.Color    = col
            esp.Name.Position = Vector2.new(hSc.X, hSc.Y - 16)
        else
            esp.Name.Visible = false
        end

        -- Distance
        if S.ESP.Distance then
            esp.Dist.Visible  = true
            esp.Dist.Text     = string.format("[%.0fm]", dist)
            esp.Dist.Position = Vector2.new(hSc.X, fSc.Y + 16)
        else
            esp.Dist.Visible = false
        end

        -- Tracer
        if S.ESP.Tracers then
            local vp   = Camera.ViewportSize
            local foot = fOn and Vector2.new(fSc.X, fSc.Y) or Vector2.new(hSc.X, hSc.Y)
            esp.Tracer.Visible = true
            esp.Tracer.Color   = col
            esp.Tracer.From    = Vector2.new(vp.X / 2, vp.Y)
            esp.Tracer.To      = foot
        else
            esp.Tracer.Visible = false
        end
    end
end

