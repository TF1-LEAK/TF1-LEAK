local function CreateESPForPlayer(player)
    if player == LocalPlayer then return end
    
    local espData = {
        Player     = player,
        Billboard  = nil,
        Box        = nil,
    }
    
    local function Rebuild()
        -- Nettoie ancien
        if espData.Billboard then espData.Billboard:Destroy() end
        if espData.Box then espData.Box:Destroy() end
        
        local char = player.Character
        if not char then return end
        local hrp  = char:FindFirstChild("HumanoidRootPart")
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end
        
        -- BillboardGui ESP
        local bb = Instance.new("BillboardGui")
        bb.Name          = "BananaESP_" .. player.Name
        bb.AlwaysOnTop   = true
        bb.Size          = UDim2.new(0, 200, 0, 80)
        bb.StudsOffset   = Vector3.new(0, 3, 0)
        bb.Adornee       = hrp
        bb.Parent        = CoreGui
        
        -- Nom + distance
        local nameLabel = Instance.new("TextLabel", bb)
        nameLabel.Size               = UDim2.new(1, 0, 0.5, 0)
        nameLabel.Position           = UDim2.new(0, 0, 0, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.TextColor3         = CONFIG.COLORS.ACCENT
        nameLabel.TextStrokeTransparency = 0
        nameLabel.Font               = Enum.Font.GothamBold
        nameLabel.TextSize           = 13
        nameLabel.Text               = player.Name
        
        -- Santé
        local hpLabel = Instance.new("TextLabel", bb)
        hpLabel.Size                 = UDim2.new(1, 0, 0.5, 0)
        hpLabel.Position             = UDim2.new(0, 0, 0.5, 0)
        hpLabel.BackgroundTransparency = 1
        hpLabel.TextColor3           = CONFIG.COLORS.ONLINE
        hpLabel.TextStrokeTransparency = 0
        hpLabel.Font                 = Enum.Font.Gotham
        hpLabel.TextSize             = 11
        hpLabel.Text                 = string.format("HP: %.0f/%.0f", hum.Health, hum.MaxHealth)
        
        -- SelectionBox (boîte 3D)
        local box = Instance.new("SelectionBox")
        box.Color3           = CONFIG.COLORS.ACCENT
        box.LineThickness    = 0.05
        box.SurfaceTransparency = 0.9
        box.SurfaceColor3    = CONFIG.COLORS.ACCENT
        box.Adornee          = char
        box.Parent           = CoreGui
        
        espData.Billboard = bb
        espData.Box       = box
        
        -- Update loop
        local conn
        conn = RunService.RenderStepped:Connect(function()
            if not ESP.Enabled or not player.Character or 
               not player.Character:FindFirstChild("HumanoidRootPart") then
                if espData.Billboard then espData.Billboard:Destroy() end
                if espData.Box then espData.Box:Destroy() end
                conn:Disconnect()
                return
            end
            
            local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
            if dist > ESP.MaxDist then
                bb.Enabled = false
                box.Visible = false
                return
            end
            
            bb.Enabled  = true
            box.Visible = true
            
            local h = player.Character:FindFirstChildOfClass("Humanoid")
            if h then
                hpLabel.Text = string.format("HP: %.0f/%.0f [%.0fm]", 
                    h.Health, h.MaxHealth, dist)
                -- Couleur HP dynamique
                local ratio = h.Health / h.MaxHealth
                hpLabel.TextColor3 = Color3.fromRGB(
                    math.floor(255 * (1 - ratio)),
                    math.floor(255 * ratio),
                    50
                )
            end
        end)
    end
    
    Rebuild()
    player.CharacterAdded:Connect(function()
        task.wait(1)
        Rebuild()
    end)
    
    ESP.Objects[player.Name] = espData
end

function ESP:Enable()
    self.Enabled = true
    for _, p in ipairs(Players:GetPlayers()) do
        CreateESPForPlayer(p)
    end
    table.insert(self.Connections, Players.PlayerAdded:Connect(function(p)
        task.wait(1)
        CreateESPForPlayer(p)
    end))
end

function ESP:Disable()
    self.Enabled = false
    for _, data in pairs(self.Objects) do
        if data.Billboard then data.Billboard:Destroy() end
        if data.Box then data.Box:Destroy() end
    end
    self.Objects = {}
    for _, conn in ipairs(self.Connections) do conn:Disconnect() end
    self.Connections = {}
end

