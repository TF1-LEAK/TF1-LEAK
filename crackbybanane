-- BOOT
-- ══════════════════════════════════════
local function boot()
    local saved = loadSession()
    if saved and validateKey(saved) then
        keyOK = true
        buildMainGui()
        startLoop()
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title="🍌 Banane Service",
                Text="Session restaurée — Bienvenue " .. LP.Name,
                Duration=4,
            })
        end)
        return
    end

    buildKeyGui(function()
        keyOK = true
        buildMainGui()
        startLoop()
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title="🍌 Banane Service",
                Text="Activé avec succès — GL brody 😏",
                Duration=4,
            })
        end)
    end)
end

boot()
