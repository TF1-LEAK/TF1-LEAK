local function boot()
    -- Check session sauvegardée
    local savedKey = loadSession()
    if savedKey and validateKeyLocal(savedKey) then
        keyValidated = true
        buildMainGui()
        startMainLoop()
        return
    end

    -- Sinon: afficher le Key GUI
    buildKeyGui(function()
        buildMainGui()
        startMainLoop()
    end)
end

