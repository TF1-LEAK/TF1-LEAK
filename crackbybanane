                        while row and row.Parent do
                            local pc = pl.Character
                            local mc = LP.Character
                            if pc and mc then
                                local pr = pc:FindFirstChild("HumanoidRootPart")
                                local mr = mc:FindFirstChild("HumanoidRootPart")
                                if pr and mr then
                                    local d = math.floor((pr.Position - mr.Position).Magnitude)
                                    distL.Text      = d .. "m"
                                    distL.TextColor3 = d < 30 and T.Green or (d < 150 and T.Orange or T.TextDim)
