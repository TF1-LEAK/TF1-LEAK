-- ANTI-CHEAT BYPASS
-- ══════════════════════════════════════
local function initBypass()
    -- Hook namecall pour bloquer les remotes de détection
    pcall(function()
        if not hookfunction then return end
        local mt = getrawmetatable(game)
        local oldNC = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" then
                local n = (self.Name or ""):lower()
                local blocked = {
                    "anticheat","kick","report","speedcheck",
                    "teleportcheck","flagplayer","sanity","detecthack"
                }
                for _, b in ipairs(blocked) do
                    if n:find(b) then
                        if S.Bypass.RemoteLog then
                            warn("[BananeService Bypass] Bloqué: " .. self.Name)
                        end
                        return
                    end
                end
            end
            return oldNC(self, ...)
        end)
        setreadonly(mt, true)
    end)

    -- Anti-kick
    pcall(function()
        if not hookfunction then return end
        local mt = getrawmetatable(LP)
        setreadonly(mt, false)
        local oldIdx = mt.__index
        mt.__index = newcclosure(function(t, k)
            if k == "Kick" then
                return function() warn("[BananeService] Kick intercepté 🍌") end
            end
            return oldIdx(t, k)
        end)
        setreadonly(mt, true)
    end)
end

