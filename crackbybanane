-- ANTI-CHEAT BYPASS — Infected Lands
-- ══════════════════════════════════════
-- *le bypass hook __namecall avant que le serveur
--  entende quoi que ce soit — la banane est silencieuse* 🍌

local bypassActive = false

local function initBypass()
    if bypassActive then return end
    bypassActive = true

    -- ── HOOK __namecall : bloque remotes AC, intercepte les ray casts ──
    pcall(function()
        if not hookfunction or not getrawmetatable then return end

        local mt   = getrawmetatable(game)
        local oldNC = mt.__namecall

        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args   = { ... }

            -- Bloc remotes anti-cheat
            if method == "FireServer" or method == "InvokeServer" then
                local name = (typeof(self) == "Instance" and self.Name or ""):lower()
                local blocked = {
                    "anticheat","kick","speedcheck","teleportcheck",
                    "flagplayer","sanity","detecthack","report",
                    "validatepos","checkposition","ratelimit",
                }
                for _, b in ipairs(blocked) do
                    if name:find(b) then
                        if S.Bypass.RemoteLog then
                            warn("[🍌 Bypass] Remote bloquée: " .. tostring(self.Name))
                        end
                        return  -- drop silencieux
                    end
                end
            end

            -- Redirige les ray casts vers la cible silent aim
            if S.Aimbot.On and S.Aimbot.Silent then
                if method == "FindPartOnRay"
                or method == "FindPartOnRayWithWhitelist"
                or method == "FindPartOnRayWithBlacklist" then
                    -- on laisse passer normalement,
                    -- la redirection se fait via Mouse.__index (voir plus bas)
                end
            end

            return oldNC(self, ...)
        end)
        setreadonly(mt, true)
    end)

    -- ── HOOK __index sur LP pour anti-kick ──
    pcall(function()
        if not hookfunction or not getrawmetatable then return end
        local mt     = getrawmetatable(LP)
        local oldIdx = mt.__index
        setreadonly(mt, false)
        mt.__index = newcclosure(function(t, k)
            if S.Bypass.AntiKick and k == "Kick" then
                return function()
                    warn("[🍌 Bypass] Kick intercepté sur " .. LP.Name)
                end
            end
            return oldIdx(t, k)
        end)
        setreadonly(mt, true)
    end)

    -- ── Disable localscript anti-movement checks ──
    pcall(function()
        for _, ls in ipairs(LP.PlayerScripts:GetDescendants()) do
            if ls:IsA("LocalScript") then
                local n = ls.Name:lower()
                if n:find("anticheat") or n:find("movement") or n:find("detect") then
                    ls.Disabled = true
                end
            end
        end
    end)
end

