        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        BackgroundTransparency = 1,
        Size = UDim2.new(1,0,0,34),
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false,
        ZIndex = 5,
    }, frame)

    local dropdown = New("Frame", {
        BackgroundColor3 = T.BG2,
        Size = UDim2.new(1,0,0,#options*30),
        Position = UDim2.new(0,0,1,2),
        Visible = false,
        BorderSizePixel = 0,
        ZIndex = 10,
    }, frame)
    Corner(8, dropdown)
    Stroke(T.Yellow, 1, dropdown)

    New("UIListLayout", {Padding=UDim.new(0,2), FillDirection=Enum.FillDirection.Vertical}, dropdown)
    Pad(4,4,4,4,dropdown)

    for _, opt in ipairs(options) do
        local ob = New("TextButton", {
            Text = opt,
            TextColor3 = T.Text,
            Font = Enum.Font.GothamMedium,
            TextSize = 12,
            BackgroundColor3 = T.BG3,
            Size = UDim2.new(1,0,0,26),
            BorderSizePixel = 0,
            AutoButtonColor = false,
            ZIndex = 10,
        }, dropdown)
        Corner(6, ob)
        ob.MouseEnter:Connect(function() Tween(ob,{BackgroundColor3=T.YellowBg},0.1) end)
        ob.MouseLeave:Connect(function() Tween(ob,{BackgroundColor3=T.BG3},0.1)     end)
        ob.MouseButton1Click:Connect(function()
            header.Text = "  " .. label .. ": " .. opt .. "  ▾"
            open = false
            Tween(dropdown, {Size=UDim2.new(1,0,0,0)}, 0.15)
            task.wait(0.15)
            dropdown.Visible = false
            if cb then cb(opt) end
        end)
    end

    header.MouseButton1Click:Connect(function()
        open = not open
        if open then
            dropdown.Visible = true
            dropdown.Size    = UDim2.new(1,0,0,0)
            Tween(dropdown, {Size=UDim2.new(1,0,0,#options*30)}, 0.15)
        else
            Tween(dropdown, {Size=UDim2.new(1,0,0,0)}, 0.15)
            task.wait(0.15)
            dropdown.Visible = false
        end
    end)

    return frame
end

