-- Dessine le cercle FOV à l'écran
function Aimbot:DrawFOV()
    if Drawing then
        if self.FOVCircle then self.FOVCircle:Remove() end
        self.FOVCircle = Drawing.new("Circle")
        self.FOVCircle.Position  = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        self.FOVCircle.Radius    = self.FOV
        self.FOVCircle.Color     = Color3.fromRGB(255, 220, 50)
        self.FOVCircle.Thickness = 1.5
        self.FOVCircle.Filled    = false
        self.FOVCircle.Visible   = true
        self.FOVCircle.Transparency = 0.85
    end
end

function Aimbot:GetClosestTarget()
    local closest  = nil
    local closestD = self.FOV
    local center   = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local part = player.Character:FindFirstChild(self.TargetPart)
                      or player.Character:FindFirstChild("HumanoidRootPart")
            local hum  = player.Character:FindFirstChildOfClass("Humanoid")
            
            if part and hum and hum.Health > 0 then
                local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if dist2D < closestD then
                        closestD = dist2D
                        closest  = player
                    end
                end
            end
        end
    end
    
    return closest
end

function Aimbot:Enable()
    self.Enabled = true
    self:DrawFOV()
    
    self.Connection = RunService.RenderStepped:Connect(function()
        if not self.Enabled then return end
        
        self.CurrentTarget = self:GetClosestTarget()
        
        if self.CurrentTarget and self.CurrentTarget.Character then
            local part = self.CurrentTarget.Character:FindFirstChild(self.TargetPart)
                      or self.CurrentTarget.Character:FindFirstChild("HumanoidRootPart")
            if not part then return end
            
            -- Smooth aim vers la cible
            local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, part.Position)
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, self.Smoothness)
        end
    end)
end

function Aimbot:EnableSilent()
    self.SilentEnabled = true
    
    -- Hook le raycast de la souris pour rediriger vers la cible
    local mt = SafeGetRawMetatable(LocalPlayer)
    SafeSetReadonly(mt, false)
    
    local OldIndex = mt.__index
    mt.__index = newcclosure(function(self2, key)
        if key == "Hit" or key == "Target" then
            local target = Aimbot:GetClosestTarget()
            if target and target.Character then
                local part = target.Character:FindFirstChild(Aimbot.TargetPart)
                          or target.Character:FindFirstChild("HumanoidRootPart")
                if part then
                    if key == "Hit" then
                        return CFrame.new(part.Position)
                    elseif key == "Target" then
                        return part
                    end
                end
            end
        end
        return OldIndex(self2, key)
    end)
    
    SafeSetReadonly(mt, true)
end

function Aimbot:Disable()
    self.Enabled        = false
    self.SilentEnabled  = false
    self.CurrentTarget  = nil
    if self.Connection then self.Connection:Disconnect() end
    if self.FOVCircle   then self.FOVCircle:Remove() end
end

