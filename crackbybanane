local function New(class, props, parent)
    local i = Instance.new(class)
    for k, v in pairs(props) do
        pcall(function() i[k] = v end)
    end
    if parent then i.Parent = parent end
    return i
end

local function Tween(obj, props, t, style, dir)
    if not obj or not obj.Parent then return end
    local ti = TweenInfo.new(
        t     or 0.18,
        style or Enum.EasingStyle.Quart,
        dir   or Enum.EasingDirection.Out
    )
    TweenService:Create(obj, ti, props):Play()
end

local function Spring(obj, props, t)
    Tween(obj, props, t or 0.35, Enum.EasingStyle.Spring)
end

local function Corner(r, parent)
    return New("UICorner", {CornerRadius = UDim.new(0, r or 8)}, parent)
end

local function Stroke(c, th, parent)
    return New("UIStroke", {Color = c or T.Border, Thickness = th or 1}, parent)
end

local function Pad(l, r, t, b, parent)
    return New("UIPadding", {
        PaddingLeft   = UDim.new(0, l or 8),
        PaddingRight  = UDim.new(0, r or 8),
        PaddingTop    = UDim.new(0, t or 6),
        PaddingBottom = UDim.new(0, b or 6),
    }, parent)
end

local function Ripple(parent, x, y)
    if not parent or not parent.AbsoluteSize then return end
    local ap = parent.AbsolutePosition
    local ripple = New("Frame", {
        BackgroundColor3     = T.Yellow,
        BackgroundTransparency = 0.5,
        Size                 = UDim2.new(0, 0, 0, 0),
        Position             = UDim2.new(0, x - ap.X, 0, y - ap.Y),
        BorderSizePixel      = 0,
        ZIndex               = parent.ZIndex + 10,
        ClipsDescendants     = false,
    }, parent)
    Corner(999, ripple)
    local maxSize = math.max(parent.AbsoluteSize.X, parent.AbsoluteSize.Y) * 2.5
    Tween(ripple, {
        Size                 = UDim2.new(0, maxSize, 0, maxSize),
        Position             = UDim2.new(0, (x - ap.X) - maxSize/2, 0, (y - ap.Y) - maxSize/2),
        BackgroundTransparency = 1,
    }, 0.55, Enum.EasingStyle.Quart)
    task.delay(0.6, function()
        if ripple and ripple.Parent then ripple:Destroy() end
    end)
end

local function SpawnBubble(parent, x, y)
    local size = math.random(6, 16)
    local bx   = x + math.random(-20, 20)
    local bubble = New("Frame", {
        BackgroundColor3     = (math.random(1,3) == 1) and T.YellowGlow or T.Yellow,
        BackgroundTransparency = 0.3,
        Size                 = UDim2.new(0, size, 0, size),
        Position             = UDim2.new(0, bx, 0, y),
        BorderSizePixel      = 0,
        ZIndex               = 200,
    }, parent)
    Corner(999, bubble)
    local yOff = math.random(30, 80)
    Tween(bubble, {
        Position             = UDim2.new(0, bx + math.random(-10, 10), 0, y - yOff),
        BackgroundTransparency = 1,
        Size                 = UDim2.new(0, size * 0.5, 0, size * 0.5),
    }, math.random(6, 10) / 10, Enum.EasingStyle.Quart)
    task.delay(1.1, function()
        if bubble and bubble.Parent then bubble:Destroy() end
    end)
end

local function BubbleBurst(parent, count)
    count = count or 8
    if not parent or not parent.AbsoluteSize then return end
    local ap = parent.AbsolutePosition
    local as = parent.AbsoluteSize
    for _ = 1, count do
        task.spawn(function()
            task.wait(math.random(0, 15) / 100)
            SpawnBubble(parent, math.random(0, math.max(1, as.X)), math.random(0, math.max(1, as.Y)))
        end)
    end
end

local function GlowPulse(stroke, color, duration)
    color    = color    or T.YellowGlow
    duration = duration or 0.25
    Tween(stroke, {Color = color, Thickness = 2.5}, duration * 0.4)
    task.delay(duration * 0.4, function()
        Tween(stroke, {Color = T.Yellow, Thickness = 1.5}, duration * 0.6)
    end)
end

