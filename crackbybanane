--[[
    ╔══════════════════════════════════════════════════════════╗
    ║         BANANA HUB — KEY SCREEN (LOG ONLY)              ║
    ║         Pas de génération, pas de backend               ║
    ║         Juste: clé correcte → log webhook → accès       ║
    ╚══════════════════════════════════════════════════════════╝

    Flow:
        1. User entre sa clé manuellement
        2. Format check local (BANANA-XXXX-XXXX-XXXX-XXXX)
        3. Si format OK → POST webhook avec infos du joueur
        4. Accès accordé

    Entry points:
        ShowKeyScreen(onSuccess) → affiche l'écran de clé
        onSuccess(isPremium)     → callback vers UI principale

    Side effects:
        - HTTP POST vers webhook Discord (log uniquement)
        - Aucune lecture/écriture fichier
        - Aucun backend requis
--]]

-- ══════════════════════════════════════════
--  CONFIG
-- ══════════════════════════════════════════

local WEBHOOK_URL = "https://discord.com/api/webhooks/TON_ID/TON_TOKEN"

local VALID_KEYS = {
    -- Mets tes clés ici hardcodées
    -- Format: ["LA-CLE"] = {premium = false}
    ["BANANA-AAAA-BBBB-CCCC-DDDD"] = {premium = false},
    ["PREMIUM-1234-5678-9ABC-DEF0"] = {premium = true},
}

local COLORS = {
    BG_MAIN      = Color3.fromRGB(10, 10, 20),
    BG_SECONDARY = Color3.fromRGB(18, 18, 35),
    ACCENT       = Color3.fromRGB(255, 220, 50),
    TEXT_PRIMARY = Color3.fromRGB(240, 240, 255),
    TEXT_DIM     = Color3.fromRGB(140, 140, 170),
    ONLINE       = Color3.fromRGB(50, 220, 100),
    PREMIUM_GOLD = Color3.fromRGB(255, 200, 0),
    DANGER       = Color3.fromRGB(220, 60, 60),
}

-- ══════════════════════════════════════════
--  SERVICES
-- ══════════════════════════════════════════

local Players          = game:GetService("Players")
local HttpService      = game:GetService("HttpService")
local TweenService     = game:GetService("TweenService")
local CoreGui          = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer      = Players.LocalPlayer

-- ══════════════════════════════════════════
--  WEBHOOK LOG
--  Envoie les infos du joueur quand il entre une clé valide
-- ══════════════════════════════════════════

local function LogToWebhook(key, isPremium)
    -- Récupère l'avatar du joueur
    local avatarUrl = string.format(
        "https://www.roblox.com/headshot-thumbnail/image?userId=%d&width=48&height=48&format=png",
        LocalPlayer.UserId
    )

    local payload = HttpService:JSONEncode({
        username   = "🍌 Banana Hub — Key Logger",
        embeds = {{
            author = {
                name     = LocalPlayer.Name .. " (#" .. LocalPlayer.UserId .. ")",
                icon_url = avatarUrl,
            },
            title = isPremium and "👑 Connexion PREMIUM" or "🔑 Nouvelle Connexion",
            color = isPremium and 16763904 or 3066993,
            fields = {
                {
                    name   = "🔑 Clé utilisée",
                    value  = "`" .. key .. "`",
                    inline = false,
                },
                {
                    name   = "👤 Display Name",
                    value  = "`" .. LocalPlayer.DisplayName .. "`",
                    inline = true,
                },
                {
                    name   = "🆔 User ID",
                    value  = "`" .. LocalPlayer.UserId .. "`",
                    inline = true,
                },
                {
                    name   = "🎮 Jeu",
                    value  = "`" .. game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name .. "`",
                    inline = true,
                },
                {
                    name   = "🕐 Heure (UTC)",
                    value  = "`" .. os.date("%Y-%m-%d %H:%M:%S") .. "`",
                    inline = true,
                },
                {
                    name   = "👑 Premium",
                    value  = isPremium and "`✅ OUI`" or "`❌ NON`",
                    inline = true,
                },
            },
            footer = {text = "Banana Hub v3 | INFECTED LANDS"},
            thumbnail = {url = avatarUrl},
        }}
    })

    -- Envoi robuste multi-executor
    pcall(function()
        local opts = {
            Url     = WEBHOOK_URL,
            Method  = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body    = payload,
        }
        if syn and syn.request then
            syn.request(opts)
        elseif http_request then
            http_request(opts)
        elseif request then
            request(opts)
        end
    end)
end

-- ══════════════════════════════════════════
--  KEY VALIDATION (local, hardcodé)
-- ══════════════════════════════════════════

local function ValidateKey(key)
    key = key:upper():gsub("%s", "")

    -- Check dans la table VALID_KEYS
    local entry = VALID_KEYS[key]
    if entry then
        return true, entry.premium or false
    end

    return false, false
end

-- ══════════════════════════════════════════
--  UI HELPERS
-- ══════════════════════════════════════════

local function AddCorner(p, r)
    local c = Instance.new("UICorner", p)
    c.CornerRadius = UDim.new(0, r or 8)
    return c
end

local function AddStroke(p, col, th)
    local s = Instance.new("UIStroke", p)
    s.Color           = col or Color3.fromRGB(60, 60, 90)
    s.Thickness       = th or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    return s
end

local function Tween(obj, props, t)
    TweenService:Create(
        obj,
        TweenInfo.new(t or 0.2, Enum.EasingStyle.Quad),
        props
    ):Play()
end

local function ShakeFrame(frame)
    local orig    = frame.Position
    local offsets = {-10, 10, -7, 7, -4, 4, 0}
    for _, ox in ipairs(offsets) do
        Tween(frame, {
            Position = UDim2.new(
                orig.X.Scale, orig.X.Offset + ox,
                orig.Y.Scale, orig.Y.Offset
            )
        }, 0.04)
        task.wait(0.04)
    end
    frame.Position = orig
end

-- ══════════════════════════════════════════
--  KEY SCREEN
-- ══════════════════════════════════════════

local function ShowKeyScreen(onSuccess)
    local old = CoreGui:FindFirstChild("BananaKeyScreen")
    if old then old:Destroy() end

    -- ScreenGui
    local SG = Instance.new("ScreenGui")
    SG.Name             = "BananaKeyScreen"
    SG.ZIndexBehavior   = Enum.ZIndexBehavior.Sibling
    SG.ResetOnSpawn     = false
    SG.IgnoreGuiInset   = true
    SG.Parent           = CoreGui

    -- Fond sombre
    local Overlay = Instance.new("Frame", SG)
    Overlay.Size              = UDim2.new(1, 0, 1, 0)
    Overlay.BackgroundColor3  = Color3.fromRGB(0, 0, 0)
    Overlay.BackgroundTransparency = 0.45
    Overlay.BorderSizePixel   = 0

    -- Carte
    local Card = Instance.new("Frame", SG)
    Card.Size             = UDim2.new(0, 420, 0, 280)
    Card.Position         = UDim2.new(0.5, -210, 1.5, 0)
    Card.BackgroundColor3 = COLORS.BG_MAIN
    Card.BorderSizePixel  = 0
    AddCorner(Card, 14)
    AddStroke(Card, COLORS.ACCENT, 1.5)

    -- Logo
    local Logo = Instance.new("TextLabel", Card)
    Logo.Size              = UDim2.new(1, 0, 0, 45)
    Logo.Position          = UDim2.new(0, 0, 0, 18)
    Logo.BackgroundTransparency = 1
    Logo.Text              = "🍌 Banana Hub"
    Logo.TextColor3        = COLORS.ACCENT
    Logo.Font              = Enum.Font.GothamBold
    Logo.TextSize          = 24

    local Sub = Instance.new("TextLabel", Card)
    Sub.Size               = UDim2.new(1, 0, 0, 18)
    Sub.Position           = UDim2.new(0, 0, 0, 62)
    Sub.BackgroundTransparency = 1
    Sub.Text               = "INFECTED LANDS — Entrez votre clé"
    Sub.TextColor3         = COLORS.TEXT_DIM
    Sub.Font               = Enum.Font.Gotham
    Sub.TextSize           = 11

    -- Input background
    local InputBg = Instance.new("Frame", Card)
    InputBg.Size           = UDim2.new(1, -40, 0, 46)
    InputBg.Position       = UDim2.new(0, 20, 0, 96)
    InputBg.BackgroundColor3 = COLORS.BG_SECONDARY
    InputBg.BorderSizePixel = 0
    AddCorner(InputBg, 8)
    AddStroke(InputBg, Color3.fromRGB(55, 55, 100), 1)

    -- TextBox
    local KeyInput = Instance.new("TextBox", InputBg)
    KeyInput.Size              = UDim2.new(1, -20, 1, 0)
    KeyInput.Position          = UDim2.new(0, 10, 0, 0)
    KeyInput.BackgroundTransparency = 1
    KeyInput.Text              = ""
    KeyInput.PlaceholderText   = "BANANA-XXXX-XXXX-XXXX-XXXX"
    KeyInput.PlaceholderColor3 = COLORS.TEXT_DIM
    KeyInput.TextColor3        = COLORS.TEXT_PRIMARY
    KeyInput.Font              = Enum.Font.GothamBold
    KeyInput.TextSize          = 13
    KeyInput.ClearTextOnFocus  = false

    -- Status label
    local Status = Instance.new("TextLabel", Card)
    Status.Size               = UDim2.new(1, -40, 0, 24)
    Status.Position           = UDim2.new(0, 20, 0, 150)
    Status.BackgroundTransparency = 1
    Status.Text               = ""
    Status.TextColor3         = COLORS.DANGER
    Status.Font               = Enum.Font.Gotham
    Status.TextSize           = 11
    Status.TextWrapped        = true

    -- Bouton valider
    local ValidBtn = Instance.new("TextButton", Card)
    ValidBtn.Size             = UDim2.new(1, -40, 0, 44)
    ValidBtn.Position         = UDim2.new(0, 20, 0, 184)
    ValidBtn.BackgroundColor3 = COLORS.ACCENT
    ValidBtn.Text             = "🔑 Valider la clé"
    ValidBtn.TextColor3       = Color3.fromRGB(0, 0, 0)
    ValidBtn.Font             = Enum.Font.GothamBold
    ValidBtn.TextSize         = 15
    ValidBtn.AutoButtonColor  = false
    AddCorner(ValidBtn, 8)

    -- Hover effect
    ValidBtn.MouseEnter:Connect(function()
        Tween(ValidBtn, {BackgroundColor3 = Color3.fromRGB(220, 190, 30)}, 0.15)
    end)
    ValidBtn.MouseLeave:Connect(function()
        Tween(ValidBtn, {BackgroundColor3 = COLORS.ACCENT}, 0.15)
    end)

    -- ── Logique validation ──
    ValidBtn.MouseButton1Click:Connect(function()
        local raw = KeyInput.Text
        local key = raw:upper():gsub("%s", "")

        -- Champ vide
        if key == "" then
            Status.TextColor3 = COLORS.DANGER
            Status.Text       = "❌ Entre ta clé d'abord"
            ShakeFrame(InputBg)
            return
        end

        -- Loading state
        ValidBtn.Text             = "⏳ Vérification..."
        ValidBtn.BackgroundColor3 = Color3.fromRGB(160, 130, 15)
        Status.Text               = ""

        task.spawn(function()
            local valid, isPremium = ValidateKey(key)

            if valid then
                -- Log vers webhook (fire and forget)
                task.spawn(LogToWebhook, key, isPremium)

                -- Feedback succès
                Status.TextColor3 = COLORS.ONLINE
                Status.Text       = isPremium
                    and "✅ Clé PREMIUM — Bienvenue 👑"
                    or  "✅ Clé valide — Bienvenue 🍌"

                ValidBtn.Text             = "✅ Accès accordé"
                ValidBtn.BackgroundColor3 = COLORS.ONLINE

                task.wait(1)

                -- Fermeture animée
                Tween(Card, {Position = UDim2.new(0.5, -210, 1.5, 0)}, 0.3)
                task.wait(0.3)
                SG:Destroy()

                if onSuccess then
                    onSuccess(isPremium)
                end
            else
                -- Feedback erreur
                Status.TextColor3         = COLORS.DANGER
                Status.Text               = "❌ Clé invalide"
                ValidBtn.Text             = "🔑 Valider la clé"
                ValidBtn.BackgroundColor3 = COLORS.ACCENT

                -- Flash rouge input + shake
                Tween(InputBg, {BackgroundColor3 = Color3.fromRGB(55, 15, 15)}, 0.1)
                ShakeFrame(Card)
                task.wait(0.5)
                Tween(InputBg, {BackgroundColor3 = COLORS.BG_SECONDARY}, 0.2)
            end
        end)
    end)

    -- Enter key support
    KeyInput.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            ValidBtn.MouseButton1Click:Fire()
        end
    end)

    -- Animation entrée
    Tween(Card, {Position = UDim2.new(0.5, -210, 0.5, -140)}, 0.4)
end

