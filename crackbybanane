local FOVCircle = Drawing.new("Circle")
FOVCircle.Visible=false; FOVCircle.Color=T.Yellow; FOVCircle.Thickness=1.5; FOVCircle.Filled=false; FOVCircle.NumSides=64

local _cachedTarget = nil
local silentHooked  = false

local function hookSilentAim()
    if silentHooked then return end; silentHooked = true
    pcall(function()
        local mt = getrawmetatable(Mouse)
        if not mt then return end
        local oldIdx = mt.__index
        setreadonly(mt, false)
        mt.__index = newcclosure(function(t, k)
            if S.Aimbot.On and S.Aimbot.Silent and _cachedTarget then
                if k=="Hit"     then return CFrame.new(_cachedTarget.pos) end
                if k=="Target"  then return _cachedTarget.part end
                if k=="UnitRay" then
                    local o=Camera.CFrame.Position; local d=(_cachedTarget.pos-o).Unit
                    return Ray.new(o, d*1000)
                end
            end
            return oldIdx(t, k)
        end)
        setreadonly(mt, true)
    end)
end

local function tickAimbot()
    local sc=Camera.ViewportSize; local ctr=Vector2.new(sc.X/2,sc.Y/2)
    FOVCircle.Visible=S.Aimbot.ShowFOV and S.Aimbot.On; FOVCircle.Radius=S.Aimbot.FOV/2; FOVCircle.Position=ctr
    if not S.Aimbot.On or S.Aimbot.Silent then return end
    if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
    local tgt=_cachedTarget; if not tgt then return end
    local delta=tgt.screen-ctr; if delta.Magnitude<1 then return end
    local smooth=math.clamp(S.Aimbot.Smooth,0.01,0.98); local stepped=delta*(1-smooth)
    local ray=Camera:ScreenPointToRay(ctr.X+stepped.X,ctr.Y+stepped.Y); local cf=Camera.CFrame
    Camera.CFrame=CFrame.new(cf.Position,cf.Position+ray.Direction*500)
end

