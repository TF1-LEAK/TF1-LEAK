function Movement:EnableFreecam()
    self.FreecamEnabled = true
    self.OriginalCamType = Camera.CameraType
    Camera.CameraType = Enum.CameraType.Scriptable
    
    local keys = {}
    local inputStart = UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        keys[input.KeyCode] = true
    end)
    local inputEnd = UserInputService.InputEnded:Connect(function(input)
        keys[input.KeyCode] = false
    end)
    
    self.FreecamCFrame = Camera.CFrame
    
    self.FreecamConn = RunService.RenderStepped:Connect(function(dt)
        if not self.FreecamEnabled then return end
        
        local spd   = self.FreecamSpeed
        local move  = Vector3.new()
        
        if keys[Enum.KeyCode.W] then move = move + Vector3.new(0,0,-1) end
        if keys[Enum.KeyCode.S] then move = move + Vector3.new(0,0,1) end
        if keys[Enum.KeyCode.A] then move = move + Vector3.new(-1,0,0) end
        if keys[Enum.KeyCode.D] then move = move + Vector3.new(1,0,0) end
        if keys[Enum.KeyCode.E] then move = move + Vector3.new(0,1,0) end
        if keys[Enum.KeyCode.Q] then move = move + Vector3.new(0,-1,0) end
        if keys[Enum.KeyCode.LeftShift] then spd = spd * 3 end
        
        self.FreecamCFrame = self.FreecamCFrame * CFrame.new(move * spd * dt * 60)
        
        -- Rotation souris
        local mouseDelta = UserInputService:GetMouseDelta()
        local rotX = CFrame.Angles(-mouseDelta.Y * 0.003, 0, 0)
        local rotY = CFrame.Angles(0, -mouseDelta.X * 0.003, 0)
        
        self.FreecamCFrame = CFrame.new(self.FreecamCFrame.Position) 
            * rotY 
            * CFrame.Angles(
                math.asin(self.FreecamCFrame.LookVector.Y * -1) - mouseDelta.Y * 0.003,
                math.atan2(-self.FreecamCFrame.LookVector.X, -self.FreecamCFrame.LookVector.Z) - mouseDelta.X * 0.003,
                0
            )
        
        Camera.CFrame = self.FreecamCFrame
    end)
end

function Movement:DisableFreecam()
    self.FreecamEnabled = false
    if self.FreecamConn then self.FreecamConn:Disconnect() end
    if self.OriginalCamType then
        Camera.CameraType = self.OriginalCamType
    end
end

function Movement:TeleportToPlayer(targetPlayer)
    local char    = LocalPlayer.Character
    local tChar   = targetPlayer.Character
    if not char or not tChar then return end
    
    local hrp  = char:FindFirstChild("HumanoidRootPart")
    local thrp = tChar:FindFirstChild("HumanoidRootPart")
    if not hrp or not thrp then return end
    
    -- Teleport furtif via AntiCheat stealth
    if AntiCheat.TeleportStealth then
        AntiCheat.TeleportStealth(thrp.Position + Vector3.new(2, 0, 2))
    else
        hrp.CFrame = thrp.CFrame + Vector3.new(2, 0, 2)
    end
end

function Movement:TeleportCity(cityName)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp  = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    for _, city in ipairs(CONFIG.CITIES) do
        if city.Name == cityName then
            hrp.CFrame = CFrame.new(city.Position)
            return
        end
    end
end

