-- FIX v4.2 — safeOpenWindow
-- ══════════════════════════════════════
--[[
    POURQUOI task.wait(0.1) ne suffisait pas:

    Sur KRNL/Arceus X/Hydrogen, le scheduler Lua tourne dans un thread
    séparé du thread Roblox DataModel. Quand on fait:
        sg.Parent = CoreGui  ← write dans le DM
        task.wait(0.1)       ← yield 100ms dans le scheduler Lua
        Spring(win, Size=460) ← TweenService:Create() dans le DM

    Le problème: task.wait(0.1) yield le SCHEDULER, pas le DataModel.
    Le DataModel peut prendre plus de 100ms pour "adopter" le ScreenGui
    (propager les changements à travers la hiérarchie).
    TweenService:Create() reçoit le Frame avant que Window.AbsoluteSize
    soit calculé → tween ignoré silencieusement (Roblox engine bug/feature)
    → Size.Y reste 0 → ClipsDescendants cache tout.

    FIX: on poll AbsoluteSize.Y jusqu'à ce qu'il soit calculable,
    ET on fait un hard-set Size à 1px d'abord pour forcer le layout engine
    à "connaître" la frame, PUIS on Spring vers la taille finale.
    Fallback à 2s: force hard-set si Spring a encore drop.
]]

-- *safeOpenWindow — attend que le layout engine connaisse la frame
--  avant de lancer le spring, sinon ClipsDescendants mange tout* 😏
local function safeOpenWindow(win, targetW, targetH, centeredY)
    task.spawn(function()
        if not win then return end

        -- ── ÉTAPE 1: hard-set à 1px pour forcer adoption DataModel ──
        -- Cette ligne force le layout engine à calculer AbsoluteSize
        -- sur la frame. Sans ça, AbsoluteSize reste {0,0} même après
        -- que le ScreenGui soit dans CoreGui.
        win.Size = UDim2.new(0, targetW, 0, 1)

        -- ── ÉTAPE 2: poll jusqu'à adoption confirmée ──
        -- On check AbsoluteSize.X > 0 (pas Y, car Y=1 depuis notre hard-set)
        -- pour confirmer que le parent chain est complet dans le DM.
        local waited = 0
        repeat
            task.wait(0.05)
            waited = waited + 0.05
        until (win and win.Parent and win.AbsoluteSize.X > 0) or waited > 6

        if not (win and win.Parent) then return end

        -- ── ÉTAPE 3: set position maintenant qu'on est dans le DM ──
        local halfH = math.floor(targetH / 2)
        local halfW = math.floor(targetW / 2)
        win.Position = UDim2.new(0.5, -halfW, 0.5, -halfH)

        task.wait(0.03)  -- 1 frame buffer

        -- ── ÉTAPE 4: Spring vers taille finale ──
        -- AbsoluteSize est maintenant connu → TweenService ne drop pas
        Spring(win, {
            Size     = UDim2.new(0, targetW, 0, targetH),
            Position = UDim2.new(0.5, -halfW, 0.5, -halfH),
        }, 0.5)

        -- ── ÉTAPE 5: fallback hard-set si Spring a drop ──
        -- Sur les executors les plus lents, le Spring peut encore
        -- drop si le scheduler Lua yield trop longtemps.
        -- On vérifie après 2s que la taille est bien atteinte.
        task.delay(2, function()
            if not (win and win.Parent) then return end
            local sz = win.AbsoluteSize
            if sz.Y < targetH - 10 then
                -- Spring n'a pas atteint la target → force hard-set
                warn("[🍌 v4.2] Spring drop détecté → hard-set fallback")
                win.Size     = UDim2.new(0, targetW, 0, targetH)
                win.Position = UDim2.new(0.5, -halfW, 0.5, -halfH)
            end
        end)
    end)
end

