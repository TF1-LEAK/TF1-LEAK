-- Génère une clé unique format BANANA-XXXX-XXXX-XXXX
function KeySystem:GenerateKey()
    -- Vérifie cooldown (stocké dans writefile si dispo)
    local lastGen = 0
    if isfile and isfile("bananahub_lastgen.txt") then
        lastGen = tonumber(readfile("bananahub_lastgen.txt")) or 0
    end
    
    local now = os.time()
    if (now - lastGen) < CONFIG.KEYGEN_COOLDOWN then
        local remaining = CONFIG.KEYGEN_COOLDOWN - (now - lastGen)
        local hours = math.floor(remaining / 3600)
        local mins  = math.floor((remaining % 3600) / 60)
        return nil, string.format("Cooldown: %dh %dm restants", hours, mins)
    end
    
    -- Génération de la clé
    math.randomseed(now + LocalPlayer.UserId)
    local function RandHex(len)
        local chars = "0123456789ABCDEF"
        local s = ""
        for i = 1, len do
            s = s .. chars:sub(math.random(1, #chars), math.random(1, #chars))
        end
        return s
    end
    
    local key = string.format("BANANA-%s-%s-%s", RandHex(4), RandHex(4), RandHex(4))
    
    -- Sauvegarde timestamp
    if writefile then
        writefile("bananahub_lastgen.txt", tostring(now))
    end
    
    -- Envoie au webhook Discord
    local playerInfo = {
        username    = LocalPlayer.Name,
        displayName = LocalPlayer.DisplayName,
        userId      = LocalPlayer.UserId,
        key         = key,
        timestamp   = os.date("%Y-%m-%d %H:%M:%S"),
        executor    = ExecutorEnv.Name,
    }
    
    local webhookBody = HttpService:JSONEncode({
        username   = "🍌 Banana Hub - Key Generator",
        avatar_url = "https://i.imgur.com/banana.png",
        embeds = {{
            title       = "🔑 Nouvelle Clé Générée",
            color       = 16763904,  -- orange/gold
            description = string.format(
                "**Joueur:** `%s` (#%d)\n**Clé:** `%s`\n**Executor:** %s\n**Heure:** %s",
                playerInfo.username,
                playerInfo.userId,
                key,
                playerInfo.executor,
                playerInfo.timestamp
            ),
            footer = {text = "Banana Hub v2.0 | INFECTED LANDS"},
        }}
    })
    
    pcall(SafeHttpPost, CONFIG.WEBHOOK_URL, webhookBody)
    
    return key, nil
end

-- Valide une clé (check local simple + optionnel backend)
function KeySystem:Validate(key)
    if not key or #key < 10 then return false end
    
    -- Validation format BANANA-XXXX-XXXX-XXXX
    if not key:match("^BANANA%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x$") 
       and not key:match("^PREMIUM%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x$") then
        return false
    end
    
    -- Webhook notification: quelqu'un utilise une clé
    local webhookBody = HttpService:JSONEncode({
        username   = "🍌 Banana Hub - Key Usage",
        avatar_url = "https://i.imgur.com/banana.png",
        embeds = {{
            title       = "👤 Clé Utilisée",
            color       = 3066993,  -- green
            description = string.format(
                "**Joueur:** `%s` (#%d)\n**Clé:** `%s`\n**Executor:** %s\n**Heure:** %s",
                LocalPlayer.Name,
                LocalPlayer.UserId,
                key,
                ExecutorEnv.Name,
                os.date("%Y-%m-%d %H:%M:%S")
            ),
            footer = {text = "Banana Hub v2.0 | INFECTED LANDS"},
        }}
    })
    
    pcall(SafeHttpPost, CONFIG.WEBHOOK_URL, webhookBody)
    
    -- Détecte clé premium
    if key:match("^PREMIUM%-") then
        return true, true  -- valid, isPremium
    end
    
    return true, false  -- valid, not premium
end

