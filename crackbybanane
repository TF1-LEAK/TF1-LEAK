local function AddCorner(p, r)
    local c = Instance.new("UICorner", p)
    c.CornerRadius = UDim.new(0, r or 8)
end

local function AddStroke(p, col, th)
    local s = Instance.new("UIStroke", p)
    s.Color     = col or Color3.fromRGB(60,60,90)
    s.Thickness = th or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
end

local function Tween(obj, props, t)
    TweenService:Create(obj, TweenInfo.new(t or 0.2, Enum.EasingStyle.Quad), props):Play()
end

-- Shake animation (feedback erreur)
local function ShakeFrame(frame)
    local orig = frame.Position
    local offsets = {-12, 12, -8, 8, -4, 4, 0}
    for _, ox in ipairs(offsets) do
        Tween(frame, {Position = UDim2.new(orig.X.Scale, orig.X.Offset + ox, orig.Y.Scale, orig.Y.Offset)}, 0.04)
        task.wait(0.04)
    end
    frame.Position = orig
end

