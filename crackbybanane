function AntiCheat:Bypass()
    -- Hook FireServer pour filtrer les events suspects
    local OldFireServer = Instance.new("RemoteEvent").FireServer
    
    -- Patch le namecall pour intercepter FireServer/InvokeServer
    local mt = SafeGetRawMetatable(game)
    SafeSetReadonly(mt, false)
    
    local OldNamecall = mt.__namecall
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args   = {...}
        
        -- Filtre les events d'anti-cheat connus d'Infected Lands
        if method == "FireServer" or method == "InvokeServer" then
            local remoteName = ""
            if self and self.Name then remoteName = self.Name end
            
            -- Bloque les remotes de détection de speed/position
            local blocked = {
                "AntiCheat", "SpeedCheck", "PositionCheck", 
                "FlyDetect", "NoclipDetect", "ReportPlayer",
                "ValidateMovement", "SanityCheck"
            }
            for _, b in ipairs(blocked) do
                if remoteName:lower():find(b:lower()) then
                    return  -- DROP le fire silencieusement
                end
            end
        end
        
        return OldNamecall(self, ...)
    end)
    
    SafeSetReadonly(mt, true)
    
    -- Patch anti-teleport: envoie des positions intermédiaires
    self.TeleportStealth = function(targetPos)
        local hrp = LocalPlayer.Character 
                    and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        local startPos = hrp.CFrame
        local steps    = 10
        
        for i = 1, steps do
            local alpha = i / steps
            hrp.CFrame = startPos:Lerp(CFrame.new(targetPos), alpha)
            task.wait(0.02)
        end
    end
    
    -- Désactive les scripts d'anti-cheat côté LocalScript si accessibles
    for _, obj in ipairs(LocalPlayer.PlayerScripts:GetDescendants()) do
        if obj:IsA("LocalScript") and 
           (obj.Name:lower():find("anti") or obj.Name:lower():find("detect")) then
            obj.Disabled = true
        end
    end
end

