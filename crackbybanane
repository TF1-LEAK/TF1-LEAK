-- ══════════════════════════════════════
-- MAIN RENDER LOOP
-- ══════════════════════════════════════
local function startLoop()
    initBypass()
    hookSilentAim()

    -- Update cible aimbot à chaque Heartbeat (thread dédié)
    RunService.Heartbeat:Connect(function()
        if S.Aimbot.On then
            -- Update cached target (sync, dans le même thread Heartbeat)
            local sc  = Camera.ViewportSize
            local ctr = Vector2.new(sc.X / 2, sc.Y / 2)
            local best, bestDist = nil, math.huge

            for _, p in ipairs(Players:GetPlayers()) do
                if p == LP then continue end
                if S.Aimbot.TeamCheck and p.Team == LP.Team then continue end
                local char = p.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum  = char and char:FindFirstChildOfClass("Humanoid")
                if not root or not hum or hum.Health <= 0 then continue end

                local part = char:FindFirstChild(S.Aimbot.HitPart) or root
                local pos  = part.Position
                if S.Aimbot.Predict then
                    pos = pos + root.AssemblyLinearVelocity * S.Aimbot.PredFactor
                end

                local sp, on, depth = Camera:WorldToViewportPoint(pos)
                if not on or sp.Z <= 0 then continue end

                local sp2 = Vector2.new(sp.X, sp.Y)
                local d   = (sp2 - ctr).Magnitude

                if d < (S.Aimbot.FOV / 2) and d < bestDist then
                    bestDist = d
                    best = { pos=pos, part=part, player=p, screen=sp2 }
                end
            end
            _cachedTarget = best
        else
            _cachedTarget = nil
        end
    end)

    -- RenderStepped: rendu ESP + aimbot cam + freecam
    RunService.RenderStepped:Connect(function(dt)
        -- ESP
        if S.ESP.On then
            tickESP()
        else
            for _, esp in pairs(ESPCache) do hideESP(esp) end
        end

        -- FOV circle + aimbot cam
        tickAimbot()

        -- FreeCam
        if S.FreeCam.On then
            tickFreeCam(dt)
        end
    end)

    -- Cleanup au départ d'un joueur
    Players.PlayerRemoving:Connect(function(p)
        task.wait(0.1)
        removeESP(p)
    end)
end

