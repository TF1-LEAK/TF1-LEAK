-- BUBBLE BACKGROUND AMBIENT
-- Génère des bulles qui montent en continu dans le fond de la fenêtre
-- ─────────────────────────────────────
local function startAmbientBubbles(container)
    task.spawn(function()
        -- Attend que le container soit réellement rendu (AbsoluteSize non-zero)
        local waited = 0
        while container and container.AbsoluteSize.X == 0 do
            task.wait(0.05)
            waited = waited + 0.05
            if waited > 5 then return end  -- timeout safety
        end
        while container and container.Parent do
            task.wait(math.random(15, 35) / 10)
            if not (container and container.Parent) then break end
            local as = container.AbsoluteSize
            if as.X == 0 then continue end  -- skip si pas encore rendu
            local x  = math.random(10, math.max(math.floor(as.X) - 10, 11))
            local y  = as.Y + 10
            local s  = math.random(4, 12)
            local dur= math.random(18, 35) / 10

            local b = New("Frame", {
                BackgroundColor3     = T.Yellow,
                BackgroundTransparency = 0.7,
                Size                 = UDim2.new(0, s, 0, s),
                Position             = UDim2.new(0, x, 1, s),
                BorderSizePixel      = 0,
                ZIndex               = 1,
            }, container)
            Corner(999, b)

            -- Monte lentement
            Tween(b, {
                Position             = UDim2.new(0, x + math.random(-15, 15), 0, -s - 5),
                BackgroundTransparency = 1,
                Size                 = UDim2.new(0, s * 0.3, 0, s * 0.3),
            }, dur, Enum.EasingStyle.Linear)

            task.delay(dur + 0.1, function()
                if b and b.Parent then b:Destroy() end
            end)
        end
    end)
end

