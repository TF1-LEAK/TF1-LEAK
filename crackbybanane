-- AIMBOT ENGINE — FIXED SILENT AIM
-- ══════════════════════════════════════
--[[
  SILENT AIM FIX:
    L'ancien hook __index sur Mouse était fragile car Roblox peut rebuild
    l'objet Mouse. On utilise maintenant une double approche:
      1. Hook __index sur le rawmetatable de Mouse (lecture de Hit/Target)
      2. Hook __namecall pour intercepter FireServer et injecter la pos
    Le getBestTarget() est appelé une seule fois par frame (cached).
]]

local FOVCircle = Drawing.new("Circle")
FOVCircle.Visible   = false
FOVCircle.Color     = T.Yellow
FOVCircle.Thickness = 1.5
FOVCircle.Filled    = false
FOVCircle.NumSides  = 64

-- Cache cible pour éviter double calcul entre silent aim et normal aim
local _cachedTarget = nil
local _cacheFrame   = 0

local function getBestTarget()
    -- *pas de yield ici — fonction pure, appelée depuis Heartbeat uniquement*

    local sc   = Camera.ViewportSize
    local ctr  = Vector2.new(sc.X / 2, sc.Y / 2)
    local best, bestDist = nil, math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if S.Aimbot.TeamCheck and p.Team == LP.Team then continue end

        local char = p.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 then continue end

        local part = char:FindFirstChild(S.Aimbot.HitPart) or root
        local pos  = part.Position

        -- Prédiction de mouvement
        if S.Aimbot.Predict then
            local vel = root.AssemblyLinearVelocity
            pos = pos + vel * S.Aimbot.PredFactor
        end

        -- Projection correcte (même fix que ESP)
        local sp, onScreen, depth = Camera:WorldToViewportPoint(pos)
        if not onScreen or sp.Z <= 0 then continue end

        local sp2 = Vector2.new(sp.X, sp.Y)
        local d   = (sp2 - ctr).Magnitude

        if d < (S.Aimbot.FOV / 2) and d < bestDist then
            bestDist = d
            best = {
                pos    = pos,
                part   = part,
                player = p,
                screen = sp2,
            }
        end
    end

    _cachedTarget = best
    return best
end

-- ── Hook Silent Aim via Mouse metatable ──
local silentHooked = false

local function hookSilentAim()
    if silentHooked then return end
    silentHooked = true

    pcall(function()
        local mt = getrawmetatable(Mouse)
        if not mt then return end

        local oldIdx = mt.__index
        setreadonly(mt, false)

        mt.__index = newcclosure(function(t, k)
            if S.Aimbot.On and S.Aimbot.Silent and _cachedTarget then
                if k == "Hit" then
                    -- Retourne un CFrame pointant vers la cible
                    return CFrame.new(_cachedTarget.pos)
                end
                if k == "Target" then
                    -- Retourne la BasePart de la cible
                    return _cachedTarget.part
                end
                if k == "UnitRay" then
                    -- Ray depuis cam vers la cible pour les jeux qui utilisent UnitRay
                    local origin = Camera.CFrame.Position
                    local dir    = (_cachedTarget.pos - origin).Unit
                    return Ray.new(origin, dir * 1000)
                end
            end
            return oldIdx(t, k)
        end)

        setreadonly(mt, true)
    end)
end

local function tickAimbot()
    local sc  = Camera.ViewportSize
    local ctr = Vector2.new(sc.X / 2, sc.Y / 2)

    -- Update FOV circle
    FOVCircle.Visible  = S.Aimbot.ShowFOV and S.Aimbot.On
    FOVCircle.Radius   = S.Aimbot.FOV / 2
    FOVCircle.Position = ctr

    -- _cachedTarget est déjà mis à jour par le Heartbeat loop — rien à faire ici

    -- Aimbot normal (RMB)
    if not S.Aimbot.On or S.Aimbot.Silent then return end
    if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end

    local tgt = _cachedTarget
    if not tgt then return end

    local sp    = tgt.screen
    local delta = sp - ctr

    if delta.Magnitude < 1 then return end

    local smooth  = math.clamp(S.Aimbot.Smooth, 0.01, 0.98)
    local stepped = delta * (1 - smooth)

    -- Rotation caméra vers la cible
    local ray = Camera:ScreenPointToRay(ctr.X + stepped.X, ctr.Y + stepped.Y)
    local cf  = Camera.CFrame
    Camera.CFrame = CFrame.new(cf.Position, cf.Position + ray.Direction * 500)
end

