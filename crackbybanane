-- Toggle animé avec spring knob
local function MakeToggle(parent, label, default, cb)
    local state = default or false

    local frame = New("Frame", {
        BackgroundColor3 = T.BG3,
        Size             = UDim2.new(1, 0, 0, 36),
        BorderSizePixel  = 0,
    }, parent)
    Corner(10, frame)
    local fStroke = Stroke(T.Border, 1, frame)

    New("TextLabel", {
        Text               = label,
        TextColor3         = T.Text,
        Font               = Enum.Font.GothamMedium,
        TextSize           = 13,
        BackgroundTransparency = 1,
        Size               = UDim2.new(1, -68, 1, 0),
        Position           = UDim2.new(0, 12, 0, 0),
        TextXAlignment     = Enum.TextXAlignment.Left,
    }, frame)

    local track = New("Frame", {
        Size             = UDim2.new(0, 46, 0, 24),
        Position         = UDim2.new(1, -56, 0.5, -12),
        BackgroundColor3 = state and T.Yellow or T.BG2,
        BorderSizePixel  = 0,
    }, frame)
    Corner(12, track)

    local knob = New("Frame", {
        Size             = UDim2.new(0, 20, 0, 20),
        Position         = state
            and UDim2.new(1, -22, 0.5, -10)
            or  UDim2.new(0,  2,  0.5, -10),
        BackgroundColor3 = T.White,
        BorderSizePixel  = 0,
    }, track)
    Corner(10, knob)

    local function refresh(v)
        -- Couleur track avec spring
        Spring(track, {BackgroundColor3 = v and T.Yellow or T.BG2})
        -- Knob spring vers la position
        Spring(knob, {
            Position         = v
                and UDim2.new(1, -22, 0.5, -10)
                or  UDim2.new(0,  2,  0.5, -10),
            BackgroundColor3 = v and T.BG or T.White,
        }, 0.3)
        -- Stroke frame
        Tween(fStroke, {Color = v and T.YellowDim or T.Border})
        -- Glow si activé
        if v then
            GlowPulse(fStroke, T.Yellow, 0.4)
        end
    end

    local btn = New("TextButton", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Text = "",
    }, frame)

    btn.MouseButton1Click:Connect(function()
        state = not state
        refresh(state)

        -- Ripple + bubbles
        local mp = UserInputService:GetMouseLocation()
        task.spawn(function() Ripple(frame, mp.X, mp.Y) end)
        if state then
            task.spawn(function() BubbleBurst(frame, 5) end)
        end

        if cb then cb(state) end
    end)

    -- Hover
    btn.MouseEnter:Connect(function()
        Tween(frame, {BackgroundColor3 = T.BG4})
    end)
    btn.MouseLeave:Connect(function()
        Tween(frame, {BackgroundColor3 = T.BG3})
    end)

    return frame,
        function() return state end,
        function(v) state = v; refresh(v) end
end

