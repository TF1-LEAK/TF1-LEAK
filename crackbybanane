local KeySystem = {}

-- Génère une clé unique et l'envoie UNIQUEMENT au webhook
-- Rien n'est affiché/copié côté jeu
function KeySystem:GenerateKey()
    -- Check cooldown
    local lastGen = 0
    if isfile and isfile("bananahub_lastgen.txt") then
        lastGen = tonumber(readfile("bananahub_lastgen.txt")) or 0
    end

    local now = os.time()
    if (now - lastGen) < CONFIG.KEYGEN_COOLDOWN then
        local remaining = CONFIG.KEYGEN_COOLDOWN - (now - lastGen)
        local h = math.floor(remaining / 3600)
        local m = math.floor((remaining % 3600) / 60)
        return false, string.format("Cooldown actif: encore %dh %dm", h, m)
    end

    -- Génération clé
    math.randomseed(now + LocalPlayer.UserId + math.random(1000, 9999))

    local function RandSeg()
        local hex = "0123456789ABCDEF"
        local s = ""
        for i = 1, 4 do
            local r = math.random(1, #hex)
            s = s .. hex:sub(r, r)
        end
        return s
    end

    local key = string.format("BANANA-%s-%s-%s-%s",
        RandSeg(), RandSeg(), RandSeg(), RandSeg()
    )

    -- Sauvegarde cooldown
    if writefile then
        writefile("bananahub_lastgen.txt", tostring(now))
    end

    -- Envoie la clé AU WEBHOOK UNIQUEMENT
    -- Toi seul vois la clé dans Discord, tu la donnes manuellement aux users
    local webhookBody = HttpService:JSONEncode({
        username   = "🍌 Banana Hub — Key Generator",
        embeds = {{
            title = "🔑 Nouvelle Clé Générée",
            color = 16763904,
            fields = {
                {name = "🔑 Clé",      value = string.format("`%s`", key),          inline = false},
                {name = "👤 Générée par", value = string.format("`%s` (#%d)", LocalPlayer.Name, LocalPlayer.UserId), inline = true},
                {name = "🕐 Heure",    value = os.date("%Y-%m-%d %H:%M:%S"),        inline = true},
            },
            description = "**Ajoute cette clé à ta whitelist puis donne-la manuellement.**",
            footer = {text = "Banana Hub v3 | INFECTED LANDS — Clé valable 24h"},
        }}
    })

    local sent = HttpPost(CONFIG.WEBHOOK_URL, webhookBody)

    if sent then
        return true, nil  -- succès, clé envoyée au webhook
    else
        return false, "Erreur réseau — webhook non atteint"
    end
end

-- Valide une clé via ton endpoint HTTP
-- Ton serveur compare avec la whitelist et retourne JSON
function KeySystem:Validate(key)
    if not key or key == "" then
        return false, false, "Clé vide"
    end

    -- Validation format basique avant d'envoyer la requête
    -- Format: BANANA-XXXX-XXXX-XXXX-XXXX  (4 segments)
    if not key:match("^[A-Z]+-[A-F0-9]+-[A-F0-9]+-[A-F0-9]+-[A-F0-9]+$") then
        return false, false, "Format invalide (BANANA-XXXX-XXXX-XXXX-XXXX)"
    end

    -- Requête vers ton backend
    local url = CONFIG.VALIDATE_URL .. "?key=" .. key
    local body = HttpGet(url)

    if not body then
        return false, false, "Impossible de joindre le serveur de validation"
    end

    -- Parse JSON retourné par le serveur
    -- Ton serveur doit retourner: {"valid": true, "premium": false}
    local ok, data = pcall(function()
        return HttpService:JSONDecode(body)
    end)

    if not ok or not data then
        return false, false, "Réponse serveur invalide"
    end

    if data.valid then
        -- Notifie le webhook qu'une clé vient d'être utilisée
        local usageBody = HttpService:JSONEncode({
            username = "🍌 Banana Hub — Key Usage",
            embeds = {{
                title = "👤 Clé Utilisée",
                color = 3066993,
                fields = {
                    {name = "🔑 Clé",     value = string.format("`%s`", key),   inline = false},
                    {name = "👤 Joueur",  value = string.format("`%s` (#%d)", LocalPlayer.Name, LocalPlayer.UserId), inline = true},
                    {name = "👑 Premium", value = tostring(data.premium or false), inline = true},
                    {name = "🕐 Heure",  value = os.date("%Y-%m-%d %H:%M:%S"),  inline = true},
                },
                footer = {text = "Banana Hub v3 | INFECTED LANDS"},
            }}
        })
        pcall(HttpPost, CONFIG.WEBHOOK_URL, usageBody)

        return true, data.premium or false, nil
    else
        return false, false, data.message or "Clé invalide ou expirée"
    end
end

