local ESPCache = {}

local function getESP(p)
    if not ESPCache[p] then
        local function D(t, props)
            local d = Drawing.new(t)
            for k, v in pairs(props) do d[k] = v end
            return d
        end
        ESPCache[p] = {
            Box    = D("Square", {Visible=false, Color=T.Yellow, Thickness=1.5, Filled=false}),
            BoxFill= D("Square", {Visible=false, Color=T.Yellow, Transparency=0.85, Filled=true}),
            Name   = D("Text",   {Visible=false, Color=T.Yellow, Size=13, Center=true, Outline=true, OutlineColor=Color3.fromRGB(0,0,0)}),
            HP     = D("Text",   {Visible=false, Color=T.Green,  Size=11, Center=true, Outline=true}),
            Dist   = D("Text",   {Visible=false, Color=T.TextDim,Size=11, Center=true, Outline=true}),
            Tracer = D("Line",   {Visible=false, Color=T.Yellow, Thickness=1}),
        }
    end
    return ESPCache[p]
end

local function removeESP(p)
    if ESPCache[p] then
        for _, d in pairs(ESPCache[p]) do d:Remove() end
        ESPCache[p] = nil
    end
end

local function tickESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        local esp  = getESP(p)
        local char = p.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")

        if not root or not hum or hum.Health <= 0 or not S.ESP.On then
            for _, d in pairs(esp) do d.Visible = false end
            continue
        end

        local dist = (Camera.CFrame.Position - root.Position).Magnitude
        if dist > S.ESP.MaxDist then
            for _, d in pairs(esp) do d.Visible = false end
            continue
        end

        local head   = char:FindFirstChild("Head")
        local headP  = head and head.Position or root.Position + Vector3.new(0,2.5,0)
        local feetP  = root.Position - Vector3.new(0,3,0)
        local hSc, hV = Camera:WorldToViewportPoint(headP)
        local fSc, _  = Camera:WorldToViewportPoint(feetP)

        if not hV then
            for _, d in pairs(esp) do d.Visible = false end
            continue
        end

        local H = math.abs(hSc.Y - fSc.Y)
        local W = H * 0.55
        local TL = Vector2.new(hSc.X - W/2, hSc.Y)

        -- Box outline
        esp.Box.Visible  = S.ESP.Box
        esp.Box.Position = TL
        esp.Box.Size     = Vector2.new(W, H)

        -- Box fill (transparent)
        esp.BoxFill.Visible  = S.ESP.Box
        esp.BoxFill.Position = TL
        esp.BoxFill.Size     = Vector2.new(W, H)

        -- Nom
        esp.Name.Visible  = S.ESP.Name
        esp.Name.Text     = p.Name
        esp.Name.Position = Vector2.new(hSc.X, hSc.Y - 18)

        -- HP
        local hp  = math.floor(hum.Health)
        local mhp = math.floor(hum.MaxHealth)
        local ratio = hp / math.max(mhp, 1)
        esp.HP.Visible  = S.ESP.Health
        esp.HP.Text     = hp .. "/" .. mhp
        esp.HP.Color    = Color3.fromRGB(math.floor(255*(1-ratio)), math.floor(255*ratio), 0)
        esp.HP.Position = Vector2.new(hSc.X, fSc.Y + 2)

        -- Distance
        esp.Dist.Visible  = S.ESP.Distance
        esp.Dist.Text     = math.floor(dist) .. "m"
        esp.Dist.Position = Vector2.new(hSc.X, fSc.Y + 14)

        -- Tracer
        if S.ESP.Tracers then
            local sc = Camera.ViewportSize
            esp.Tracer.Visible = true
            esp.Tracer.From    = Vector2.new(sc.X/2, sc.Y)
            esp.Tracer.To      = Vector2.new(fSc.X, fSc.Y)
        else
            esp.Tracer.Visible = false
        end
    end
end

