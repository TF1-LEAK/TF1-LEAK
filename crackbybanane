--              AIMBOT ENGINE
-- ══════════════════════════════════════════════
--[[ *l'aimbot chasse la tête — froid, algorithmique,
      sans la moindre émotion pour la chair qu'il cible* ]]

local AimbotEngine = {}
local FOVCircle = createDrawing("Circle", {
    Visible   = false,
    Color     = Color3.fromRGB(255,255,255),
    Thickness = 1,
    Filled    = false,
    Radius    = Settings.Aimbot.FOV / 2,
})

local function getClosestPlayerInFOV()
    local closest     = nil
    local closestDist = math.huge
    local screenCenter = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LP then continue end
        if Settings.Aimbot.TeamCheck and player.Team == LP.Team then continue end

        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 then continue end

        local target = char:FindFirstChild(Settings.Aimbot.HitPart) or root

        -- Bullet prediction
        local predictedPos = target.Position
        if Settings.Aimbot.PredictBullet then
            local vel = root.Velocity
            predictedPos = target.Position + vel * Settings.Aimbot.PredictionFac
        end

        local screenPos, onScreen = Camera:WorldToViewportPoint(predictedPos)
        if not onScreen then continue end

        local sp2 = Vector2.new(screenPos.X, screenPos.Y)
        local dist = (sp2 - screenCenter).Magnitude

        if dist < (Settings.Aimbot.FOV / 2) and dist < closestDist then
            closestDist = dist
            closest     = { player = player, target = target, predicted = predictedPos }
        end
    end
    return closest
end

-- Silent Aim: hook le raycast de la caméra
local function setupSilentAim()
    -- Remplace la direction du rayon via FireServer si le jeu utilise des RemoteEvents pour les hits
    -- Ici on patch Camera.CFrame au moment du click pour pointer sur la cible
    -- Technique: on override temporairement Mouse.Hit
    local mt = getrawmetatable(Mouse)
    if not mt then return end
    setreadonly(mt, false)
    local oldIndex = mt.__index
    mt.__index = newcclosure(function(t, k)
        if k == "Hit" and Settings.Aimbot.SilentAim and Settings.Aimbot.Enabled then
            local target = getClosestPlayerInFOV()
            if target then
                return CFrame.new(target.predicted)
            end
        end
        if k == "Target" and Settings.Aimbot.SilentAim and Settings.Aimbot.Enabled then
            local target = getClosestPlayerInFOV()
            if target then
                return target.target
            end
        end
        return oldIndex(t, k)
    end)
    setreadonly(mt, true)
end

function AimbotEngine:Update()
    -- FOV circle
    FOVCircle.Visible = Settings.Aimbot.ShowFOV and Settings.Aimbot.Enabled
    FOVCircle.Radius  = Settings.Aimbot.FOV / 2
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

    if not Settings.Aimbot.Enabled or Settings.Aimbot.SilentAim then return end
    if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end

    local result = getClosestPlayerInFOV()
    if not result then return end

    local screenPos = Camera:WorldToViewportPoint(result.predicted)
    local screenCenter = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local targetScreen = Vector2.new(screenPos.X, screenPos.Y)

    local smooth = Settings.Aimbot.Smoothing
    local delta  = (targetScreen - screenCenter) * (1 - smooth)

    -- Move camera via CFrame lerp
    local camCF = Camera.CFrame
    local lookAt = Camera:ScreenPointToRay(
        screenCenter.X + delta.X,
        screenCenter.Y + delta.Y
    )
    Camera.CFrame = CFrame.new(camCF.Position, camCF.Position + lookAt.Direction)
end

function AimbotEngine:Init()
    pcall(setupSilentAim)
end

