-- Slider
local function makeSlider(parent, label, min_, max_, default, onChange)
    local frame = makeInstance("Frame", {
        BackgroundColor3 = Theme.Secondary,
        Size = UDim2.new(1, 0, 0, 50),
        BorderSizePixel = 0,
    }, parent)
    makeInstance("UICorner", {CornerRadius = UDim.new(0,6)}, frame)

    local labelL = makeInstance("TextLabel", {
        Text = label .. ": " .. tostring(default),
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        BackgroundTransparency = 1,
        Size = UDim2.new(1,-10,0,20),
        Position = UDim2.new(0,10,0,5),
        TextXAlignment = Enum.TextXAlignment.Left,
    }, frame)

    local trackBg = makeInstance("Frame", {
        BackgroundColor3 = Theme.Border,
        Size = UDim2.new(1,-20,0,6),
        Position = UDim2.new(0,10,0,30),
        BorderSizePixel = 0,
    }, frame)
    makeInstance("UICorner", {CornerRadius = UDim.new(1,0)}, trackBg)

    local fill = makeInstance("Frame", {
        BackgroundColor3 = Theme.Accent,
        Size = UDim2.new((default-min_)/(max_-min_),0,1,0),
        BorderSizePixel = 0,
    }, trackBg)
    makeInstance("UICorner", {CornerRadius = UDim.new(1,0)}, fill)

    local dragging = false
    local inputBg = makeInstance("TextButton", {
        BackgroundTransparency = 1, Size = UDim2.new(1,0,1,0), Text = ""
    }, trackBg)

    local function updateSlider(x)
        local rel = math.clamp((x - trackBg.AbsolutePosition.X) / trackBg.AbsoluteSize.X, 0, 1)
        local val = math.floor(min_ + rel * (max_ - min_))
        fill.Size = UDim2.new(rel, 0, 1, 0)
        labelL.Text = label .. ": " .. tostring(val)
        if onChange then onChange(val) end
    end

    inputBg.MouseButton1Down:Connect(function() dragging = true end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            updateSlider(i.Position.X)
        end
    end)

    return frame
end

