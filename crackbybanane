        Position = default and UDim2.new(1,-20,0.5,-9) or UDim2.new(0,2,0.5,-9),
        BackgroundColor3 = default and T.BG or T.TextDim,
        BorderSizePixel = 0,
    }, track)
    Corner(9, knob)

    local state = default or false
    local btn = New("TextButton", {
        BackgroundTransparency=1, Size=UDim2.new(1,0,1,0), Text=""
    }, frame)

    local function refresh(v)
        Tween(track, {BackgroundColor3 = v and T.Yellow or T.BG2})
        Tween(knob,  {
            Position = v and UDim2.new(1,-20,0.5,-9) or UDim2.new(0,2,0.5,-9),
            BackgroundColor3 = v and T.BG or T.TextDim,
        })
        track:FindFirstChildOfClass("UIStroke").Color = v and T.Yellow or T.Border
    end

    btn.MouseButton1Click:Connect(function()
        state = not state
        refresh(state)
        if cb then cb(state) end
    end)

    return frame, function() return state end, function(v)
        state = v
        refresh(v)
    end
end

-- Slider animé
local function MakeSlider(parent, label, min_, max_, default, cb)
    local frame = New("Frame", {
        BackgroundColor3 = T.BG3,
        Size = UDim2.new(1, 0, 0, 52),
        BorderSizePixel = 0,
    }, parent)
    Corner(8, frame)

    local lbl = New("TextLabel", {
        Text = label .. "  " .. default,
        TextColor3 = T.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        BackgroundTransparency = 1,
        Size = UDim2.new(1,-10,0,22),
        Position = UDim2.new(0,10,0,4),
        TextXAlignment = Enum.TextXAlignment.Left,
    }, frame)

    local track = New("Frame", {
        BackgroundColor3 = T.BG2,
        Size = UDim2.new(1,-20,0,6),
        Position = UDim2.new(0,10,0,32),
        BorderSizePixel = 0,
    }, frame)
    Corner(3, track)

    local fill = New("Frame", {
        BackgroundColor3 = T.Yellow,
        Size = UDim2.new((default-min_)/(max_-min_), 0, 1, 0),
        BorderSizePixel = 0,
    }, track)
    Corner(3, fill)

    -- Knob sur le slider
    local knob = New("Frame", {
        BackgroundColor3 = T.Yellow,
        Size = UDim2.new(0,14,0,14),
        Position = UDim2.new((default-min_)/(max_-min_),-7,0.5,-7),
        BorderSizePixel = 0,
        ZIndex = 2,
    }, track)
    Corner(7, knob)

    local dragging = false
    local hitbox = New("TextButton", {
        BackgroundTransparency=1, Size=UDim2.new(1,0,1,0), Text=""
    }, track)

    local function update(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local val = math.round(min_ + rel * (max_ - min_))
        fill.Size = UDim2.new(rel,0,1,0)
        knob.Position = UDim2.new(rel,-7,0.5,-7)
        lbl.Text = label .. "  " .. val
        if cb then cb(val) end
    end

    hitbox.MouseButton1Down:Connect(function() dragging = true end)
    hitbox.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then dragging = true end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if not dragging then return end
        if i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch then
            update(i.Position.X)
        end
    end)

    return frame
end

-- Bouton jaune animé
local function MakeBtn(parent, label, cb, size)
    local btn = New("TextButton", {
        Text = label,
        TextColor3 = T.BG,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        BackgroundColor3 = T.Yellow,
        Size = size or UDim2.new(1, 0, 0, 32),
        BorderSizePixel = 0,
        AutoButtonColor = false,
    }, parent)
    Corner(8, btn)

    btn.MouseEnter:Connect(function()
        Tween(btn, {BackgroundColor3 = T.YellowDim}, 0.1)
        Tween(btn, {Size = (size or UDim2.new(1,0,0,32)) + UDim2.new(0,0,0,2)}, 0.08)
    end)
    btn.MouseLeave:Connect(function()
        Tween(btn, {BackgroundColor3 = T.Yellow}, 0.1)
        Tween(btn, {Size = size or UDim2.new(1,0,0,32)}, 0.08)
    end)
    btn.MouseButton1Down:Connect(function()
        Tween(btn, {BackgroundColor3 = T.YellowDim}, 0.05)
    end)
    btn.MouseButton1Up:Connect(function()
        Tween(btn, {BackgroundColor3 = T.Yellow}, 0.05)
    end)
    btn.MouseButton1Click:Connect(function()
        if cb then cb() end
    end)
    return btn
end

