-- ClipsDescendants = false pendant toute l'animation
-- activé seulement après que le Spring est settled
-- ══════════════════════════════════════
local function safeOpenWindow(win, targetW, targetH)
    task.spawn(function()
        if not win then return end
        -- *jamais clipper pendant le Spring — le renderer Roblox
        --  clip avant que AbsoluteSize soit settled sur les executors lents* 😏
        win.ClipsDescendants = false
        win.Size = UDim2.new(0, targetW, 0, 1)
        local waited = 0
        repeat
            task.wait(0.05); waited = waited + 0.05
        until (win and win.Parent and win.AbsoluteSize.X > 0) or waited > 6
        if not (win and win.Parent) then return end
        local hw, hh = math.floor(targetW / 2), math.floor(targetH / 2)
        win.Position = UDim2.new(0.5, -hw, 0.5, -hh)
        task.wait(0.03)
        Spring(win, {Size = UDim2.new(0, targetW, 0, targetH), Position = UDim2.new(0.5, -hw, 0.5, -hh)}, 0.5)
        -- Spring dure ~0.5s, on attend 0.85s pour être sûr qu'il est settled
        task.delay(0.85, function()
            if not (win and win.Parent) then return end
            if win.AbsoluteSize.Y < targetH - 10 then
                warn("[🍌 v4.3] Spring drop → hard-set fallback")
                win.Size     = UDim2.new(0, targetW, 0, targetH)
                win.Position = UDim2.new(0.5, -hw, 0.5, -hh)
