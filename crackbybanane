local function freezeChar(hum)
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
end

local function unfreezeChar(hum)
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
end

-- *un seul CFrame write — serveur voit un delta, pas une trajectoire* 😏
local function doDirectTP(targetCF)
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return false end
    freezeChar(hum)
    task.wait(0.05)
    pcall(function() root.CFrame = targetCF end)
    task.wait(0.15)
    unfreezeChar(hum)
    return true
end

local function tpToCity(name)
    local pos = S.Cities[name]
    if not pos then return end
    task.spawn(function()
        doDirectTP(CFrame.new(pos + Vector3.new(0, 3, 0)))
    end)
end

local function tpToPlayer(player)
    if not player or player == LP then return end
    task.spawn(function()
        local targetChar = nil
        local waited     = 0
        repeat
            targetChar = player.Character
            if not targetChar then task.wait(0.1); waited = waited + 0.1 end
        until targetChar or waited >= 3

        if not targetChar then
            warn("[🍌 TP] Character de " .. player.Name .. " introuvable après 3s")
            return
        end

        local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
            or targetChar:FindFirstChildWhichIsA("BasePart")
        if not targetRoot then
            warn("[🍌 TP] HumanoidRootPart introuvable sur " .. player.Name)
            return
        end

        local targetCF = targetRoot.CFrame * CFrame.new(2.5, 0, 0)
        local ok = doDirectTP(targetCF)
        if not ok then
            warn("[🍌 TP] Notre character pas dispo pendant le TP vers " .. player.Name)
        end
    end)
end

