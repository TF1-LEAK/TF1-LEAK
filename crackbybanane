--[[ *le TP ne convainc pas la physique — il la contourne
      avec la violence douce d'un CFrame.* ]]

local TeleportEngine = {}

-- TP doux pour bypass l'anti-cheat (plusieurs petits sauts)
function TeleportEngine:SmoothTP(targetCF, steps, delay_)
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    steps = steps or 5
    delay_ = delay_ or 0.05

    local startCF = root.CFrame
    for i = 1, steps do
        local alpha = i / steps
        local interp = startCF:Lerp(targetCF, alpha)
        root.CFrame = interp
        task.wait(delay_)
    end
    -- Arrivée finale
    root.CFrame = targetCF
end

function TeleportEngine:ToPlayer(targetPlayer)
    local char   = targetPlayer.Character
    local root   = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    self:SmoothTP(root.CFrame + Vector3.new(2, 0, 2))
end

function TeleportEngine:ToCity(cityName)
    local pos = Settings.Cities[cityName]
    if not pos then return end
    self:SmoothTP(CFrame.new(pos))
end

