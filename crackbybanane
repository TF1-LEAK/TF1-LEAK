-- WAIT FOR GAME READY
-- ══════════════════════════════════════
task.spawn(function()
    if not game:IsLoaded() then
        game.Loaded:Wait()
    end

    local lp = Players.LocalPlayer
    if not lp then
        Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
        lp = Players.LocalPlayer
    end

    if not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then
        local char = lp.Character or lp.CharacterAdded:Wait()
        char:WaitForChild("HumanoidRootPart", 10)
    end

    -- FIX v4.2: 1s au lieu de 0.5s
    -- Sur les executors avec auto-exec au boot (Synapse startup scripts),
    -- 0.5s n'est pas suffisant pour que TweenService et Drawing soient
    -- fully initialized. 1s couvre même les setups avec antivirus lent.
    task.wait(1)

    boot()
end)

