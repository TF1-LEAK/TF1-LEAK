            TextColor3=T.TextDim,
            Font=Enum.Font.Gotham,
            TextSize=12,
            BackgroundTransparency=1,
            Size=UDim2.new(1,0,0,70),
            TextWrapped=true,
            TextXAlignment=Enum.TextXAlignment.Left,
        }, p)
    end

    -- 📷 FreeCam
    do
        local p = tabPages["📷 FreeCam"]
        SectionLabel("⚙ FreeCam", p)
        MakeToggle(p, "FreeCam Activé", S.FreeCam.On, function(v)
            S.FreeCam.On = v
            toggleFreeCam()
        end)
        SectionLabel("⚡ Vitesse", p)
        MakeSlider(p, "Vitesse (x10)", 1, 100, math.floor(S.FreeCam.Speed*10),
            function(v) S.FreeCam.Speed=v/10 end)
        MakeSlider(p, "Boost Shift (x10)", 10, 100, math.floor(S.FreeCam.ShiftMult*10),
            function(v) S.FreeCam.ShiftMult=v/10 end)
        New("TextLabel", {
            Text="WASD = bouger | Q/E = haut/bas\nShift = boost | Souris = rotation\nKeybind: G pour toggle",
            TextColor3=T.TextDim, Font=Enum.Font.Gotham, TextSize=12,
            BackgroundTransparency=1, Size=UDim2.new(1,0,0,50),
            TextWrapped=true, TextXAlignment=Enum.TextXAlignment.Left,
        }, p)
    end

    -- ⚡ Teleport
    do
        local p = tabPages["⚡ Teleport"]

        SectionLabel("🏙 Villes — Infected Lands", p)
        -- Grid 2 colonnes pour les villes
        local grid = New("Frame", {
            BackgroundTransparency=1,
            Size=UDim2.new(1,0,0,1),
        }, p)
        local gridLayout = New("UIGridLayout", {
            CellSize=UDim2.new(0.5,-4,0,32),
            CellPaddingX=UDim.new(0,4),
            CellPaddingY=UDim.new(0,4),
        }, grid)
        gridLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            grid.Size = UDim2.new(1,0,0,gridLayout.AbsoluteContentSize.Y)
        end)

        for cityName, _ in pairs(S.Cities) do
            MakeBtn(grid, cityName, function()
                tpToCity(cityName)
            end)
        end

        SectionLabel("👤 Téléport Joueur", p)

        local playerList = New("Frame", {
            BackgroundTransparency=1,
            Size=UDim2.new(1,0,0,1),
        }, p)
        local plLayout = New("UIListLayout", {
            Padding=UDim.new(0,4),
            FillDirection=Enum.FillDirection.Vertical,
        }, playerList)
        plLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            playerList.Size = UDim2.new(1,0,0,plLayout.AbsoluteContentSize.Y)
        end)

        local function refreshPlayers()
            for _, ch in ipairs(playerList:GetChildren()) do
                if not ch:IsA("UIListLayout") then ch:Destroy() end
            end
            local list = Players:GetPlayers()
            if #list <= 1 then
                New("TextLabel", {
                    Text="Aucun autre joueur",
                    TextColor3=T.TextDim,
                    Font=Enum.Font.Gotham,
                    TextSize=12,
                    BackgroundTransparency=1,
                    Size=UDim2.new(1,0,0,28),
                    TextXAlignment=Enum.TextXAlignment.Left,
                }, playerList)
                return
            end
            for _, pl in ipairs(list) do
                if pl ~= LP then
                    local row = New("Frame", {
                        BackgroundColor3=T.BG3,
                        Size=UDim2.new(1,0,0,34),
                        BorderSizePixel=0,
                    }, playerList)
                    Corner(8, row)

                    New("TextLabel", {
                        Text="👤 " .. pl.Name,
                        TextColor3=T.Text,
                        Font=Enum.Font.GothamMedium,
                        TextSize=13,
                        BackgroundTransparency=1,
                        Size=UDim2.new(1,-90,1,0),
                        Position=UDim2.new(0,10,0,0),
                        TextXAlignment=Enum.TextXAlignment.Left,
                    }, row)

                    -- Distance live
                    local distL = New("TextLabel", {
                        Text="...",
                        TextColor3=T.TextDim,
                        Font=Enum.Font.Gotham,
                        TextSize=11,
                        BackgroundTransparency=1,
                        Size=UDim2.new(0,50,1,0),
                        Position=UDim2.new(1,-140,0,0),
                        TextXAlignment=Enum.TextXAlignment.Right,
                    }, row)

                    -- Mise à jour distance
                    task.spawn(function()
                        while row and row.Parent do
                            local char = pl.Character
                            local myChar = LP.Character
                            if char and myChar then
                                local pr = char:FindFirstChild("HumanoidRootPart")
                                local mr = myChar:FindFirstChild("HumanoidRootPart")
                                if pr and mr then
                                    local d = math.floor((pr.Position - mr.Position).Magnitude)
                                    distL.Text = d .. "m"
                                end
                            end
                            task.wait(0.5)
                        end
                    end)

                    MakeBtn(row, "TP", function()
                        tpToPlayer(pl)
                    end, UDim2.new(0,70,0,24))
                    row:FindFirstChildOfClass("TextButton").Position = UDim2.new(1,-78,0.5,-12)
                end
            end
        end

        refreshPlayers()
        MakeBtn(p, "↺ Rafraîchir", refreshPlayers)

        Players.PlayerAdded:Connect(refreshPlayers)
        Players.PlayerRemoving:Connect(function()
            task.wait(0.1)
            refreshPlayers()
        end)
    end

    -- 🛡 Bypass
    do
        local p = tabPages["🛡 Bypass"]
        SectionLabel("⚙ Anti-Cheat Bypass", p)
        MakeToggle(p, "Anti-Kick",     S.Bypass.AntiKick,  function(v) S.Bypass.AntiKick=v end)
        MakeToggle(p, "Remote Logger", S.Bypass.RemoteLog, function(v) S.Bypass.RemoteLog=v end)
        New("TextLabel", {
            Text="• Hook __namecall pour bloquer les remotes\n• Intercepte Kick() via metatable\n• Smooth TP pour bypass sanity check",
            TextColor3=T.TextDim,
            Font=Enum.Font.Gotham,
            TextSize=12,
            BackgroundTransparency=1,
            Size=UDim2.new(1,0,0,60),
            TextWrapped=true,
            TextXAlignment=Enum.TextXAlignment.Left,
        }, p)
    end

    -- ⚙ Config
    do
        local p = tabPages["⚙ Config"]
        SectionLabel("⌨ Keybinds", p)
        local binds = {
            {"Insert / RightShift", "Afficher/Cacher UI"},
            {"RMB",                 "Aimbot normal"},
            {"F",                   "Toggle NoClip"},
            {"G",                   "Toggle FreeCam"},
        }
        for _, b in ipairs(binds) do
            local row = New("Frame", {
                BackgroundColor3=T.BG3,
                Size=UDim2.new(1,0,0,30),
                BorderSizePixel=0,
            }, p)
            Corner(8, row)
            New("TextLabel", {
                Text=" [" .. b[1] .. "]  →  " .. b[2],
                TextColor3=T.Text,
                Font=Enum.Font.Gotham,
                TextSize=12,
                BackgroundTransparency=1,
                Size=UDim2.new(1,0,1,0),
                TextXAlignment=Enum.TextXAlignment.Left,
            }, row)
        end

        SectionLabel("📋 Infos", p)
        New("TextLabel", {
            Text="Script: Banane Service v3.0\nJeu: Infected Lands\nExecutors: Synapse, KRNL, Fluxus, Delta,\nArceus X, Hydrogen, Codex\nDev: brody 🍌",
            TextColor3=T.TextDim,
            Font=Enum.Font.Gotham,
            TextSize=12,
            BackgroundTransparency=1,
            Size=UDim2.new(1,0,0,80),
            TextWrapped=true,
            TextXAlignment=Enum.TextXAlignment.Left,
        }, p)

        MakeBtn(p, "🗑 Effacer Session", function()
            pcall(function() delfile(SESSION_FILE) end)
        end)
    end

    -- ─── Keybinds globaux ───
    UserInputService.InputBegan:Connect(function(i, gp)
        if gp then return end
        if i.KeyCode == Enum.KeyCode.Insert
        or i.KeyCode == Enum.KeyCode.RightShift then
            win.Visible = not win.Visible
        end
        if i.KeyCode == Enum.KeyCode.F then
            S.NoClip.On = not S.NoClip.On
            if S.NoClip.On then startNoClip() else stopNoClip() end
        end
        if i.KeyCode == Enum.KeyCode.G then
            S.FreeCam.On = not S.FreeCam.On
            toggleFreeCam()
        end
    end)
end

-- ══════════════════════════════════════
-- MAIN LOOP
-- ══════════════════════════════════════
local function startLoop()
    initBypass()
    hookSilentAim()

    RunService.RenderStepped:Connect(function(dt)
        -- ESP
        if S.ESP.On then
            tickESP()
        else
            for _, esp in pairs(ESPCache) do
                for _, d in pairs(esp) do d.Visible = false end
            end
        end
        -- Aimbot
        tickAimbot()
        -- FreeCam
        tickFreeCam(dt)
    end)

    -- NoClip sur Stepped (plus fiable que RenderStepped)
    -- Géré par startNoClip/stopNoClip via connections dédiées

    -- Cleanup joueurs
    Players.PlayerRemoving:Connect(removeESP)
end

