-- TELEPORT ENGINE
-- ══════════════════════════════════════
local function smoothTP(targetCF)
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not root then return end

    -- Freeze via Physics state
    if hum then
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
    end

    -- 4 micro-sauts pour bypass sanity check serveur
    local startCF = root.CFrame
    for i = 1, 4 do
        local alpha = i / 4
        pcall(function() root.CFrame = startCF:Lerp(targetCF, alpha) end)
        task.wait(0.04)
    end
    pcall(function() root.CFrame = targetCF end)

    task.wait(0.15)
    if hum then
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
end

local function tpToCity(name)
    local pos = S.Cities[name]
    if not pos then return end
    task.spawn(function()
        smoothTP(CFrame.new(pos + Vector3.new(0, 3, 0)))
    end)
end

local function tpToPlayer(player)
    if not player or player == LP then return end
    task.spawn(function()
        local char = player.Character
        if not char then task.wait(0.8); char = player.Character end
        if not char then return end

        local root = char:FindFirstChild("HumanoidRootPart")
            or char:FindFirstChildWhichIsA("BasePart")
        if not root then return end

        local offset = root.CFrame * CFrame.new(3.5, 0, 0)
        smoothTP(offset)
    end)
end

