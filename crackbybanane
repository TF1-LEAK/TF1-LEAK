-- ══════════════════════════════════════
-- FREECAM ENGINE — FIXED
-- ══════════════════════════════════════
--[[
  FIX: L'ancien code calculait le mouvement DEUX FOIS (une fois via
       CFrame * CFrame.new(direction) et une deuxième via les vecteurs
       LookVector/RightVector/UpVector). Les deux s'annulaient partiellement
       ou se cumulaient de façon imprévisible.
       Version corrigée: UN SEUL calcul via les vecteurs de base.
]]

local fcActive = false
local fcCF     = CFrame.new(0, 50, 0)
local fcYaw    = 0
local fcPitch  = 0

local function toggleFreeCam(force)
    if force ~= nil then
        fcActive = force
    else
        fcActive = not fcActive
    end

    if fcActive then
        -- Snapshot l'orientation actuelle décomposée
        fcCF   = Camera.CFrame
        local  rx, ry, rz = fcCF:ToEulerAnglesYXZ()
        fcPitch = rx
        fcYaw   = ry
        Camera.CameraType = Enum.CameraType.Scriptable
    else
        Camera.CameraType = Enum.CameraType.Custom
    end
end

local function tickFreeCam(dt)
    if not fcActive or not S.FreeCam.On then return end

    local UIS = UserInputService
    local spd = S.FreeCam.Speed * 50 * dt
    if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
        spd = spd * S.FreeCam.ShiftMult
    end

    -- Rotation souris
    local delta = UIS:GetMouseDelta()
    fcYaw   = fcYaw   - math.rad(delta.X * 0.25)
    fcPitch = math.clamp(fcPitch - math.rad(delta.Y * 0.25), -math.pi/2 + 0.05, math.pi/2 - 0.05)

    -- Rebuild CFrame propre depuis yaw/pitch
    local rot = CFrame.fromEulerAnglesYXZ(fcPitch, fcYaw, 0)

    -- Vecteurs directionnels depuis la rotation
    local fwd   = rot.LookVector
    local right = rot.RightVector
    local up    = Vector3.new(0, 1, 0)

    local move = Vector3.new(0, 0, 0)
    if UIS:IsKeyDown(Enum.KeyCode.W) then move = move + fwd   * spd end
    if UIS:IsKeyDown(Enum.KeyCode.S) then move = move - fwd   * spd end
    if UIS:IsKeyDown(Enum.KeyCode.A) then move = move - right * spd end
    if UIS:IsKeyDown(Enum.KeyCode.D) then move = move + right * spd end
    if UIS:IsKeyDown(Enum.KeyCode.E) then move = move + up    * spd end
    if UIS:IsKeyDown(Enum.KeyCode.Q) then move = move - up    * spd end

    fcCF = CFrame.new(fcCF.Position + move) * rot

    -- *le freecam glisse sans friction —
    --  pixel par pixel dans l'espace mort de la map* 📷
    Camera.CFrame = fcCF
end

