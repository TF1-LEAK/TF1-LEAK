-- AIMBOT ENGINE (FIXED)
-- ══════════════════════════════════════
local FOVCircle = Drawing.new("Circle")
FOVCircle.Visible     = false
FOVCircle.Color       = T.Yellow
FOVCircle.Thickness   = 1.5
FOVCircle.Filled      = false
FOVCircle.NumSides    = 64

local function getBestTarget()
    local sc   = Camera.ViewportSize
    local ctr  = Vector2.new(sc.X/2, sc.Y/2)
    local best, bestDist = nil, math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if S.Aimbot.TeamCheck and p.Team == LP.Team then continue end
        local char = p.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 then continue end

        local part = char:FindFirstChild(S.Aimbot.HitPart) or root
        local pos  = part.Position

        -- prédiction
        if S.Aimbot.Predict then
            pos = pos + root.AssemblyLinearVelocity * S.Aimbot.PredFactor
        end

        local sp, vis = Camera:WorldToViewportPoint(pos)
        if not vis then continue end

        local sp2 = Vector2.new(sp.X, sp.Y)
        local d   = (sp2 - ctr).Magnitude

        if d < S.Aimbot.FOV/2 and d < bestDist then
            bestDist = d
            best     = { pos = pos, part = part, player = p }
        end
    end
    return best
end

-- Silent aim via hook Mouse.Hit/Target
local silentHooked = false
local function hookSilentAim()
    if silentHooked then return end
    silentHooked = true
    pcall(function()
        local mt = getrawmetatable(Mouse)
        if not mt then return end
        setreadonly(mt, false)
        local oldIdx = mt.__index
        mt.__index = newcclosure(function(t, k)
            if S.Aimbot.On and S.Aimbot.Silent then
                local tgt = getBestTarget()
                if tgt then
                    if k == "Hit"    then return CFrame.new(tgt.pos) end
                    if k == "Target" then return tgt.part end
                end
            end
            return oldIdx(t, k)
        end)
        setreadonly(mt, true)
    end)
end

local function tickAimbot()
    local sc  = Camera.ViewportSize
    local ctr = Vector2.new(sc.X/2, sc.Y/2)

    FOVCircle.Visible  = S.Aimbot.ShowFOV and S.Aimbot.On
    FOVCircle.Radius   = S.Aimbot.FOV / 2
    FOVCircle.Position = ctr

    if not S.Aimbot.On or S.Aimbot.Silent then return end
    if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end

    local tgt = getBestTarget()
    if not tgt then return end

    local sp   = Camera:WorldToViewportPoint(tgt.pos)
    local spV2 = Vector2.new(sp.X, sp.Y)
    local delta= (spV2 - ctr)

    -- Smooth camera rotate
    local smooth = math.clamp(S.Aimbot.Smooth, 0.01, 0.99)
    local moved  = delta * (1 - smooth)

    local ray = Camera:ScreenPointToRay(ctr.X + moved.X, ctr.Y + moved.Y)
    local cf  = Camera.CFrame
    Camera.CFrame = CFrame.new(cf.Position, cf.Position + ray.Direction)
end

-- ══════════════════════════════════════
-- NOCLIP ENGINE (FIXED)
-- ══════════════════════════════════════
-- *le noclip est patient — il attend chaque frame
--  et convainc chaque part de ne plus exister physiquement*

local noClipConn = nil

local function startNoClip()
    if noClipConn then return end
    noClipConn = RunService.Stepped:Connect(function()
        if not S.NoClip.On then return end
        local char = LP.Character
        if not char then return end
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") and d.CanCollide then
                d.CanCollide = false
            end
        end
    end)
end

local function stopNoClip()
    if noClipConn then
        noClipConn:Disconnect()
        noClipConn = nil
    end
    -- Réactiver les collisions
    local char = LP.Character
    if char then
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") then
                d.CanCollide = true
            end
        end
    end
end

-- ══════════════════════════════════════
-- FREECAM ENGINE
-- ══════════════════════════════════════
local fcActive = false
local fcCF     = CFrame.new(0, 50, 0)

local function toggleFreeCam()
    fcActive = not fcActive
    if fcActive then
        fcCF = Camera.CFrame
        Camera.CameraType = Enum.CameraType.Scriptable
    else
        Camera.CameraType = Enum.CameraType.Custom
    end
end

local function tickFreeCam(dt)
    if not fcActive or not S.FreeCam.On then return end
    local spd = S.FreeCam.Speed * 50 * dt
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then spd = spd * S.FreeCam.ShiftMult end

    local cf = fcCF
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then cf = cf * CFrame.new(0,0,-spd) end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then cf = cf * CFrame.new(0,0, spd) end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then cf = cf * CFrame.new(-spd,0,0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then cf = cf * CFrame.new( spd,0,0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.E) then cf = cf * CFrame.new(0, spd,0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.Q) then cf = cf * CFrame.new(0,-spd,0) end

    local delta = UserInputService:GetMouseDelta()
    cf = CFrame.new(cf.Position)
        * CFrame.Angles(0, math.rad(-delta.X * 0.3), 0)
        * CFrame.Angles(math.rad(-delta.Y * 0.3), 0, 0)
        * CFrame.new(0, 0, 0)
    -- Préserver la rotation
    cf = CFrame.new(fcCF.Position)
        * (CFrame.new(fcCF.Position):Inverse() * cf)

    -- Rebuild propre
    local p  = cf.Position
    local lv = (fcCF - fcCF.Position) -- rotation delta
    cf = fcCF * CFrame.Angles(math.rad(-delta.Y*0.3), 0, 0)
    cf = CFrame.new(p) * (Camera.CFrame - Camera.CFrame.Position) -- garde orientation
    -- Simple rebuild stable
    fcCF = fcCF
        * CFrame.Angles(0, math.rad(-delta.X * 0.3), 0)
    fcCF = fcCF * CFrame.Angles(math.rad(-delta.Y * 0.3), 0, 0)
    -- Translation
    local right   = fcCF.RightVector
    local up      = Vector3.new(0,1,0)
    local forward = fcCF.LookVector
    local move    = Vector3.new(0,0,0)
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move - forward*spd end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move + forward*spd end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - right*spd   end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + right*spd   end
    if UserInputService:IsKeyDown(Enum.KeyCode.E) then move = move + up*spd      end
    if UserInputService:IsKeyDown(Enum.KeyCode.Q) then move = move - up*spd      end
    fcCF = CFrame.new(fcCF.Position + move) * (fcCF - fcCF.Position)

    Camera.CFrame = fcCF
end

-- ══════════════════════════════════════
-- TELEPORT ENGINE (FIXED)
-- ══════════════════════════════════════
-- *le TP fait plusieurs petits sauts pour pas
--  déclencher le sanity check du serveur* 🍌

local function smoothTP(targetCF)
    -- *méthode: on disable le physics, on TP, on re-enable*
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not root then return end

    -- Freeze le character
    local oldState = hum and hum:GetState()
    if hum then hum:ChangeState(Enum.HumanoidStateType.Physics) end

    -- TP en 3 étapes pour bypass l'anti-cheat
    local startCF = root.CFrame
    for i = 1, 3 do
        local alpha = i / 3
        root.CFrame = startCF:Lerp(targetCF, alpha)
        task.wait(0.05)
    end
    root.CFrame = targetCF

    -- Unfreeze
    task.wait(0.1)
    if hum then hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
end

local function tpToCity(name)
    local pos = S.Cities[name]
    if not pos then return end
    smoothTP(CFrame.new(pos))
end

local function tpToPlayer(player)
    -- *le TP joueur récupère la position en temps réel*
    if not player or player == LP then return end
    local char = player.Character
    if not char then
        -- Retry une fois
        task.wait(0.5)
        char = player.Character
        if not char then return end
    end

    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then
        -- Essaie tous les BaseParts du char
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                root = p
                break
            end
        end
    end
    if not root then return end

    -- TP légèrement à côté pour pas glitch dans le joueur
    local offset = root.CFrame * CFrame.new(3, 0, 0)
    smoothTP(offset)
end

