--[[ *l'ESP voit tout le monde — comme un dieu distrait
      qui a oublié de rendre les murs opaques* ]]

local ESP = {}
local ESPObjects = {}

local function createDrawing(type_, props)
    local d = Drawing.new(type_)
    for k, v in pairs(props) do
        d[k] = v
    end
    return d
end

local function getPlayerESP(player)
    if not ESPObjects[player] then
        ESPObjects[player] = {
            Box       = createDrawing("Square",  {Visible=false, Color=Settings.ESP.BoxColor, Thickness=1, Filled=false}),
            Name      = createDrawing("Text",    {Visible=false, Color=Settings.ESP.NameColor, Size=13, Center=true, Outline=true}),
            Health    = createDrawing("Text",    {Visible=false, Color=Settings.ESP.HealthColor, Size=11, Center=true, Outline=true}),
            Distance  = createDrawing("Text",    {Visible=false, Color=Color3.fromRGB(200,200,200), Size=11, Center=true, Outline=true}),
            Tracer    = createDrawing("Line",    {Visible=false, Color=Settings.ESP.TracerColor, Thickness=1}),
        }
    end
    return ESPObjects[player]
end

local function clearESP(player)
    if ESPObjects[player] then
        for _, d in pairs(ESPObjects[player]) do
            d:Remove()
        end
        ESPObjects[player] = nil
    end
end

local function updateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LP then continue end

        local esp = getPlayerESP(player)
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")

        if not root or not hum or hum.Health <= 0 then
            for _, d in pairs(esp) do d.Visible = false end
            continue
        end

        -- Team check optionnel
        if Settings.ESP.TeamCheck and player.Team == LP.Team then
            for _, d in pairs(esp) do d.Visible = false end
            continue
        end

        local rootPos = root.Position
        local dist    = (Camera.CFrame.Position - rootPos).Magnitude

        if dist > Settings.ESP.MaxDistance then
            for _, d in pairs(esp) do d.Visible = false end
            continue
        end

        -- World → Screen pour les coins du character
        local head  = char:FindFirstChild("Head")
        local headPos = head and head.Position or (rootPos + Vector3.new(0, 2.5, 0))
        local feetPos = rootPos - Vector3.new(0, 3, 0)

        local headScreen, headVis = Camera:WorldToViewportPoint(headPos)
        local feetScreen, feetVis = Camera:WorldToViewportPoint(feetPos)

        if not headVis then
            for _, d in pairs(esp) do d.Visible = false end
            continue
        end

        local boxH = math.abs(headScreen.Y - feetScreen.Y)
        local boxW = boxH * 0.6
        local topLeft = Vector2.new(headScreen.X - boxW/2, headScreen.Y)

        -- Box
        if Settings.ESP.ShowBox then
            esp.Box.Visible  = true
            esp.Box.Position = topLeft
            esp.Box.Size     = Vector2.new(boxW, boxH)
            esp.Box.Color    = Settings.ESP.BoxColor
        else
            esp.Box.Visible = false
        end

        -- Nom
        if Settings.ESP.ShowName then
            esp.Name.Visible  = true
            esp.Name.Text     = player.Name
            esp.Name.Position = Vector2.new(headScreen.X, headScreen.Y - 16)
        else
            esp.Name.Visible = false
        end

        -- Santé
        if Settings.ESP.ShowHealth then
            local hp = math.floor(hum.Health)
            local maxhp = math.floor(hum.MaxHealth)
            esp.Health.Visible  = true
            esp.Health.Text     = hp .. "/" .. maxhp
            esp.Health.Color    = Color3.fromRGB(
                math.floor(255 * (1 - hp/maxhp)),
                math.floor(255 * (hp/maxhp)),
                0
            )
            esp.Health.Position = Vector2.new(headScreen.X, feetScreen.Y + 2)
        else
            esp.Health.Visible = false
        end

        -- Distance
        if Settings.ESP.ShowDistance then
            esp.Distance.Visible  = true
            esp.Distance.Text     = "[" .. math.floor(dist) .. "m]"
            esp.Distance.Position = Vector2.new(headScreen.X, feetScreen.Y + 14)
        else
            esp.Distance.Visible = false
        end

        -- Tracer
        if Settings.ESP.ShowTracers then
            local screenCenter = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
            esp.Tracer.Visible = true
            esp.Tracer.From    = screenCenter
            esp.Tracer.To      = Vector2.new(feetScreen.X, feetScreen.Y)
        else
            esp.Tracer.Visible = false
        end
    end
end

