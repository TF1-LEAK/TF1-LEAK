--            KEY SYSTEM ENGINE
-- ══════════════════════════════════════════════
--[[ *la clé est le contrat — sans elle, le script
      reste muet, propre, impénétrable* ]]

local KeySystem = {}
local keyValidated = false

local function validateKeyLocal(key)
    for _, valid in ipairs(KEY_CONFIG.ValidKeys) do
        if key == valid then return true end
    end
    return false
end

local function validateKeyRemote(key, callback)
    if not KEY_CONFIG.RemoteValidation then
        callback(validateKeyLocal(key))
        return
    end
    pcall(function()
        local res = request({
            Url    = KEY_CONFIG.RemoteValidation .. "?key=" .. key,
            Method = "GET",
        })
        if res and res.StatusCode == 200 then
            local data = HttpService:JSONDecode(res.Body)
            callback(data.valid == true)
        else
            callback(false)
        end
    end)
end

-- Sauvegarde session locale
local function saveSession(key)
    pcall(function()
        writefile(KEY_CONFIG.SessionFile, key)
    end)
end

local function loadSession()
    if not isfile(KEY_CONFIG.SessionFile) then return nil end
    local ok, content = pcall(readfile, KEY_CONFIG.SessionFile)
    if ok and content and content ~= "" then return content end
    return nil
end

function KeySystem:Validate(key, callback)
    validateKeyRemote(key, function(valid)
        if valid then
            keyValidated = true
            saveSession(key)
        end
        callback(valid)
    end)
end

