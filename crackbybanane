--          ANTI-CHEAT BYPASS ENGINE
-- ══════════════════════════════════════════════
--[[ *le bypass observe les remotes comme un sniper —
      il choisit lesquelles laisser passer, lesquelles neutraliser* ]]

local BypassEngine = {}
local _blockedRemotes = {}
local _originalFireServer

-- Hook FireServer pour filtrer les kicks/détections
local function hookRemotes()
    if not hookfunction then return end

    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}

        if method == "FireServer" then
            local remoteName = self.Name or ""

            -- Block anti-cheat detection remotes
            local blocked = {
                "ReportPlayer", "AntiCheat", "KickPlayer",
                "SpeedDetect", "TeleportDetect", "FlagPlayer",
                "SanityCheck", "ValidateMovement"
            }
            for _, b in ipairs(blocked) do
                if remoteName:lower():find(b:lower()) then
                    if Settings.Bypass.RemoteLogger then
                        warn("[IL Bypass] Blocked remote: " .. remoteName)
                    end
                    return -- silent drop
                end
            end

            -- Fake walkspeed: si le serveur vérifie la vitesse, on envoie la valeur normale
            if remoteName:lower():find("move") or remoteName:lower():find("walk") then
                if Settings.Bypass.FakeWalkspeed and #args > 0 then
                    -- ne pas modifier, juste laisser passer
                end
            end
        end

        return oldNamecall(self, ...)
    end)

    setreadonly(mt, true)
end

-- Anti-kick: intercepte les appels de kick locaux
local function antiKick()
    if not hookfunction then return end
    -- Protège contre les kick() appelés via script serveur répliqué
    pcall(function()
        local mt = getrawmetatable(LP)
        setreadonly(mt, false)
        local old = mt.__index
        mt.__index = newcclosure(function(t, k)
            if k == "Kick" then
                return function() warn("[IL Bypass] Kick intercepted") end
            end
            return old(t, k)
        end)
        setreadonly(mt, true)
    end)
end

function BypassEngine:Init()
    pcall(hookRemotes)
    pcall(antiKick)
    -- Anti-teleport detect: smooth nos TPs
    -- Le bypass attend 0.1s après chaque TP pour ne pas spike le serveur
end

