from flask import Flask, request, jsonify
from datetime import datetime, timedelta
import json, os

app = Flask(__name__)

# Fichier whitelist local (ou remplace par une vraie DB)
WHITELIST_FILE = "keys.json"

def load_keys():
    if not os.path.exists(WHITELIST_FILE):
        return {}
    with open(WHITELIST_FILE, "r") as f:
        return json.load(f)

def save_keys(keys):
    with open(WHITELIST_FILE, "w") as f:
        json.dump(keys, f, indent=2)

# Route: ajouter une clé (appelée par ton webhook bot ou manuellement)
# POST /addkey  Body: {"key": "BANANA-XXXX-...", "premium": false, "expires_hours": 24}
@app.route("/addkey", methods=["POST"])
def add_key():
    data = request.get_json()
    key  = data.get("key", "").upper()
    if not key:
        return jsonify({"error": "missing key"}), 400
    
    keys = load_keys()
    keys[key] = {
        "premium":    data.get("premium", False),
        "created_at": datetime.utcnow().isoformat(),
        "expires_at": (datetime.utcnow() + timedelta(hours=data.get("expires_hours", 24))).isoformat(),
        "used_by":    []
    }
    save_keys(keys)
    return jsonify({"ok": True, "key": key})

# Route: valider une clé (appelée par le script Roblox)
# GET /validate?key=BANANA-XXXX-...
@app.route("/validate", methods=["GET"])
def validate_key():
    key  = request.args.get("key", "").upper()
    keys = load_keys()

    if key not in keys:
        return jsonify({"valid": False, "message": "Clé introuvable"})

    entry   = keys[key]
    expires = datetime.fromisoformat(entry["expires_at"])

    if datetime.utcnow() > expires:
        return jsonify({"valid": False, "message": "Clé expirée"})

    return jsonify({
        "valid":   True,
        "premium": entry.get("premium", False)
    })

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)

