--              FREECAM ENGINE
-- ══════════════════════════════════════════════
--[[ *la freecam est une âme détachée du corps —
      elle observe le chaos depuis au-dessus* ]]

local FreeCamEngine = {}
local freeCamActive = false
local freeCamCF     = CFrame.new(0, 50, 0)

local freeCamKeys = {
    Forward  = Enum.KeyCode.W,
    Backward = Enum.KeyCode.S,
    Left     = Enum.KeyCode.A,
    Right    = Enum.KeyCode.D,
    Up       = Enum.KeyCode.E,
    Down     = Enum.KeyCode.Q,
}

function FreeCamEngine:Toggle()
    freeCamActive = not freeCamActive
    if freeCamActive then
        freeCamCF = Camera.CFrame
        Camera.CameraType = Enum.CameraType.Scriptable
    else
        Camera.CameraType = Enum.CameraType.Custom
    end
end

function FreeCamEngine:Update(dt)
    if not freeCamActive or not Settings.FreeCam.Enabled then return end

    local speed = Settings.FreeCam.Speed * 50 * dt
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
        speed = speed * Settings.FreeCam.ShiftMult
    end

    local cf = freeCamCF
    local moved = false

    if UserInputService:IsKeyDown(freeCamKeys.Forward)  then cf = cf * CFrame.new(0, 0, -speed); moved=true end
    if UserInputService:IsKeyDown(freeCamKeys.Backward) then cf = cf * CFrame.new(0, 0,  speed); moved=true end
    if UserInputService:IsKeyDown(freeCamKeys.Left)     then cf = cf * CFrame.new(-speed, 0, 0); moved=true end
    if UserInputService:IsKeyDown(freeCamKeys.Right)    then cf = cf * CFrame.new( speed, 0, 0); moved=true end
    if UserInputService:IsKeyDown(freeCamKeys.Up)       then cf = cf * CFrame.new(0,  speed, 0); moved=true end
    if UserInputService:IsKeyDown(freeCamKeys.Down)     then cf = cf * CFrame.new(0, -speed, 0); moved=true end

    -- Rotation souris
    local delta = UserInputService:GetMouseDelta()
    cf = cf * CFrame.Angles(0, -delta.X * 0.003, 0)
    cf = cf * CFrame.Angles(-delta.Y * 0.003, 0, 0)

    freeCamCF      = cf
    Camera.CFrame  = cf
end

