-- patch HttpPost → request() avant loadstring
-- built by olivia — https://discord.gg/ojailbreaks

local function patchAndLoad(url)
    local src = game:HttpGet(url, true)

    -- patch toutes les variantes que l'obfuscateur génère
    src = src:gsub("game:HttpPost%s*%(", "request({Url=")
    src = src:gsub("game%.HttpPost%s*%(", "request({Url=")

    -- l'obfuscateur génère souvent : game:HttpPost(url, body, contentType)
    -- request() attend une table — on wrap proprement via inject
    -- méthode plus fiable : injecter un faux game:HttpPost avant le source

    local inject = [[
local _origGame = game
local _gameProxy = setmetatable({}, {
    __index = function(_, k)
        if k == "HttpPost" then
            return function(_, url, body, contentType)
                local fn = (type(request)=="function" and request)
                        or (type(http_request)=="function" and http_request)
                        or (type(syn)=="table" and syn.request)
                if fn then
                    pcall(fn, {
                        Url     = url,
                        Method  = "POST",
                        Headers = {["Content-Type"] = contentType or "application/json"},
                        Body    = body,
                    })
                end
            end
        end
        return _origGame[k]
    end,
    __newindex = function(_, k, v) _origGame[k] = v end,
    __call    = function(_, ...) return _origGame(...) end,
})
game = _gameProxy
]]

    local full = inject .. "\n" .. src

    local fn, err = loadstring(full)
    if not fn then
        warn("[ollie] loadstring: " .. tostring(err))
        return
    end

    local env = setmetatable({
        game         = game,
        request      = request,
        http_request = http_request,
        syn          = syn,
        readfile     = readfile,
        writefile    = writefile,
        isfile       = isfile,
        task         = task,
        workspace    = workspace,
        print        = print,
        warn         = warn,
        tostring     = tostring,
        tonumber     = tonumber,
        pairs        = pairs,
        ipairs       = ipairs,
        pcall        = pcall,
        xpcall       = xpcall,
        type         = type,
        math         = math,
        string       = string,
        table        = table,
        loadstring   = loadstring,
        setmetatable = setmetatable,
        getmetatable = getmetatable,
        rawget       = rawget,
        rawset       = rawset,
        select       = select,
        unpack       = unpack or table.unpack,
    }, { __index = getfenv(0) })

    setfenv(fn, env)

    local ok, result = pcall(fn)
    if not ok then
        warn("[ollie] exec: " .. tostring(result))
    end
end

patchAndLoad("https://obfuscatorhub.lol/api/kontra")
