local function slider(parent, name, key, mn, mx, step, cb)
    local h = new("Frame",{
        Size=UDim2.new(1,-4,0,58), BackgroundColor3=T.Card,
        BorderSizePixel=0, Parent=parent
    })
    corner(h,10)
    local lbl = new("TextLabel",{
        Position=UDim2.fromOffset(12,4), Size=UDim2.new(1,-24,0,20),
        BackgroundTransparency=1, TextColor3=T.Text,
        Font=Enum.Font.Gotham, TextSize=10,
        TextXAlignment=Enum.TextXAlignment.Left, Parent=h
    })
    local bar = new("Frame",{
        Position=UDim2.new(0,12,1,-15), Size=UDim2.new(1,-24,0,4),
        BackgroundColor3=Color3.fromRGB(40,30,5), BorderSizePixel=0, Parent=h
    })
    corner(bar,4)
    local fill = new("Frame",{BackgroundColor3=T.Accent, BorderSizePixel=0, Parent=bar})
    corner(fill,4)
    local dragging = false
    local function set(v)
        v = math.clamp(v, mn, mx)
        v = math.floor(v/step+0.5)*step
        v = tonumber(string.format("%.3f",v))
        CFG[key]=v
        fill.Size=UDim2.fromScale((v-mn)/(mx-mn),1)
        lbl.Text = step<1 and (name..": "..string.format("%.2f",v)) or (name..": "..math.floor(v))
        if cb then cb(v) end
    end
    local function upd(x)
        if bar.AbsoluteSize.X<=0 then return end
        local r = math.clamp((x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1)
        set(mn+(mx-mn)*r)
    end
    connect(bar.InputBegan, function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=true; upd(i.Position.X) end end)
    connect(UIS.InputChanged, function(i) if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then upd(i.Position.X) end end)
    connect(UIS.InputEnded, function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end end)
    set(CFG[key])
end

