-- ─── CHAMS ────────────────────────────────────────────────────────────────────
local partChamsCache={}
local highlightChamsCache={}

local function isVisibleBodyPart(part)
    if not part:IsA("BasePart") then return false end
    local n=part.Name:lower()
    if n=="humanoidrootpart" or n=="root" or n=="hitbox" or n=="collision" then return false end
    if part.Transparency>=0.99 then return false end
    return true
end

local function updateChams()
    if not Settings.ChamsEnabled then
        for _,pm in pairs(partChamsCache) do for _,a in pairs(pm) do if a then pcall(function() a:Destroy() end) end end end
        partChamsCache={}
        for _,h in pairs(highlightChamsCache) do if h then pcall(function() h:Destroy() end) end end
        highlightChamsCache={}; return
    end
    for p,pm in pairs(partChamsCache) do if not p or not p.Parent then for _,a in pairs(pm) do if a then a:Destroy() end end; partChamsCache[p]=nil end end
    for p,h in pairs(highlightChamsCache) do if not p or not p.Parent then if h then h:Destroy() end; highlightChamsCache[p]=nil end end

    for _,player in ipairs(Players:GetPlayers()) do
        if player==LocalPlayer then continue end
        local char=player.Character
        local hum=char and char:FindFirstChildOfClass("Humanoid")
        local isDead=char and (char:GetAttribute("Dead")==true or (hum and hum.Health<=0))
        local allowed=char and not isDead and (not Settings.TeamCheck or isOppositeTeam(LocalPlayer,player))
        if allowed then
            local chamColor=Settings.ChamsColor
            if Settings.UseTeamColorChams then
                local side=getNormalizedSide(player)
                if side=="T" then chamColor=Color3.fromRGB(240,160,40)
                elseif side=="CT" then chamColor=Color3.fromRGB(50,140,240) end
            end
            if Settings.ChamsMode=="Precision Body Chams" then
                if highlightChamsCache[player] then highlightChamsCache[player]:Destroy(); highlightChamsCache[player]=nil end
                if not partChamsCache[player] then partChamsCache[player]={} end
                local pm=partChamsCache[player]
                for _,child in ipairs(char:GetChildren()) do
                    if isVisibleBodyPart(child) then
                        local a=pm[child]
                        if not a or not a.Parent then
                            if a then a:Destroy() end
                            a=Instance.new("BoxHandleAdornment")
                            a.Name="BCham_"..child.Name; a.AlwaysOnTop=true; a.ZIndex=10; a.Parent=child
                            pm[child]=a
                        end
                        a.Adornee=child; a.Size=child.Size; a.Color3=chamColor
                        a.Transparency=Settings.ChamsFillTransparency; a.Visible=true
                    end
                end
                for part,a in pairs(pm) do if not part or not part.Parent or part.Parent~=char then if a then a:Destroy() end; pm[part]=nil end end
            elseif Settings.ChamsMode=="Highlight Chams" then
                if partChamsCache[player] then for _,a in pairs(partChamsCache[player]) do if a then a:Destroy() end end; partChamsCache[player]=nil end
                local hl=highlightChamsCache[player]
                if not hl or not hl.Parent then
                    hl=Instance.new("Highlight"); hl.Name="BChams_"..player.Name
                    hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; hl.Parent=char
                    highlightChamsCache[player]=hl
                end
                if hl.Adornee~=char then hl.Adornee=char end
                hl.Enabled=true; hl.FillColor=chamColor; hl.OutlineColor=chamColor
                hl.FillTransparency=Settings.ChamsFillTransparency; hl.OutlineTransparency=0
            end
        else
            if partChamsCache[player] then for _,a in pairs(partChamsCache[player]) do if a then a:Destroy() end end; partChamsCache[player]=nil end
            if highlightChamsCache[player] then highlightChamsCache[player]:Destroy(); highlightChamsCache[player]=nil end
        end
    end
end

-- ─── CLOSEST ENEMY ────────────────────────────────────────────────────────────
local function getClosestEnemyPart()
    local char=LocalPlayer.Character; if not char then return nil end
    local root=char:FindFirstChild("HumanoidRootPart"); if not root then return nil end
    local myPos=root.Position; local cd,cp=math.huge,nil
    for _,player in ipairs(Players:GetPlayers()) do
        if player==LocalPlayer then continue end
        local pChar=player.Character; if not pChar then continue end
        local hum=pChar:FindFirstChildOfClass("Humanoid")
        local isDead=pChar:GetAttribute("Dead")==true or (hum and hum.Health<=0)
        if isDead or pChar:GetAttribute("Invincible")==true then continue end
        if not isOppositeTeam(LocalPlayer,player) then continue end
        local ep=pChar:FindFirstChild("HumanoidRootPart") or pChar:FindFirstChild("Head") or pChar.PrimaryPart
        if ep then
            local d=(ep.Position-myPos).Magnitude
            if d<cd then cd=d; cp=ep end
        end
    end
    return cp
end

