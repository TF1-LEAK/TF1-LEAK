local DISCORD_URL = "https://discord.gg/Gc2zKtGadB"

local function createDiscordGate()
    local Players    = game:GetService("Players")
    local CoreGui    = game:GetService("CoreGui")
    local GuiService = game:GetService("GuiService")
    local LP         = Players.LocalPlayer

    local gateGui = Instance.new("ScreenGui")
    gateGui.Name="BananeGate"; gateGui.ResetOnSpawn=false
    gateGui.IgnoreGuiInset=true; gateGui.DisplayOrder=1000000

    local mounted=false
    if gethui then local ok,p=pcall(gethui); if ok and p then gateGui.Parent=p; mounted=true end end
    if not mounted then local ok=pcall(function() gateGui.Parent=CoreGui end); if not ok then gateGui.Parent=LP:WaitForChild("PlayerGui") end end

    local overlay=Instance.new("Frame",gateGui)
    overlay.Size=UDim2.fromScale(1,1); overlay.BackgroundColor3=Color3.fromRGB(7,6,2)
    overlay.BackgroundTransparency=0.1; overlay.BorderSizePixel=0

    local win=Instance.new("Frame",overlay)
    win.AnchorPoint=Vector2.new(0.5,0.5); win.Position=UDim2.fromScale(0.5,0.5)
    win.Size=UDim2.fromOffset(440,260); win.BackgroundColor3=Color3.fromRGB(14,10,2)
    win.BorderSizePixel=0
    Instance.new("UICorner",win).CornerRadius=UDim.new(0,14)
    local ws=Instance.new("UIStroke",win); ws.Color=Color3.fromRGB(255,175,0); ws.Thickness=2

    local function lbl(parent,text,x,y,w,h,size,color,bold)
        local l=Instance.new("TextLabel",parent)
        l.Position=UDim2.fromOffset(x,y); l.Size=UDim2.fromOffset(w,h)
        l.BackgroundTransparency=1; l.Text=text; l.TextColor3=color
        l.Font=bold and Enum.Font.GothamBold or Enum.Font.Gotham
        l.TextSize=size; l.TextXAlignment=Enum.TextXAlignment.Left
        l.TextWrapped=true; return l
    end

    lbl(win,"👑  BANANE SERVICE",20,18,400,30,22,Color3.fromRGB(255,175,0),true)
    lbl(win,"Rejoins le Discord officiel avant de continuer.",20,54,400,36,12,Color3.fromRGB(160,140,80),false)

    local status=lbl(win,"Connexion Discord requise.",20,100,400,28,11,Color3.fromRGB(255,175,0),false)

    local cbtn=Instance.new("TextButton",win)
    cbtn.Position=UDim2.fromOffset(20,146); cbtn.Size=UDim2.new(0.5,-26,0,44)
    cbtn.BackgroundColor3=Color3.fromRGB(200,140,0); cbtn.BorderSizePixel=0
    cbtn.Text="Rejoindre Discord"; cbtn.TextColor3=Color3.fromRGB(10,8,2)
    cbtn.Font=Enum.Font.GothamBold; cbtn.TextSize=13
    Instance.new("UICorner",cbtn).CornerRadius=UDim.new(0,9)

    local contbtn=Instance.new("TextButton",win)
    contbtn.Position=UDim2.new(0.5,6,0,146); contbtn.Size=UDim2.new(0.5,-26,0,44)
    contbtn.BackgroundColor3=Color3.fromRGB(30,22,4); contbtn.BorderSizePixel=0
    contbtn.Text="Continuer"; contbtn.TextColor3=Color3.fromRGB(100,80,30)
    contbtn.Font=Enum.Font.GothamBold; contbtn.TextSize=13; contbtn.AutoButtonColor=false
    Instance.new("UICorner",contbtn).CornerRadius=UDim.new(0,9)

    lbl(win,DISCORD_URL,20,212,400,20,10,Color3.fromRGB(80,60,20),false)

    local connected=false
    local event=Instance.new("BindableEvent")

    cbtn.MouseButton1Click:Connect(function()
        pcall(function() GuiService:OpenBrowserWindow(DISCORD_URL) end)
        if setclipboard then pcall(setclipboard,DISCORD_URL) end
        if connected then return end; connected=true
        status.TextColor3=Color3.fromRGB(90,235,150)
        status.Text="Discord ouvert ! Rejoins puis clique Continuer."
        contbtn.BackgroundColor3=Color3.fromRGB(200,140,0)
        contbtn.TextColor3=Color3.fromRGB(10,8,2); contbtn.AutoButtonColor=true
    end)

    contbtn.MouseButton1Click:Connect(function()
        if not connected then
            status.TextColor3=Color3.fromRGB(255,80,80)
            status.Text="Rejoins le Discord d'abord."; return
        end
        gateGui:Destroy(); event:Fire()
    end)

    event.Event:Wait(); event:Destroy(); return true
end

if not createDiscordGate() then return end

