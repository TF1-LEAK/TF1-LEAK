-- ─── VECTOR MATH ──────────────────────────────────────────────────────────────
local VectorMath={}
function VectorMath.getDirectionUnit(o,t)
    local d=t-o; return d.Magnitude<0.0001 and Vector3.new(0,0,1) or d.Unit
end
function VectorMath.getAngleDegrees(lv,du)
    return math.deg(math.acos(math.clamp(lv:Dot(du),-1,1)))
end
function VectorMath.isInVectorFOV(o,lv,tp,max)
    local du=VectorMath.getDirectionUnit(o,tp)
    local a=VectorMath.getAngleDegrees(lv,du)
    return (a<=max),a
end

-- ─── TEAM DETECTION ───────────────────────────────────────────────────────────
local function getNormalizedSide(player)
    if not player then return nil end
    local ok,teamObj=pcall(function() return player.Team end)
    if ok and teamObj and teamObj.Name then
        local n=teamObj.Name:lower()
        if n:find("counter") or n=="ct" or n:find("blue") or n:find("guard") then return "CT" end
        if n:find("terror") or n=="t" or n:find("red") or n:find("robber") then return "T" end
    end
    local okC,tc=pcall(function() return player.TeamColor end)
    if okC and tc then
        local cn=tc.Name:lower()
        if cn:find("blue") or cn:find("navy") or cn:find("cyan") then return "CT" end
        if cn:find("red") or cn:find("orange") or cn:find("yellow") then return "T" end
    end
    local char=player.Character
    if char and char.Parent then
        local pn=char.Parent.Name:lower()
        if pn:find("counter") or pn=="ct" then return "CT" end
        if pn:find("terror") or pn=="t" then return "T" end
    end
    local attr=player:GetAttribute("Team") or player:GetAttribute("Side")
    if attr~=nil then
        local s=tostring(attr):lower()
        if s:find("counter") or s=="ct" or s=="2" then return "CT" end
        if s:find("terror") or s=="t" or s=="1" then return "T" end
    end
    return nil
end

local function isOppositeTeam(my,target)
    if not my or not target or my==target then return false end
    local ms=getNormalizedSide(my); local ts=getNormalizedSide(target)
    if ms and ts then return ms~=ts end
    local ok1,t1=pcall(function() return my.Team end); local ok2,t2=pcall(function() return target.Team end)
    if ok1 and ok2 and t1~=nil and t2~=nil then return t1~=t2 end
    local okC1,c1=pcall(function() return my.TeamColor end); local okC2,c2=pcall(function() return target.TeamColor end)
    if okC1 and okC2 and c1~=nil and c2~=nil then return c1~=c2 end
    return true
end

getgenv().ParsaGetTeam=getNormalizedSide
getgenv().ParsaIsOpposite=isOppositeTeam

local function get_player_team(player)
    local s=getNormalizedSide(player)
    if s=="CT" then return "Counter-Terrorists" end
    if s=="T" then return "Terrorists" end
    return nil
end

