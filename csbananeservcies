-- ─── UTIL ─────────────────────────────────────────────────────────────────────
local function getChar(p)  return p.Character end
local function getHum(p)   local c=getChar(p); return c and c:FindFirstChildOfClass("Humanoid") end
local function getRoot(p)  local c=getChar(p); return c and c:FindFirstChild("HumanoidRootPart") end
local function getPart(p,n) local c=getChar(p); return c and (c:FindFirstChild(n) or c:FindFirstChild("HumanoidRootPart")) end
local function alive(p)    local h=getHum(p); return h and h.Health>0 end
local function sameTeam(p) return cfg.TeamCheck and p.Team==lp.Team end

local sw,sh = cam.ViewportSize.X, cam.ViewportSize.Y

local function toScreen(pos)
    local s,vis = cam:WorldToViewportPoint(pos)
    return Vector2.new(s.X,s.Y), s.Z, vis
end

local function inFOV(sp)
    local dx=sp.X-sw/2; local dy=sp.Y-sh/2
    return math.sqrt(dx*dx+dy*dy)<=cfg.FOV
end

local function enemies()
    local out={}
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=lp and not sameTeam(p) and alive(p) and getRoot(p) then
            out[#out+1]=p
        end
    end
    return out
end

-- ─── TARGET ───────────────────────────────────────────────────────────────────
local currentTarget=nil

local function getBest()
    local best,bd=nil,math.huge
    for _,p in ipairs(enemies()) do
        local pt=getPart(p,cfg.AimBone); if not pt then continue end
        local sp,dep,vis=toScreen(pt.Position)
        if not vis or dep<=0 or not inFOV(sp) then continue end
        local d=(sp-Vector2.new(sw/2,sh/2)).Magnitude
        if d<bd then bd=d; best=p end
    end
    return best
end

-- ─── AIMBOT ───────────────────────────────────────────────────────────────────
local function doAimbot()
    if not cfg.Aimbot then return end
    if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
    if not currentTarget then return end
    local pt=getPart(currentTarget,cfg.AimBone); if not pt then return end
    cam.CFrame=cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position,pt.Position),cfg.AimSmooth)
end

-- ─── SILENT AIM ───────────────────────────────────────────────────────────────
local function initSilentAim()
    if not hookmetamethod then return end
    local orig
    orig=hookmetamethod(game,"__namecall",newcclosure(function(self,...)
        local m=getnamecallmethod()
        if cfg.SilentAim and (m=="FireServer" or m=="InvokeServer") and currentTarget then
            local pt=getPart(currentTarget,cfg.AimBone)
            if pt then
                local args={...}
                for i=1,#args do
                    if typeof(args[i])=="CFrame" then args[i]=CFrame.new(pt.Position); return orig(self,table.unpack(args))
                    elseif typeof(args[i])=="Vector3" then args[i]=pt.Position; return orig(self,table.unpack(args)) end
                end
            end
        end
        return orig(self,...)
    end))
end

-- ─── TRIGGERBOT ───────────────────────────────────────────────────────────────
local lastTrig=0
local function doTrigger()
    if not cfg.TriggerBot or tick()-lastTrig<cfg.TriggerDelay then return end
    if not currentTarget then return end
    local pt=getPart(currentTarget,cfg.AimBone); if not pt then return end
    local sp,_,vis=toScreen(pt.Position)
    if vis and (sp-Vector2.new(sw/2,sh/2)).Magnitude<20 then
        mouse1click(); lastTrig=tick()
    end
end

-- ─── ESP ──────────────────────────────────────────────────────────────────────
local dc={}
local SKEL={
    {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
    {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
    {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
    {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
}
local function gd(id,cls,props)
    if not dc[id] then
        local o=Drawing.new(cls)
        for k,v in pairs(props) do o[k]=v end
        dc[id]=o
    end
    return dc[id]
end

local function drawESP()
    for _,o in pairs(dc) do o.Visible=false end
    if not cfg.ESP then return end
    for _,p in ipairs(Players:GetPlayers()) do
        if p==lp or not alive(p) then continue end
        local c=getChar(p); if not c then continue end
        local head=c:FindFirstChild("Head")
        local root=c:FindFirstChild("HumanoidRootPart")
        local hum=c:FindFirstChildOfClass("Humanoid")
        if not head or not root or not hum then continue end
        local topS,dep,tVis=toScreen(head.Position+Vector3.new(0,0.7,0))
        local botS,_,bVis=toScreen(root.Position-Vector3.new(0,3,0))
        if not tVis or not bVis or dep<=0 then continue end
        local col=sameTeam(p) and Color3.fromRGB(60,180,255) or Color3.fromRGB(255,60,60)
        local h=math.abs(botS.Y-topS.Y); if h<5 then continue end
        local w=h*0.5; local cx=topS.X
        if cfg.ESPBox then
            local b=gd(p.UserId.."bx","Square",{Filled=false,Thickness=1.5})
            b.Size=Vector2.new(w,h); b.Position=Vector2.new(cx-w/2,topS.Y)
            b.Color=col; b.Visible=true
        end
        if cfg.ESPName then
            local n=gd(p.UserId.."nm","Text",{Size=13,Center=true,Outline=true,OutlineColor=Color3.new(0,0,0),Font=2})
            n.Text=p.DisplayName; n.Color=col
            n.Position=Vector2.new(cx,topS.Y-16); n.Visible=true
        end
        if cfg.ESPHealth then
            local rat=math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1)
            local bx2=cx-w/2-7
            local bg=gd(p.UserId.."hbg","Square",{Filled=true,Thickness=0,Color=Color3.fromRGB(10,10,10)})
            bg.Size=Vector2.new(4,h); bg.Position=Vector2.new(bx2,topS.Y); bg.Visible=true
            local fg=gd(p.UserId.."hfg","Square",{Filled=true,Thickness=0})
            local fh=h*rat
            fg.Size=Vector2.new(4,fh); fg.Position=Vector2.new(bx2,topS.Y+h-fh)
            fg.Color=Color3.fromRGB(math.floor(255*(1-rat)),math.floor(220*rat),30); fg.Visible=true
        end
        if cfg.ESPDist then
            local dd=gd(p.UserId.."dt","Text",{Size=11,Center=true,Outline=true,OutlineColor=Color3.new(0,0,0),Font=2})
            dd.Text=string.format("%.0f st",dep); dd.Color=Color3.fromRGB(200,200,200)
            dd.Position=Vector2.new(cx,botS.Y+4); dd.Visible=true
        end
        if cfg.ESPSkeleton then
            for i,pr in ipairs(SKEL) do
                local a=c:FindFirstChild(pr[1]); local b=c:FindFirstChild(pr[2])
                if a and b then
                    local sA,_,vA=toScreen(a.Position); local sB,_,vB=toScreen(b.Position)
                    if vA and vB then
                        local ln=gd(p.UserId.."sk"..i,"Line",{Thickness=1.1,Color=col})
                        ln.From=sA; ln.To=sB; ln.Color=col; ln.Visible=true
                    end
                end
            end
        end
    end
end

