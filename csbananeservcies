-- Skin Changer
local skinPanel = makePanel(mainFrame, "🎨  SKIN CHANGER",
    UDim2.new(0,261,0,292), UDim2.new(0,251,0,140))
makeToggle(skinPanel, "Enable",      "SkinChanger", 1)

local skinNames = {}
for k in pairs(skins) do table.insert(skinNames, k) end
local skinIdx = 1

local skinLbl = Instance.new("TextLabel")
skinLbl.Size            = UDim2.new(1,0,0,18)
skinLbl.BackgroundTransparency = 1
skinLbl.Text            = skinNames[skinIdx]
skinLbl.TextColor3      = cfg.AccentColor
skinLbl.TextSize        = 11
skinLbl.Font            = Enum.Font.Gotham
skinLbl.TextXAlignment  = Enum.TextXAlignment.Left
skinLbl.LayoutOrder     = 2
skinLbl.Parent          = skinPanel

local prevBtn = Instance.new("TextButton")
prevBtn.Size            = UDim2.new(0,24,0,20)
prevBtn.BackgroundColor3= Color3.fromRGB(50,38,10)
prevBtn.Text            = "◀"
prevBtn.TextColor3      = cfg.AccentColor
prevBtn.TextSize        = 12
prevBtn.Font            = Enum.Font.GothamBold
prevBtn.BorderSizePixel = 0
prevBtn.LayoutOrder     = 3
prevBtn.Parent          = skinPanel

local nextBtn = Instance.new("TextButton")
nextBtn.Size            = UDim2.new(0,24,0,20)
nextBtn.BackgroundColor3= Color3.fromRGB(50,38,10)
nextBtn.Text            = "▶"
nextBtn.TextColor3      = cfg.AccentColor
nextBtn.TextSize        = 12
nextBtn.Font            = Enum.Font.GothamBold
nextBtn.BorderSizePixel = 0
nextBtn.LayoutOrder     = 4
nextBtn.Parent          = skinPanel

prevBtn.MouseButton1Click:Connect(function()
    skinIdx = ((skinIdx-2) % #skinNames) + 1
    cfg.SelectedSkin = skinNames[skinIdx]
    skinLbl.Text     = skinNames[skinIdx]
    if cfg.SkinChanger then applySkin(cfg.SelectedSkin) end
end)
nextBtn.MouseButton1Click:Connect(function()
    skinIdx = (skinIdx % #skinNames) + 1
    cfg.SelectedSkin = skinNames[skinIdx]
    skinLbl.Text     = skinNames[skinIdx]
    if cfg.SkinChanger then applySkin(cfg.SelectedSkin) end
end)

-- INSERT key toggle
UserInputService.InputBegan:Connect(function(i, gpe)
    if gpe then return end
    if i.KeyCode == Enum.KeyCode.Insert then
        cfg.MenuOpen  = not cfg.MenuOpen
        mainFrame.Visible = cfg.MenuOpen
    end
end)

-- ─── MAIN LOOP ────────────────────────────────────────────────────────────────
initSilentAim()

RunService.RenderStepped:Connect(function()
    -- FOV circle
    local center = cam.ViewportSize / 2
    fovCircle.Position = center
    fovCircle.Radius   = cfg.FOVRadius
    fovCircle.Visible  = cfg.ShowFOVCircle and cfg.MenuOpen == false

    -- best target for silent aim ref
    silentTarget = getBestTarget()

    -- aim assist (only while holding right click)
    if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        doAimAssist(silentTarget)
    end

    -- trigger bot
    doTriggerBot()

    -- skin changer re-apply on weapon switch
    if cfg.SkinChanger then applySkin(cfg.SelectedSkin) end

    -- ESP
    drawESP()
end)
