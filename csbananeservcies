-- FILL: replace rbxassetid values with actual Blox Strike skin asset IDs from game files

local function applySkin(skinName)
    local char = lp.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end
    local handle = tool:FindFirstChild("Handle")
    if not handle then return end
    local mesh = handle:FindFirstChildOfClass("SpecialMesh") or handle:FindFirstChildOfClass("MeshPart")
    if mesh and skins[skinName] then
        if mesh:IsA("SpecialMesh") then
            mesh.TextureId = skins[skinName]
        elseif mesh:IsA("MeshPart") then
            mesh.TextureID = skins[skinName]
        end
    end
end

-- ─── ESP ─────────────────────────────────────────────────────────────────────
local espObjects = {}

local function getOrCreate(key, class, props)
    if not espObjects[key] then
        local obj = Drawing.new(class)
        for k,v in pairs(props) do obj[k] = v end
        espObjects[key] = obj
    end
    return espObjects[key]
end

local function clearESP(key)
    if espObjects[key] then
        espObjects[key].Visible = false
    end
end

local function drawESP()
    -- hide all first
    for _, obj in pairs(espObjects) do obj.Visible = false end

    if not cfg.ESPEnabled then return end

    for _, p in ipairs(Players:GetPlayers()) do
        if p == lp then continue end
        if not isAlive(p) then continue end

        local char = p.Character
        if not char then continue end

        local root = getRoot(char)
        local head = char:FindFirstChild("Head")
        if not root or not head then continue end

        local rootScr, rootDepth, rootOn = worldToViewport(root.Position)
        local headScr, _, headOn         = worldToViewport(head.Position + Vector3.new(0,0.7,0))
        if not rootOn or not headOn then continue end
        if rootDepth > cfg.ESPMaxDist then continue end

        local isEnemy = not isTeam(p)
        local col     = isEnemy and Color3.fromRGB(255,60,60) or Color3.fromRGB(60,180,255)

        local height = math.abs(rootScr.Y - headScr.Y) * 2.2
        local width  = height * 0.45
        local top    = Vector2.new(headScr.X, headScr.Y)

        -- box
        if cfg.ESPBoxes then
            local box = getOrCreate(p.UserId.."box", "Square", {
                Thickness=1.5, Filled=false, Color=col, Visible=true
            })
            box.Position = Vector2.new(top.X - width/2, top.Y)
            box.Size     = Vector2.new(width, height)
            box.Color    = col
            box.Visible  = true
        end

        -- name
        if cfg.ESPNames then
            local nameTag = getOrCreate(p.UserId.."name", "Text", {
                Size=13, Center=true, Outline=true,
                OutlineColor=Color3.new(0,0,0), Font=2, Visible=true
            })
            nameTag.Text     = p.DisplayName
            nameTag.Color    = col
            nameTag.Position = Vector2.new(top.X, top.Y - 16)
            nameTag.Visible  = true
        end

        -- health bar
        if cfg.ESPHealth then
            local hp, maxHp = getHP(char)
            local hpRatio   = math.clamp(hp/maxHp, 0, 1)
            local barH      = height
            local bx        = top.X - width/2 - 6
            local barBg = getOrCreate(p.UserId.."hpbg","Square",{
                Thickness=1,Filled=true,Color=Color3.fromRGB(20,20,20),Visible=true
            })
            barBg.Position = Vector2.new(bx-2, top.Y)
            barBg.Size     = Vector2.new(4, barH)
            barBg.Visible  = true

            local barFg = getOrCreate(p.UserId.."hpfg","Square",{
                Thickness=1,Filled=true,
                Color=Color3.fromRGB(0, 220, 60),Visible=true
            })
            local fgH = barH * hpRatio
            barFg.Position = Vector2.new(bx-2, top.Y + barH - fgH)
            barFg.Size     = Vector2.new(4, fgH)
            barFg.Color    = Color3.fromRGB(
                math.floor(255*(1-hpRatio)),
                math.floor(220*hpRatio), 40)
            barFg.Visible  = true
        end

        -- distance
        if cfg.ESPDistance then
            local distTag = getOrCreate(p.UserId.."dist","Text",{
                Size=11,Center=true,Outline=true,
                OutlineColor=Color3.new(0,0,0),Font=2,Visible=true
            })
            distTag.Text     = string.format("%.0fm", rootDepth * 0.0254)
            distTag.Color    = Color3.fromRGB(200,200,200)
            distTag.Position = Vector2.new(top.X, top.Y + height + 2)
            distTag.Visible  = true
        end

        -- skeleton
        if cfg.ESPSkeleton then
            local bones = {
                {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
                {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
                {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
                {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
                {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
            }
            for i, pair in ipairs(bones) do
                local a = char:FindFirstChild(pair[1])
                local b = char:FindFirstChild(pair[2])
                if a and b then
                    local sa, _, onA = worldToViewport(a.Position)
                    local sb, _, onB = worldToViewport(b.Position)
                    if onA and onB then
                        local line = getOrCreate(p.UserId.."sk"..i,"Line",{
                            Thickness=1.1,Color=col,Visible=true
                        })
                        line.From    = sa
                        line.To      = sb
                        line.Color   = col
                        line.Visible = true
                    end
                end
            end
        end
    end
end

