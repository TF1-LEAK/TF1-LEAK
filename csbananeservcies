local function restoreOneHead(head)
    local o=originalHeads[head]; if not o then return end
    originalHeads[head]=nil
    if not head.Parent then return end
    pcall(function() head.Size=o.Size; head.Transparency=o.Transparency; head.CanCollide=o.CanCollide; head.Massless=o.Massless end)
end
local function restoreHeads() for h in pairs(originalHeads) do restoreOneHead(h) end end
local function updateHeads()
    local wanted = Vector3.new(CFG.HeadSize,CFG.HeadSize,CFG.HeadSize); local valid={}
    for _, p in ipairs(Players:GetPlayers()) do
        if validTarget(p) then
            local c=p.Character; local head=c and c:FindFirstChild("Head")
            if head and head:IsA("BasePart") then
                valid[head]=true
                if not originalHeads[head] then
                    originalHeads[head]={Size=head.Size,Transparency=head.Transparency,CanCollide=head.CanCollide,Massless=head.Massless}
                end
                pcall(function() head.Size=wanted; head.Transparency=CFG.HeadTransparency; head.CanCollide=false; head.Massless=true end)
            end
        end
    end
    local restore={}; for h in pairs(originalHeads) do if not valid[h] then restore[#restore+1]=h end end
    for _,h in ipairs(restore) do restoreOneHead(h) end
end

