local function setViewModelVisibility(visible)
    local Camera=Workspace.CurrentCamera; local alpha=visible and 0 or 1
    if Camera then
        for _,child in ipairs(Camera:GetChildren()) do
            local n=child.Name:lower()
            if child:IsA("Model") or n:find("view") or n:find("arm") or n:find("gun") then
                for _,p in ipairs(child:GetDescendants()) do
                    if p:IsA("BasePart") then p.LocalTransparencyModifier=alpha; p.Transparency=alpha
                    elseif p:IsA("Decal") or p:IsA("Texture") then p.Transparency=alpha end
                end
            end
        end
    end
end

-- ─── 3RD PERSON ───────────────────────────────────────────────────────────────
local lastTPState=false; local origMinZ,origMaxZ=0.5,128
local function updateThirdPersonState()
    local Camera=Workspace.CurrentCamera; if not Camera then return end
    local char=LocalPlayer.Character
    if Settings.ThirdPerson then
        local dist=Settings.ThirdPersonDist or 12
        LocalPlayer.CameraMode=Enum.CameraMode.Classic
        LocalPlayer.CameraMinZoomDistance=dist; LocalPlayer.CameraMaxZoomDistance=dist
        if char and Camera then
            local head=char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
            if head then
                for _,d in ipairs(char:GetDescendants()) do if d:IsA("BasePart") then d.LocalTransparencyModifier=0 end end
                if Settings.HideViewModelInThirdPerson then setViewModelVisibility(false) end
                local focusPos=head.Position+Vector3.new(0,1.5,0)
                local lookDir=Camera.CFrame.LookVector
                local targetCamPos=focusPos-(lookDir*dist)
                local tpRP=RaycastParams.new(); tpRP.FilterType=Enum.RaycastFilterType.Exclude; tpRP.FilterDescendantsInstances={char}
                local hr=Workspace:Raycast(focusPos,-lookDir*dist,tpRP)
                if hr then targetCamPos=hr.Position+(lookDir*0.5) end
                Camera.CFrame=CFrame.new(targetCamPos,focusPos)
            end
        end
        lastTPState=true
    else
        if lastTPState then
            LocalPlayer.CameraMinZoomDistance=origMinZ; LocalPlayer.CameraMaxZoomDistance=origMaxZ
            setViewModelVisibility(true); lastTPState=false
        end
    end
end

