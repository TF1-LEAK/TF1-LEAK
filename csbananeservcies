    local body=Instance.new("Frame",f)
    body.Size=UDim2.new(1,-10,1,-28); body.Position=UDim2.new(0,5,0,27)
    body.BackgroundTransparency=1
    local bl=Instance.new("UIListLayout",body)
    bl.Padding=UDim.new(0,4); bl.SortOrder=Enum.SortOrder.LayoutOrder
    bl.VerticalAlignment=Enum.VerticalAlignment.Top
    return body
end

-- ── toggle row
local function mkToggle(parent, label, key, order)
    local row=Instance.new("Frame",parent)
    row.Size=UDim2.new(1,0,0,22); row.BackgroundTransparency=1; row.LayoutOrder=order

    local lbl=Instance.new("TextLabel",row)
    lbl.Size=UDim2.new(1,-40,1,0); lbl.BackgroundTransparency=1
    lbl.Text=label; lbl.TextColor3=TEXT; lbl.TextSize=11; lbl.Font=Enum.Font.Gotham
    lbl.TextXAlignment=Enum.TextXAlignment.Left

    local bg=Instance.new("Frame",row)
    bg.Size=UDim2.new(0,34,0,17); bg.Position=UDim2.new(1,-36,0.5,-8.5)
    bg.BackgroundColor3=cfg[key] and GOLD or Color3.fromRGB(45,45,45)
    bg.BorderSizePixel=0; Instance.new("UICorner",bg).CornerRadius=UDim.new(1,0)

    local knob=Instance.new("Frame",bg)
    knob.Size=UDim2.new(0,13,0,13)
    knob.Position=cfg[key] and UDim2.new(1,-15,0.5,-6.5) or UDim2.new(0,2,0.5,-6.5)
    knob.BackgroundColor3=Color3.new(1,1,1); knob.BorderSizePixel=0
    Instance.new("UICorner",knob).CornerRadius=UDim.new(1,0)

    local btn=Instance.new("TextButton",row)
    btn.Size=UDim2.new(1,0,1,0); btn.BackgroundTransparency=1; btn.Text=""
    btn.ZIndex=2
    btn.MouseButton1Click:Connect(function()
        cfg[key]=not cfg[key]
        local on=cfg[key]
        bg.BackgroundColor3=on and GOLD or Color3.fromRGB(45,45,45)
        TweenService:Create(knob,TweenInfo.new(0.1),{
            Position=on and UDim2.new(1,-15,0.5,-6.5) or UDim2.new(0,2,0.5,-6.5)
        }):Play()
    end)
end

-- ── slider row
local function mkSlider(parent, label, key, mn, mx, fmt, order)
    local fmt2=fmt or "%.0f"
    local row=Instance.new("Frame",parent)
    row.Size=UDim2.new(1,0,0,34); row.BackgroundTransparency=1; row.LayoutOrder=order

    local lbl=Instance.new("TextLabel",row)
    lbl.Size=UDim2.new(1,-44,0,14); lbl.BackgroundTransparency=1
    lbl.Text=label; lbl.TextColor3=TEXT; lbl.TextSize=10; lbl.Font=Enum.Font.Gotham
    lbl.TextXAlignment=Enum.TextXAlignment.Left

    local vl=Instance.new("TextLabel",row)
    vl.Size=UDim2.new(0,42,0,14); vl.Position=UDim2.new(1,-44,0,0)
    vl.BackgroundTransparency=1; vl.Text=string.format(fmt2,cfg[key])
    vl.TextColor3=GOLD; vl.TextSize=10; vl.Font=Enum.Font.GothamBold
    vl.TextXAlignment=Enum.TextXAlignment.Right

    local track=Instance.new("Frame",row)
    track.Size=UDim2.new(1,0,0,5); track.Position=UDim2.new(0,0,0,17)
    track.BackgroundColor3=Color3.fromRGB(38,28,8); track.BorderSizePixel=0
    Instance.new("UICorner",track).CornerRadius=UDim.new(1,0)

    local ratio=(cfg[key]-mn)/(mx-mn)
    local fill=Instance.new("Frame",track)
    fill.Size=UDim2.new(ratio,0,1,0); fill.BackgroundColor3=GOLD
    fill.BorderSizePixel=0; Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0)

    local sliding=false
    local hit=Instance.new("TextButton",row)
    hit.Size=UDim2.new(1,0,0,22); hit.Position=UDim2.new(0,0,0,12)
    hit.BackgroundTransparency=1; hit.Text=""; hit.ZIndex=2

    local function upd(ix)
        local r=math.clamp((ix-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
        local dec=tonumber((fmt2:match("%.(%d)"))) or 0
        local mul=10^dec
        local v=math.floor((mn+r*(mx-mn))*mul+0.5)/mul
        cfg[key]=v; fill.Size=UDim2.new(r,0,1,0); vl.Text=string.format(fmt2,v)
    end

    hit.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then sliding=true; upd(i.Position.X) end
    end)
    hit.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then sliding=false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if sliding and i.UserInputType==Enum.UserInputType.MouseMovement then upd(i.Position.X) end
    end)
end

