-- ── slider factory
local function slider(parent, label, key, mn, mx, fmt, order)
    local row=Instance.new("Frame",parent)
    row.Size=UDim2.new(1,0,0,34); row.BackgroundTransparency=1; row.LayoutOrder=order

    local lbl=Instance.new("TextLabel",row)
    lbl.Size=UDim2.new(1,-44,0,14); lbl.BackgroundTransparency=1
    lbl.Text=label; lbl.TextColor3=Color3.fromRGB(210,195,165)
    lbl.TextSize=10; lbl.Font=Enum.Font.Gotham
    lbl.TextXAlignment=Enum.TextXAlignment.Left

    local fmt2 = fmt or "%.0f"
    local vl=Instance.new("TextLabel",row)
    vl.Size=UDim2.new(0,42,0,14); vl.Position=UDim2.new(1,-44,0,0)
    vl.BackgroundTransparency=1; vl.Text=string.format(fmt2,cfg[key])
    vl.TextColor3=Color3.fromRGB(255,160,0); vl.TextSize=10
    vl.Font=Enum.Font.GothamBold; vl.TextXAlignment=Enum.TextXAlignment.Right

    local track=Instance.new("Frame",row)
    track.Size=UDim2.new(1,0,0,5); track.Position=UDim2.new(0,0,0,17)
    track.BackgroundColor3=Color3.fromRGB(38,28,8); track.BorderSizePixel=0
    Instance.new("UICorner",track).CornerRadius=UDim.new(1,0)

    local ratio=(cfg[key]-mn)/(mx-mn)
    local fill=Instance.new("Frame",track)
    fill.Size=UDim2.new(ratio,0,1,0)
    fill.BackgroundColor3=Color3.fromRGB(255,160,0)
    fill.BorderSizePixel=0
    Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0)

    local sliding=false
    local hit=Instance.new("TextButton",row)
    hit.Size=UDim2.new(1,0,0,20); hit.Position=UDim2.new(0,0,0,12)
    hit.BackgroundTransparency=1; hit.Text=""

    local function upd(ix)
        local ax=track.AbsolutePosition.X
        local aw=track.AbsoluteSize.X
        local r=math.clamp((ix-ax)/aw,0,1)
        local v
        if fmt and fmt:find("%.") then
            local dec=tonumber(fmt:match("%.(%d)")) or 2
            local mul=10^dec
            v=math.floor((mn+r*(mx-mn))*mul+0.5)/mul
        else
            v=math.floor(mn+r*(mx-mn)+0.5)
        end
        cfg[key]=v
        fill.Size=UDim2.new(r,0,1,0)
        vl.Text=string.format(fmt2,v)
    end

    hit.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then
            sliding=true; upd(i.Position.X)
        end
    end)
    hit.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then sliding=false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if sliding and i.UserInputType==Enum.UserInputType.MouseMovement then
            upd(i.Position.X)
        end
    end)
end

