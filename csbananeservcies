-- ─── FIND SILENT TARGET ───────────────────────────────────────────────────────
local function FindSilentTarget()
    local Camera=Workspace.CurrentCamera
    if not Camera or not LocalPlayer.Character then getgenv().ParsaSilentTarget=nil; return nil end
    local camPos=Camera.CFrame.Position; local lookVec=Camera.CFrame.LookVector
    local screenCenter=Camera.ViewportSize/2; local cd,cp=math.huge,nil
    for _,player in ipairs(Players:GetPlayers()) do
        if player==LocalPlayer then continue end
        local char=player.Character
        if not char or char:GetAttribute("Dead") or char:GetAttribute("Invincible") then continue end
        if Settings.TeamCheck and not isOppositeTeam(LocalPlayer,player) then continue end
        local targetPart=char:FindFirstChild(Settings.HitPart) or char:FindFirstChild("Head") or char.PrimaryPart
        if not targetPart then continue end
        local inFOV,_=VectorMath.isInVectorFOV(camPos,lookVec,targetPart.Position,Settings.AutoFireAngleFOV)
        local sp,onScreen=Camera:WorldToViewportPoint(targetPart.Position)
        if onScreen then
            local df=(Vector2.new(sp.X,sp.Y)-screenCenter).Magnitude
            local maxR=Settings.UseFOV and Settings.FOVRadius or math.huge
            if inFOV and df<=maxR and df<cd then
                if Settings.Wallbang or isVisible(targetPart) then cd=df; cp=targetPart end
            end
        end
    end
    getgenv().ParsaSilentTarget=cp; return cp
end

