-- slider builder
local function makeSlider(parent, label, key, min, max, order)
    local row = Instance.new("Frame")
    row.Size             = UDim2.new(1,0,0,32)
    row.BackgroundTransparency = 1
    row.LayoutOrder      = order or 0
    row.Parent           = parent

    local lbl = Instance.new("TextLabel")
    lbl.Size             = UDim2.new(1,0,0,14)
    lbl.BackgroundTransparency = 1
    lbl.Text             = label
    lbl.TextColor3       = Color3.fromRGB(210,200,180)
    lbl.TextSize         = 11
    lbl.Font             = Enum.Font.Gotham
    lbl.TextXAlignment   = Enum.TextXAlignment.Left
    lbl.Parent           = row

    local valLbl = Instance.new("TextLabel")
    valLbl.Size            = UDim2.new(0,40,0,14)
    valLbl.Position        = UDim2.new(1,-42,0,0)
    valLbl.BackgroundTransparency = 1
    valLbl.Text            = tostring(cfg[key])
    valLbl.TextColor3      = cfg.AccentColor
    valLbl.TextSize        = 11
    valLbl.Font            = Enum.Font.GothamBold
    valLbl.TextXAlignment  = Enum.TextXAlignment.Right
    valLbl.Parent          = row

    local track = Instance.new("Frame")
    track.Size             = UDim2.new(1,0,0,6)
    track.Position         = UDim2.new(0,0,0,18)
    track.BackgroundColor3 = Color3.fromRGB(40,30,10)
    track.BorderSizePixel  = 0
    track.Parent           = row

    local trc = Instance.new("UICorner")
    trc.CornerRadius = UDim.new(1,0)
    trc.Parent = track

    local ratio = (cfg[key] - min) / (max - min)
    local fill  = Instance.new("Frame")
    fill.Size             = UDim2.new(ratio,0,1,0)
    fill.BackgroundColor3 = cfg.AccentColor
    fill.BorderSizePixel  = 0
    fill.Parent           = track

    local fc = Instance.new("UICorner")
    fc.CornerRadius = UDim.new(1,0)
    fc.Parent = fill

    local sliding = false
    local trackBtn = Instance.new("TextButton")
    trackBtn.Size             = UDim2.new(1,0,0,20)
    trackBtn.Position         = UDim2.new(0,0,0,12)
    trackBtn.BackgroundTransparency = 1
    trackBtn.Text             = ""
    trackBtn.Parent           = row

    local function updateSlider(inputX)
        local abs  = track.AbsolutePosition.X
        local w    = track.AbsoluteSize.X
        local r    = math.clamp((inputX - abs)/w, 0, 1)
        local val  = math.floor(min + r*(max-min))
        if key == "TriggerDelay" or key == "FireDelay" or key == "AimSmooth" then
            val = math.floor((min + r*(max-min))*100)/100
        end
        cfg[key]         = val
        fill.Size        = UDim2.new(r,0,1,0)
        valLbl.Text      = tostring(val)
    end

    trackBtn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true
            updateSlider(i.Position.X)
        end
    end)
    trackBtn.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if sliding and i.UserInputType == Enum.UserInputType.MouseMovement then
            updateSlider(i.Position.X)
        end
    end)
end

