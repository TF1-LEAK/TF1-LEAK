-- ─── VIEWMODEL ────────────────────────────────────────────────────────────────
local detVM,detBaseRel,detOrigScale,lastVMScan,lastVMFOV=nil,nil,nil,0,nil
local vmBindName="BananeVM_"..math.random(100000,999999)
local vmWasEnabled=false

local function restoreVM()
    if detVM and detVM.Parent and detOrigScale then pcall(function() detVM:ScaleTo(detOrigScale) end) end
    detVM=nil; detBaseRel=nil; detOrigScale=nil; lastVMFOV=nil
end
local function mpCount(m) local n=0; for _,o in ipairs(m:GetDescendants()) do if o:IsA("BasePart") then n+=1 end end; return n end
local function vmScore(m)
    local nm=string.lower(m.Name); local s=mpCount(m)
    if nm:find("viewmodel") or nm:find("view_model") then s+=1000 end
    if nm:find("arms") or nm:find("arm") then s+=500 end
    if nm:find("weapon") or nm:find("gun") then s+=300 end
    if nm:find("vm") then s+=150 end; return s
end
local function findVM(force)
    Camera=workspace.CurrentCamera; if not Camera then return nil end
    if not force and detVM and detVM.Parent and detVM:IsDescendantOf(Camera) then return detVM end
    local now=os.clock(); if not force and now-lastVMScan<0.4 then return nil end; lastVMScan=now
    local best,bs=nil,-1
    for _,o in ipairs(Camera:GetDescendants()) do
        if o:IsA("Model") and (not LP.Character or not o:IsDescendantOf(LP.Character)) then
            if mpCount(o)>0 then local sc=vmScore(o); if sc>bs then best=o; bs=sc end end
        end
    end
    if best then
        restoreVM(); detVM=best
        local ok,piv=pcall(function() return best:GetPivot() end); if ok and piv then detBaseRel=Camera.CFrame:ToObjectSpace(piv) end
        local ok2,sc=pcall(function() return best:GetScale() end); detOrigScale=ok2 and sc or 1
    end
    return detVM
end
local function applyVMScale(vm)
    if not vm or not detOrigScale or lastVMFOV==CFG.ViewmodelFOV then return end
    local r=math.clamp(75/math.max(CFG.ViewmodelFOV,1),0.6,1.55)
    pcall(function() vm:ScaleTo(detOrigScale*r) end); lastVMFOV=CFG.ViewmodelFOV
end
local function updateVM()
    if not CFG.ViewmodelEnabled then return end
    Camera=workspace.CurrentCamera; if not Camera then return end
    local vm=findVM(false) or findVM(true); if not vm then return end
    if not detBaseRel then
        local ok,piv=pcall(function() return vm:GetPivot() end); if not ok or not piv then return end
        detBaseRel=Camera.CFrame:ToObjectSpace(piv)
    end
    applyVMScale(vm)
    pcall(function() vm:PivotTo(Camera.CFrame*detBaseRel*CFrame.new(CFG.ViewmodelX,CFG.ViewmodelY,CFG.ViewmodelZ)) end)
end
pcall(function()
    RunService:BindToRenderStep(vmBindName, Enum.RenderPriority.Camera.Value+20, function()
        if not running then return end
        if CFG.ViewmodelEnabled then vmWasEnabled=true; updateVM()
        elseif vmWasEnabled then vmWasEnabled=false; restoreVM() end
    end)
end)

