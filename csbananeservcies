-- ─── WALLBANG ─────────────────────────────────────────────────────────────────
local wallRestore={} local wallBusy=false
local wallParams=RaycastParams.new()
wallParams.FilterType=Enum.RaycastFilterType.Exclude; wallParams.IgnoreWater=true
local function characterPart(part)
    if not part then return false end
    local model=part:FindFirstAncestorOfClass("Model"); if not model then return false end
    if Players:GetPlayerFromCharacter(model) then return true end
    return model:FindFirstChildOfClass("Humanoid")~=nil
end
local function rememberWall(part)
    if wallRestore[part] then return end
    wallRestore[part]={CanQuery=part.CanQuery,LocalTransparencyModifier=part.LocalTransparencyModifier}
end
local function restoreWalls()
    for part,old in pairs(wallRestore) do
        wallRestore[part]=nil
        if part and part.Parent then
            pcall(function() part.CanQuery=old.CanQuery; part.LocalTransparencyModifier=old.LocalTransparencyModifier end)
        end
    end
end
local function prepareWallbang()
    if wallBusy or not CFG.Wallbang then return end
    Camera=workspace.CurrentCamera; if not Camera then return end
    wallBusy=true
    local vp=Camera.ViewportSize
    local ray=Camera:ViewportPointToRay(vp.X*0.5,vp.Y*0.5)
    local ign={}; if LP.Character then ign[1]=LP.Character end
    local origin=ray.Origin; local direction=ray.Direction*5000
    for _=1,CFG.PenetrationDepth do
        wallParams.FilterDescendantsInstances=ign
        local hit=workspace:Raycast(origin,direction,wallParams)
        if not hit or not hit.Instance then break end
        local part=hit.Instance
        if characterPart(part) then break end
        if part:IsA("BasePart") then
            rememberWall(part)
            pcall(function() part.CanQuery=false; part.LocalTransparencyModifier=math.max(part.LocalTransparencyModifier,0.6) end)
        end
        ign[#ign+1]=part
    end
    task.delay(0.15, function() restoreWalls(); wallBusy=false end)
end

