-- ─── UTIL ─────────────────────────────────────────────────────────────────────
local function getChar(p)   return p.Character end
local function getHum(p)
    local c = getChar(p)
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function getRoot(p)
    local c = getChar(p)
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function getPart(p, name)
    local c = getChar(p)
    return c and (c:FindFirstChild(name) or c:FindFirstChild("HumanoidRootPart"))
end
local function alive(p)
    local h = getHum(p)
    return h and h.Health > 0 and h.Health == h.Health
end
local function sameTeam(p)
    if not cfg.TeamCheck then return false end
    return p.Team == lp.Team
end

local function toScreen(pos)
    local s, vis = cam:WorldToViewportPoint(pos)
    return Vector2.new(s.X, s.Y), s.Z, vis
end

local sw = cam.ViewportSize.X
local sh = cam.ViewportSize.Y
RunService.RenderStepped:Connect(function()
    sw = cam.ViewportSize.X
    sh = cam.ViewportSize.Y
end)

local function inFOV(screenPos)
    local cx, cy = sw/2, sh/2
    local dx = screenPos.X - cx
    local dy = screenPos.Y - cy
    return math.sqrt(dx*dx + dy*dy) <= cfg.FOV
end

-- ─── ENEMY LIST ───────────────────────────────────────────────────────────────
local function enemies()
    local out = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and not sameTeam(p) and alive(p) then
            local root = getRoot(p)
            if root then
                out[#out+1] = p
            end
        end
    end
    return out
end

-- ─── BEST TARGET ─────────────────────────────────────────────────────────────
local currentTarget = nil

local function getBest()
    local best, bestDist = nil, math.huge
    local cx, cy = sw/2, sh/2
    for _, p in ipairs(enemies()) do
        local part = getPart(p, cfg.AimBone)
        if not part then continue end
        local scr, depth, vis = toScreen(part.Position)
        if not vis or depth <= 0 then continue end
        if not inFOV(scr) then continue end
        local d = math.sqrt((scr.X-cx)^2 + (scr.Y-cy)^2)
        if d < bestDist then
            bestDist = d
            best     = p
        end
    end
    return best
end

-- ─── AIMBOT ───────────────────────────────────────────────────────────────────
local function doAimbot()
    if not cfg.Aimbot then return end
    local holding = false
    if cfg.AimbotKey == "MouseButton2" then
        holding = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    else
        holding = UserInputService:IsKeyDown(Enum.KeyCode[cfg.AimbotKey] or Enum.KeyCode.E)
    end
    if not holding then return end

    local target = currentTarget
    if not target then return end
    local part = getPart(target, cfg.AimBone)
    if not part then return end

    local goal = CFrame.new(cam.CFrame.Position, part.Position)
    cam.CFrame  = cam.CFrame:Lerp(goal, cfg.AimSmooth)
end

-- ─── SILENT AIM ───────────────────────────────────────────────────────────────
local function initSilentAim()
    if not hookmetamethod then return end
    local orig
    orig = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if cfg.SilentAim and (method == "FireServer" or method == "InvokeServer") then
            local target = currentTarget
            if target then
                local part = getPart(target, cfg.AimBone)
                if part then
                    local args = {...}
                    for i = 1, #args do
                        local v = args[i]
                        if typeof(v) == "CFrame" then
                            args[i] = CFrame.new(part.Position)
                            return orig(self, table.unpack(args))
                        elseif typeof(v) == "Vector3" then
                            args[i] = part.Position
                            return orig(self, table.unpack(args))
                        end
                    end
                end
            end
        end
        return orig(self, ...)
    end))
end

-- ─── TRIGGERBOT ───────────────────────────────────────────────────────────────
local lastTrigger = 0
local function doTrigger()
    if not cfg.TriggerBot then return end
    if tick() - lastTrigger < cfg.TriggerDelay then return end
    local target = currentTarget
    if not target then return end
    local part = getPart(target, cfg.AimBone)
    if not part then return end
    local scr, _, vis = toScreen(part.Position)
    if not vis then return end
    local cx, cy = sw/2, sh/2
    if math.sqrt((scr.X-cx)^2+(scr.Y-cy)^2) < 20 then
        mouse1click()
        lastTrigger = tick()
    end
end

