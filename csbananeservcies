-- ─── UTIL ─────────────────────────────────────────────────────────────────────
local function getRoot(char)
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getBone(char, bone)
    return char and (char:FindFirstChild(bone) or char:FindFirstChild("HumanoidRootPart"))
end

local function getHP(char)
    local h = char and char:FindFirstChildOfClass("Humanoid")
    return h and h.Health or 0, h and h.MaxHealth or 100
end

local function isAlive(player)
    local char = player.Character
    if not char then return false end
    local h = char:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function isTeam(player)
    return player.Team == lp.Team
end

local function worldToViewport(pos)
    local screen, onScreen = cam:WorldToViewportPoint(pos)
    return Vector2.new(screen.X, screen.Y), screen.Z, onScreen
end

local function getEnemies()
    local out = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and isAlive(p) and not isTeam(p) then
            table.insert(out, p)
        end
    end
    return out
end

local function isVisible(char)
    local bone = getBone(char, cfg.AimBone)
    if not bone then return false end
    local origin = cam.CFrame.Position
    local dir    = (bone.Position - origin)
    local rp = RaycastParams.new()
    rp.FilterDescendantsInstances = {lp.Character, char}
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local result = Workspace:Raycast(origin, dir, rp)
    return result == nil
end

-- ─── BEST TARGET ─────────────────────────────────────────────────────────────
local function getBestTarget()
    local center  = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
    local bestDist= cfg.FOVRadius + 1
    local bestPly = nil

    for _, p in ipairs(getEnemies()) do
        local char = p.Character
        if not char then continue end
        local bone = getBone(char, cfg.AimBone)
        if not bone then continue end
        local screen, depth, onScreen = worldToViewport(bone.Position)
        if not onScreen or depth < 0 then continue end
        if cfg.VisibleCheck and not isVisible(char) then continue end
        local dist = (screen - center).Magnitude
        if dist < bestDist then
            bestDist = dist
            bestPly  = p
        end
    end
    return bestPly
end

-- ─── SILENT AIM ──────────────────────────────────────────────────────────────
-- Hooks the bullet raycast to redirect to target head
local silentTarget = nil

local function initSilentAim()
    -- hook via __newindex on camera / remote intercept pattern
    -- works on executors with hookfunction support (Synapse X, KRNL)
    if not hookfunction then return end

    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" or method == "InvokeServer" then
            if cfg.SilentAim and silentTarget then
                local char = silentTarget.Character
                if char then
                    local bone = getBone(char, cfg.AimBone)
                    if bone then
                        local args = {...}
                        -- Blox Strike typically sends CFrame / Vector3 as arg[1] or arg[2]
                        -- patch position arg if it's a CFrame or Vector3
                        for i, v in ipairs(args) do
                            if typeof(v) == "CFrame" then
                                args[i] = CFrame.new(bone.Position) * (v - v.Position)
                                break
                            elseif typeof(v) == "Vector3" then
                                args[i] = bone.Position
                                break
                            end
                        end
                        return oldNamecall(self, table.unpack(args))
                    end
                end
            end
        end
        return oldNamecall(self, ...)
    end)
end

-- ─── AIM ASSIST ──────────────────────────────────────────────────────────────
local function doAimAssist(target)
    if not target or not cfg.AimAssist then return end
    local char = target.Character
    if not char then return end
    local bone = getBone(char, cfg.AimBone)
    if not bone then return end

    local bonePos  = bone.Position
    local camCF    = cam.CFrame
    local lookAt   = CFrame.new(camCF.Position, bonePos)
    cam.CFrame     = camCF:Lerp(lookAt, 1 - cfg.AimSmooth)
end

-- ─── TRIGGER BOT ─────────────────────────────────────────────────────────────
local triggerCooldown = 0

local function doTriggerBot()
    if not cfg.TriggerBot then return end
    if tick() - triggerCooldown < cfg.TriggerDelay then return end

    local target = getBestTarget()
    if not target then return end
    local char   = target.Character
    if not char  then return end
    local bone   = getBone(char, cfg.AimBone)
    if not bone  then return end

    local screen, _, onScreen = worldToViewport(bone.Position)
    if not onScreen then return end
    local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
    if (screen - center).Magnitude < 12 then
        -- simulate mouse click
        mouse1click()
        triggerCooldown = tick()
    end
end

