local function mkPanel(parent, title, icon, x, y, w, h)
    local f=Instance.new("Frame",parent)
    f.Size=UDim2.new(0,w,0,h); f.Position=UDim2.new(0,x,0,y)
    f.BackgroundColor3=PANEL; f.BorderSizePixel=0
    Instance.new("UICorner",f).CornerRadius=UDim.new(0,6)
    local fs=Instance.new("UIStroke",f); fs.Color=BORDER; fs.Thickness=1
    local hdr=Instance.new("Frame",f)
    hdr.Size=UDim2.new(1,0,0,24); hdr.BackgroundColor3=PANELH; hdr.BorderSizePixel=0
    Instance.new("UICorner",hdr).CornerRadius=UDim.new(0,6)
    local ht=Instance.new("TextLabel",hdr)
    ht.Size=UDim2.new(1,-8,1,0); ht.Position=UDim2.new(0,8,0,0)
    ht.BackgroundTransparency=1; ht.Text=icon.."  "..title
    ht.TextColor3=GOLD; ht.TextSize=11; ht.Font=Enum.Font.GothamBold
    ht.TextXAlignment=Enum.TextXAlignment.Left
