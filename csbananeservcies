local function makePage(name)
    local p=new("ScrollingFrame",{
        Name=name,Size=UDim2.fromScale(1,1),BackgroundTransparency=1,BorderSizePixel=0,
        ScrollBarThickness=2,ScrollBarImageColor3=GOLD,
        AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.new(),
        Visible=false,Parent=body
    })
    new("UIListLayout",{Padding=UDim.new(0,8),SortOrder=Enum.SortOrder.LayoutOrder,Parent=p})
    pages[name]=p; return p
end

local function switchPage(name)
    for n,p in pairs(pages) do p.Visible=(n==name) end
    for n,d in pairs(navButtons) do
        local a=(n==name)
        d.Button.BackgroundColor3=a and CARD2 or DARK
        d.Button.TextColor3=a and GOLD or DIM
        d.Dot.BackgroundTransparency=a and 0 or 1
    end
    pageTitle.Text=name; pageSub.Text=pageMeta[name] or ""
end

