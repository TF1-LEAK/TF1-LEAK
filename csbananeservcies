-- ─── ANTI-AIM ─────────────────────────────────────────────────────────────────
local originalNeckC0,originalWaistC0,originalRootC0,lastCharAA=nil,nil,nil,nil
local spinAngle=0

local function getJoints()
    local char=LocalPlayer.Character; if not char then return nil,nil,nil,nil end
    local head=char:FindFirstChild("Head")
    local upperTorso=char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    local lowerTorso=char:FindFirstChild("LowerTorso")
    local rootPart=char:FindFirstChild("HumanoidRootPart")
    local hum=char:FindFirstChildOfClass("Humanoid")
    local neck=(head and head:FindFirstChild("Neck")) or (upperTorso and upperTorso:FindFirstChild("Neck"))
    local waist=(upperTorso and upperTorso:FindFirstChild("Waist")) or (lowerTorso and lowerTorso:FindFirstChild("Waist"))
    local rootJoint=rootPart and rootPart:FindFirstChild("RootJoint")
    return neck,waist,rootJoint,hum
end

local function updateAntiAimState()
    local char=LocalPlayer.Character; if not char then return end
    if char~=lastCharAA then lastCharAA=char; originalNeckC0=nil; originalWaistC0=nil; originalRootC0=nil end
    local neck,waist,rootJoint,hum=getJoints()
    if neck and not originalNeckC0 then originalNeckC0=neck.C0 end
    if waist and not originalWaistC0 then originalWaistC0=waist.C0 end
    if rootJoint and not originalRootC0 then originalRootC0=rootJoint.C0 end
    if not Settings.AntiAim then
        if neck and originalNeckC0 then neck.C0=originalNeckC0 end
        if waist and originalWaistC0 then waist.C0=originalWaistC0 end
        if rootJoint and originalRootC0 then rootJoint.C0=originalRootC0 end
        if hum then hum.AutoRotate=true end; return
    end
    if hum then hum.AutoRotate=false end
    if Settings.AntiAimDisableOnFire and Settings.IsFiringState then
        if neck and originalNeckC0 then neck.C0=originalNeckC0 end
        if waist and originalWaistC0 then waist.C0=originalWaistC0 end
        if rootJoint and originalRootC0 then rootJoint.C0=originalRootC0 end; return
    end
    local enemyPart=getgenv().ParsaSilentTarget or getClosestEnemyPart()
    local rootPart=char:FindFirstChild("HumanoidRootPart")
    local Camera=Workspace.CurrentCamera
    if rootPart then
        local myPos=rootPart.Position
        local enemyPos=enemyPart and enemyPart.Position
        if enemyPos then
            local delta=Vector3.new(enemyPos.X-myPos.X,0,enemyPos.Z-myPos.Z)
            if delta.Magnitude>0.001 then rootPart.CFrame=CFrame.lookAt(myPos,myPos-delta.Unit) end
        elseif Camera then
            local lv=Camera.CFrame.LookVector; local fl=Vector3.new(lv.X,0,lv.Z)
            if fl.Magnitude>0.001 then rootPart.CFrame=CFrame.lookAt(myPos,myPos-fl.Unit) end
        end
    end
    local pitchRad=0; local pm=Settings.AntiAimPitchMode or "Down"
    if pm=="Down" then pitchRad=math.rad(-89)
    elseif pm=="Up" then pitchRad=math.rad(89)
    elseif pm=="Jitter" then pitchRad=math.rad(math.random()>0.5 and -89 or 89)
    elseif pm=="Custom" then pitchRad=math.rad(Settings.AntiAimAngle or -89) end
    local yawRad=0; local ym=Settings.AntiAimYawMode or "AtTargets"
    if ym=="Spinbot" then spinAngle=(spinAngle+(Settings.AntiAimSpinSpeed or 15))%360; yawRad=math.rad(spinAngle)
    elseif ym=="Jitter" then yawRad=math.rad(math.random()>0.5 and 90 or -90)
    elseif ym=="Sideways" then yawRad=math.rad(90)
    elseif ym=="Backwards" then yawRad=math.pi end
    if neck and originalNeckC0 then neck.C0=originalNeckC0*CFrame.Angles(pitchRad,yawRad,0) end
    if waist and originalWaistC0 then waist.C0=originalWaistC0*CFrame.Angles(pitchRad*0.4,0,0) end
    if rootJoint and originalRootC0 then
        rootJoint.C0=ym=="Spinbot" and (originalRootC0*CFrame.Angles(0,0,yawRad)) or originalRootC0
    end
end

