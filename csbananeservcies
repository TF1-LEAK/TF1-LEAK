local origLighting = {
    GlobalShadows          = Lighting.GlobalShadows,
    EnvironmentDiffuseScale= Lighting.EnvironmentDiffuseScale,
    EnvironmentSpecularScale=Lighting.EnvironmentSpecularScale,
    FogEnd                 = Lighting.FogEnd,
}
local origEffects = {}
local terrain = workspace:FindFirstChildOfClass("Terrain")
local origDecoration = nil
if terrain then pcall(function() origDecoration = terrain.Decoration end) end
for _, c in ipairs(Lighting:GetChildren()) do
    if c:IsA("PostEffect") then origEffects[c] = c.Enabled end
end

local function applyPotatoMode(enabled)
    CFG.PotatoMode = enabled == true
    if CFG.PotatoMode then
        pcall(function() Lighting.GlobalShadows = false end)
        pcall(function() Lighting.EnvironmentDiffuseScale = 0 end)
        pcall(function() Lighting.EnvironmentSpecularScale = 0 end)
        pcall(function() Lighting.FogEnd = 1e6 end)
        if terrain then pcall(function() terrain.Decoration = false end) end
        for _, c in ipairs(Lighting:GetChildren()) do
            if c:IsA("PostEffect") then
                origEffects[c] = origEffects[c] ~= nil and origEffects[c] or c.Enabled
                pcall(function() c.Enabled = false end)
            end
        end
    else
        pcall(function() Lighting.GlobalShadows           = origLighting.GlobalShadows end)
        pcall(function() Lighting.EnvironmentDiffuseScale = origLighting.EnvironmentDiffuseScale end)
        pcall(function() Lighting.EnvironmentSpecularScale= origLighting.EnvironmentSpecularScale end)
        pcall(function() Lighting.FogEnd                  = origLighting.FogEnd end)
        if terrain and origDecoration ~= nil then
            pcall(function() terrain.Decoration = origDecoration end)
        end
        for eff, state in pairs(origEffects) do
            if eff and eff.Parent then pcall(function() eff.Enabled = state end) end
        end
    end
end

-- ─── UTIL ─────────────────────────────────────────────────────────────────────
local function connect(sig, fn) local c = sig:Connect(fn); connections[#connections+1]=c; return c end

local function getRoot(p)
    local c = p and p.Character; if not c then return nil end
    return c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso")
end
local function getHum(p)   local c=p and p.Character; return c and c:FindFirstChildOfClass("Humanoid") end
local function getHP(p)
    local c = p and p.Character; if not c then return 0 end
    local h = c:FindFirstChildOfClass("Humanoid"); if h then return h.Health end
    local v = c:GetAttribute("Health") or c:GetAttribute("HP")
    return typeof(v)=="number" and v or (getRoot(p) and 100 or 0)
end
local function alive(p) return getHP(p) > 0 end

local function stdTeammate(a,b)
    if not a or not b then return false end
    if a.Team and b.Team then return a.Team==b.Team end
    if not a.Neutral and not b.Neutral and a.TeamColor and b.TeamColor then return a.TeamColor==b.TeamColor end
    for _, k in ipairs({"Team","TeamId","TeamID","Side","Faction"}) do
        local x,y = a:GetAttribute(k), b:GetAttribute(k)
        if x~=nil and y~=nil then return tostring(x)==tostring(y) end
    end
    return false
end
local function hasTeamData(p)
    if not p then return false end
    if p.Team~=nil then return true end
    if not p.Neutral and p.TeamColor~=nil then return true end
    for _, k in ipairs({"Team","TeamId","TeamID","Side","Faction"}) do
        if p:GetAttribute(k)~=nil then return true end
    end
    return false
end
local function teammate(p)
    if p==LP then return true end
    if hasTeamData(LP) and hasTeamData(p) then return stdTeammate(LP,p) end
    if stdTeammate(LP,p) then return true end
    return roundTeam[p]==true
end
local function validTarget(p)
    if p==LP then return false end
    if not alive(p) then return false end
    if CFG.TeamCheck and teammate(p) then return false end
    return true
end

-- ─── AIMBOT ───────────────────────────────────────────────────────────────────
local aimParams = RaycastParams.new()
aimParams.FilterType = Enum.RaycastFilterType.Exclude
aimParams.IgnoreWater = true

local function getAimPart(p)
    local c = p and p.Character; if not c then return nil end
    if CFG.AimHead then
        return c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("UpperTorso")
    end
    return c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso") or c:FindFirstChild("Head")
end

local function aimVisible(p, part)
    if not CFG.AimVisibleCheck then return true end
    Camera = workspace.CurrentCamera; if not Camera or not part then return false end
    local ign = {}; if LP.Character then ign[1]=LP.Character end
    aimParams.FilterDescendantsInstances = ign
    local hit = workspace:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, aimParams)
    if not hit then return true end
    local char = p.Character
    return char and hit.Instance and hit.Instance:IsDescendantOf(char)
end

local function getBestAimTarget()
    Camera = workspace.CurrentCamera; if not Camera then return nil end
    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X*0.5, vp.Y*0.5)
    local camPos = Camera.CFrame.Position
    local best, bestDist = nil, CFG.AimFOV
    for _, p in ipairs(Players:GetPlayers()) do
        if validTarget(p) then
            local part = getAimPart(p)
            if part and part:IsA("BasePart") then
                if (part.Position-camPos).Magnitude <= CFG.AimMaxDistance then
                    local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen and sp.Z>0 then
                        local d = (Vector2.new(sp.X,sp.Y)-center).Magnitude
                        if d<=bestDist and aimVisible(p,part) then bestDist=d; best=part end
                    end
                end
            end
        end
    end
    return best
end

