local function drawESP()
    hideAll()
    if not cfg.ESP then return end

    for _, p in ipairs(Players:GetPlayers()) do
        if p == lp then continue end
        if not alive(p) then continue end
        local char = getChar(p)
        if not char then continue end

        local head  = char:FindFirstChild("Head")
        local root  = char:FindFirstChild("HumanoidRootPart")
        local hum   = char:FindFirstChildOfClass("Humanoid")
        if not head or not root or not hum then continue end

        -- top of head (slightly above)
        local topPos    = head.Position + Vector3.new(0, 0.7, 0)
        local botPos    = root.Position - Vector3.new(0, 3, 0)
        local topScr, depth, topVis = toScreen(topPos)
        local botScr, _,     botVis = toScreen(botPos)
        if not topVis or not botVis or depth <= 0 then continue end

        local isEnemy = not sameTeam(p)
        local col = isEnemy
            and Color3.fromRGB(255, 60, 60)
            or  Color3.fromRGB(60, 180, 255)

        local height = math.abs(botScr.Y - topScr.Y)
        if height < 5 then continue end
        local width  = height * 0.5
        local cx     = topScr.X

        -- ── BOX
        if cfg.ESPBox then
            local box = getDrawing(p.UserId.."box","Square",{Filled=false,Thickness=1.5})
            box.Size     = Vector2.new(width, height)
            box.Position = Vector2.new(cx - width/2, topScr.Y)
            box.Color    = col
            box.Visible  = true
        end

        -- ── NAME
        if cfg.ESPName then
            local nameD = getDrawing(p.UserId.."name","Text",{
                Size=13,Center=true,Outline=true,
                OutlineColor=Color3.new(0,0,0),Font=2
            })
            nameD.Text     = p.DisplayName
            nameD.Color    = col
            nameD.Position = Vector2.new(cx, topScr.Y - 16)
            nameD.Visible  = true
        end

        -- ── HEALTH BAR
        if cfg.ESPHealth then
            local ratio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            local bx    = cx - width/2 - 7
            local barH  = height

            local hbg = getDrawing(p.UserId.."hbg","Square",{
                Filled=true,Thickness=0,Color=Color3.fromRGB(10,10,10)
            })
            hbg.Size     = Vector2.new(4, barH)
            hbg.Position = Vector2.new(bx, topScr.Y)
            hbg.Visible  = true

            local hfg = getDrawing(p.UserId.."hfg","Square",{Filled=true,Thickness=0})
            local fh = barH * ratio
            hfg.Size     = Vector2.new(4, fh)
            hfg.Position = Vector2.new(bx, topScr.Y + barH - fh)
            hfg.Color    = Color3.fromRGB(
                math.floor(255*(1-ratio)),
                math.floor(220*ratio), 30)
            hfg.Visible  = true
        end

        -- ── DISTANCE
        if cfg.ESPDist then
            local distD = getDrawing(p.UserId.."dist","Text",{
                Size=11,Center=true,Outline=true,
                OutlineColor=Color3.new(0,0,0),Font=2
            })
            distD.Text     = string.format("%.0f studs", depth)
            distD.Color    = Color3.fromRGB(200,200,200)
            distD.Position = Vector2.new(cx, botScr.Y + 4)
            distD.Visible  = true
        end

        -- ── SKELETON
        if cfg.ESPSkeleton then
            for i, pair in ipairs(SKELETON_PAIRS) do
                local pA = char:FindFirstChild(pair[1])
                local pB = char:FindFirstChild(pair[2])
                if pA and pB then
                    local sA, _, vA = toScreen(pA.Position)
                    local sB, _, vB = toScreen(pB.Position)
                    if vA and vB then
                        local line = getDrawing(p.UserId.."sk"..i,"Line",{
                            Thickness=1.1,Color=col
                        })
                        line.From    = sA
                        line.To      = sB
                        line.Color   = col
                        line.Visible = true
                    end
                end
            end
        end
    end
end

