local function toggle(parent,name,key,cb)
    local h=new("Frame",{Size=UDim2.new(1,-4,0,42),BackgroundColor3=CARD,BorderSizePixel=0,Parent=parent})
    corner(h,10)
    new("TextLabel",{Position=UDim2.fromOffset(12,0),Size=UDim2.new(1,-72,1,0),
        BackgroundTransparency=1,Text=name,TextColor3=TEXT,Font=Enum.Font.GothamMedium,TextSize=10,
        TextXAlignment=Enum.TextXAlignment.Left,Parent=h})
    local sw=new("Frame",{Position=UDim2.new(1,-50,0.5,-9),Size=UDim2.fromOffset(36,18),BorderSizePixel=0,Parent=h})
    corner(sw,10)
    local knob=new("Frame",{Size=UDim2.fromOffset(12,12),BorderSizePixel=0,BackgroundColor3=WHITE,Parent=sw})
    corner(knob,8)
    local function paint()
        local on=Settings[key]==true
        sw.BackgroundColor3=on and GOLD or Color3.fromRGB(40,30,5)
        knob.Position=on and UDim2.new(1,-15,0.5,-6) or UDim2.new(0,3,0.5,-6)
    end
    local btn=new("TextButton",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Text="",Parent=h})
    btn.MouseButton1Click:Connect(function()
        Settings[key]=not Settings[key]; paint(); if cb then cb(Settings[key]) end
    end)
    paint(); return paint
end

local function slider(parent,name,key,mn,mx,step,suffix,cb)
    local h=new("Frame",{Size=UDim2.new(1,-4,0,58),BackgroundColor3=CARD,BorderSizePixel=0,Parent=parent})
    corner(h,10)
    local lbl=new("TextLabel",{Position=UDim2.fromOffset(12,4),Size=UDim2.new(1,-24,0,20),
        BackgroundTransparency=1,TextColor3=TEXT,Font=Enum.Font.Gotham,TextSize=10,
        TextXAlignment=Enum.TextXAlignment.Left,Parent=h})
    local bar=new("Frame",{Position=UDim2.new(0,12,1,-15),Size=UDim2.new(1,-24,0,4),
        BackgroundColor3=Color3.fromRGB(40,30,5),BorderSizePixel=0,Parent=h})
    corner(bar,4)
    local fill=new("Frame",{BackgroundColor3=GOLD,BorderSizePixel=0,Parent=bar})
    corner(fill,4)
    local dragging=false
    local sfx=suffix or ""
    local function set(v)
        v=math.clamp(v,mn,mx); v=math.floor(v/step+0.5)*step
        v=tonumber(string.format("%.3f",v))
        Settings[key]=v; fill.Size=UDim2.fromScale((v-mn)/(mx-mn),1)
        lbl.Text=step<1 and (name..": "..string.format("%.2f",v)..sfx) or (name..": "..math.floor(v)..sfx)
        if cb then cb(v) end
    end
    local function upd(x)
        if bar.AbsoluteSize.X<=0 then return end
        set(mn+(mx-mn)*math.clamp((x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1))
    end
    bar.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=true; upd(i.Position.X) end end)
    UserInputService.InputChanged:Connect(function(i) if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then upd(i.Position.X) end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end end)
    set(Settings[key])
end

local function dropdown(parent,name,key,options,cb)
    local h=new("Frame",{Size=UDim2.new(1,-4,0,42),BackgroundColor3=CARD,BorderSizePixel=0,Parent=parent})
    corner(h,10)
    new("TextLabel",{Position=UDim2.fromOffset(12,0),Size=UDim2.new(1,-160,1,0),
        BackgroundTransparency=1,Text=name,TextColor3=TEXT,Font=Enum.Font.GothamMedium,TextSize=10,
        TextXAlignment=Enum.TextXAlignment.Left,Parent=h})
    local btn=new("TextButton",{Position=UDim2.new(1,-148,0.5,-13),Size=UDim2.fromOffset(134,26),
        BackgroundColor3=CARD2,BorderSizePixel=0,Text=Settings[key],TextColor3=GOLD,
        Font=Enum.Font.GothamBold,TextSize=9,AutoButtonColor=false,Parent=h})
    corner(btn,7)
    local dropFrame=nil
    btn.MouseButton1Click:Connect(function()
        if dropFrame then dropFrame:Destroy(); dropFrame=nil; return end
        dropFrame=new("Frame",{Size=UDim2.fromOffset(134,#options*28+4),
            Position=UDim2.new(1,-148,1,2),BackgroundColor3=CARD2,BorderSizePixel=0,ZIndex=10,Parent=h})
        corner(dropFrame,6)
        local inst=Instance.new("UIStroke",dropFrame); inst.Color=BORD; inst.Thickness=1
        local dl=new("UIListLayout",{Padding=UDim.new(0,2),SortOrder=Enum.SortOrder.LayoutOrder,Parent=dropFrame})
        new("UIPadding",{PaddingTop=UDim.new(0,2),PaddingLeft=UDim.new(0,2),PaddingRight=UDim.new(0,2),Parent=dropFrame})
        for _,opt in ipairs(options) do
            local ob=new("TextButton",{Size=UDim2.new(1,0,0,24),BackgroundColor3=DARK,BorderSizePixel=0,
                Text=opt,TextColor3=opt==Settings[key] and GOLD or TEXT,
                Font=Enum.Font.Gotham,TextSize=10,AutoButtonColor=false,ZIndex=11,Parent=dropFrame})
            corner(ob,5)
            ob.MouseButton1Click:Connect(function()
                Settings[key]=opt; btn.Text=opt
                dropFrame:Destroy(); dropFrame=nil
                if cb then cb(opt) end
            end)
        end
    end)
end

