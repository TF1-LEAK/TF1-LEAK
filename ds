if not game:IsLoaded() then
    game.Loaded:Wait()
end

local SCRIPT_URL_URBAN  = 'https://raw.githubusercontent.com/14273l/Vergil.Urban/refs/heads/main/src'
local SCRIPT_URL_STRAFE = 'https://raw.githubusercontent.com/14273l/Vergil.StrafeFps/refs/heads/main/src'
local SCRIPT_URL_MM2    = 'https://raw.githubusercontent.com/14273l/Vergil.mm2/refs/heads/main/Auto%20farm'

if game.PlaceId == 132242344291615 then
    loadstring(game:HttpGet(SCRIPT_URL_URBAN))()
elseif game.PlaceId == 109020905733214 then
    loadstring(game:HttpGet(SCRIPT_URL_STRAFE))()
elseif game.PlaceId == 142823291 then
    loadstring(game:HttpGet(SCRIPT_URL_MM2))()
else
    game.Players.LocalPlayer:Kick("Game is unsupported. PlaceId: " .. game.PlaceId)
    return
end
